<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <RootNamespace>ModGod.Updater</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ModGodUpdater</AssemblyName>
        <Version>2.0.3</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        
        <!-- Single file exe configuration -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        
        <!-- Clean output -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <!-- Build to bin folder, publish to dist -->
    <PropertyGroup>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <PublishDir>..\dist\</PublishDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SharpCompress" Version="0.38.0" />
        <PackageReference Include="Spectre.Console" Version="0.49.1" />
    </ItemGroup>

    <!-- Auto-publish to dist after build -->
    <Target Name="PublishAfterBuild" AfterTargets="Build">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -o &quot;$(MSBuildProjectDirectory)\..\dist&quot; --no-build" />
    </Target>

    <!-- Copy additional files to dist after publish -->
    <Target Name="CopyUpdaterFiles" AfterTargets="PublishAfterBuild">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\ModGodUpdater.sh" DestinationFolder="$(MSBuildProjectDirectory)\..\dist\" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\ModGodData\ModGodClient.json" DestinationFolder="$(MSBuildProjectDirectory)\..\dist\ModGodData\" />
    </Target>

    <!-- Copy bundled 7-Zip tools to dist/ModGodData/tools/ (shared by server and updater) -->
    <Target Name="Copy7ZipTools" AfterTargets="CopyUpdaterFiles">
        <ItemGroup>
            <!-- Windows: 7z.exe + 7z.dll (from Server tools folder) -->
            <SevenZipFiles Include="$(MSBuildProjectDirectory)\..\Server\tools\7z.exe" Condition="Exists('$(MSBuildProjectDirectory)\..\Server\tools\7z.exe')" />
            <SevenZipFiles Include="$(MSBuildProjectDirectory)\..\Server\tools\7z.dll" Condition="Exists('$(MSBuildProjectDirectory)\..\Server\tools\7z.dll')" />
            <!-- Linux: 7zz (from Server tools folder) -->
            <SevenZipFiles Include="$(MSBuildProjectDirectory)\..\Server\tools\7zz" Condition="Exists('$(MSBuildProjectDirectory)\..\Server\tools\7zz')" />
        </ItemGroup>
        <Copy SourceFiles="@(SevenZipFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\dist\ModGodData\tools\" SkipUnchangedFiles="true" Condition="@(SevenZipFiles->Count()) > 0" />
        <Message Importance="high" Text="Copied 7-Zip tools to dist/ModGodData/tools/" Condition="@(SevenZipFiles->Count()) > 0" />
    </Target>
</Project>
