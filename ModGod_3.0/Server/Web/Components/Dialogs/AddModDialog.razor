    #region Helpers

    private class DownloadResultInfo
    {
        public string Url { get; set; } = "";
        public string ModName { get; set; } = "";
        public bool Success { get; set; }
        public string? Error { get; set; }
        public int FilesInstalled { get; set; }
    }

    private static string ExtractModNameFromUrl(string url)
    {
        try
        {
            var uri = new Uri(url);
            var filename = Path.GetFileName(uri.LocalPath);
            var extensions = new[] { ".zip", ".7z", ".rar", ".tar.gz", ".tar", ".gz" };
            foreach (var ext in extensions)
            {
                if (filename.EndsWith(ext, StringComparison.OrdinalIgnoreCase))
                {
                    filename = filename.Substring(0, filename.Length - ext.Length);
                    break;
                }
            }
            return string.IsNullOrWhiteSpace(filename) ? "UnknownMod" : filename;
        }
        catch
        {
            return "UnknownMod";
        }
    }

    private static string GetForgeCategoryStyle(string? colorClass)
    {
        var color = colorClass?.ToLowerInvariant() switch
        {
            "red" => "#ef4444",
            "orange" => "#f97316",
            "yellow" => "#eab308",
            "green" => "#22c55e",
            "teal" => "#14b8a6",
            "cyan" => "#06b6d4",
            "blue" => "#3b82f6",
            "indigo" => "#6366f1",
            "purple" => "#a855f7",
            "pink" => "#ec4899",
            _ => "#6b7280"
        };
        return $"background: {color}; color: #fff;";
    }

    private static string FormatDownloadCount(long count)
    {
        return count switch
        {
            >= 1_000_000 => $"{count / 1_000_000.0:F1}M",
            >= 1_000 => $"{count / 1_000.0:F1}K",
            _ => count.ToString("N0")
        };
    }

    private static string TruncateUrl(string url)
    {
        if (url.Length <= 50) return url;
        return url.Substring(0, 25) + "..." + url.Substring(url.Length - 22);
    }

    #endregion
