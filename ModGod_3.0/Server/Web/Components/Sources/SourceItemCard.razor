@using ModGod3.Models

<MudCard Elevation="0" Style="@GetCardStyle()" Class="source-item-card" @onclick="HandleCardClick">
    <MudCardContent>
        <div class="d-flex justify-space-between align-start">
            <div style="min-width: 0; flex: 1;">
                <div class="d-flex align-center gap-2 mb-1">
                    <MudIcon Icon="@(Item.IsDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.InsertDriveFile)"
                             Size="Size.Small"
                             Style="color: var(--accent-cyan);" />
                    <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @Item.DisplayName
                    </MudText>
                </div>

                <MudText Typo="Typo.caption" Style="color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @Item.Path
                </MudText>

                <div class="d-flex gap-2 mt-2">
                    @* Wrap chip in div with stopPropagation to prevent card click *@
                    <div @onclick="HandleChipClick" @onclick:stopPropagation="true" style="cursor: pointer;">
                        @if (Item.Optional)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Optional</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Required</MudChip>
                        }
                    </div>

                    @if (Item.LinkedTo.Count > 0)
                    {
                        <div @onclick:stopPropagation="true">
                            <MudTooltip Text="@GetLinkedTooltip()">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Class="mr-1" />
                                    @Item.LinkedTo.Count linked
                                </MudChip>
                            </MudTooltip>
                        </div>
                    }
                </div>

                <div class="d-flex gap-3 mt-2">
                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                        @Item.FileCount files
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                        @FormatSize(Item.TotalSize)
                    </MudText>
                </div>
            </div>

            <div @onclick:stopPropagation="true">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight">
                    <MudMenuItem OnClick="@(() => OnEdit.InvokeAsync(Item))">
                        Edit
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => OnToggleOptional.InvokeAsync(Item))">
                        @(Item.Optional ? "Mark Required" : "Mark Optional")
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => OnViewFiles.InvokeAsync(Item))">
                        View Files
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(Item))" Style="color: var(--accent-red);">
                        Delete
                    </MudMenuItem>
                </MudMenu>
            </div>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public SourceItem Item { get; set; } = default!;
    [Parameter] public EventCallback<SourceItem> OnEdit { get; set; }
    [Parameter] public EventCallback<SourceItem> OnToggleOptional { get; set; }
    [Parameter] public EventCallback<SourceItem> OnDelete { get; set; }
    [Parameter] public EventCallback<SourceItem> OnViewFiles { get; set; }

    private async Task HandleCardClick()
    {
        await OnEdit.InvokeAsync(Item);
    }

    private async Task HandleChipClick()
    {
        await OnToggleOptional.InvokeAsync(Item);
    }

    private string GetCardStyle()
    {
        var baseStyle = "background: var(--secondary-bg); border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; transition: all 0.15s ease;";

        if (Item.Optional)
        {
            // Optional = green border
            return baseStyle + " border-left: 3px solid var(--accent-green);";
        }

        // Required = orange border (more prominent/attention-grabbing)
        return baseStyle + " border-left: 3px solid var(--accent-orange);";
    }

    private string GetLinkedTooltip()
    {
        return $"Linked to: {string.Join(", ", Item.LinkedTo)}";
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }
}

<style>
    .source-item-card:hover {
        border-color: var(--accent-cyan) !important;
        box-shadow: 0 0 8px rgba(56, 189, 248, 0.2);
    }
</style>
