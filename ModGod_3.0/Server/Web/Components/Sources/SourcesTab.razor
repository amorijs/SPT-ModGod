@using ModGod3.Services
@using ModGod3.Models

@inject ConfigService ConfigService
@inject ForgeService ForgeService
@inject ModDownloadService ModDownloadService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Stats Bar *@
<MudPaper Class="pa-3 mb-4" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
    <div class="d-flex flex-wrap gap-3 align-center justify-space-between">
        <div class="d-flex flex-wrap gap-2">
            @* Stats Chips *@
            <MudChip T="string" Size="Size.Medium" Class="stat-chip"
                     OnClick="@(() => SetFilter(null))"
                     Style="@GetStatChipStyle(null)">
                <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Small" Class="mr-1" />
                @_allItems.Count Total
            </MudChip>
            <MudChip T="string" Size="Size.Medium" Class="stat-chip"
                     OnClick="@(() => SetFilter("Required"))"
                     Style="@GetStatChipStyle("Required")">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />
                @_allItems.Count(i => !i.Optional) Required
            </MudChip>
            <MudChip T="string" Size="Size.Medium" Class="stat-chip"
                     OnClick="@(() => SetFilter("Optional"))"
                     Style="@GetStatChipStyle("Optional")">
                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Class="mr-1" />
                @_allItems.Count(i => i.Optional) Optional
            </MudChip>
        </div>

        <div class="d-flex gap-2 align-center">
            @* Search *@
            <MudTextField @bind-Value="_searchQuery"
                          @bind-Value:after="ApplyFilters"
                          Placeholder="Search mods..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Style="width: 200px;" />

            @* Actions *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddModDialog">
                Add Mod
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync"
                       Disabled="@_loading">
                @(_loading ? "Scanning..." : "Refresh")
            </MudButton>
        </div>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_filteredGroups.Count == 0)
{
    @if (_allItems.Count > 0)
    {
        <MudPaper Class="pa-8 text-center" Style="background: var(--card-bg); border: 2px dashed var(--border-color); border-radius: 12px;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color: var(--text-secondary); font-size: 4rem;" />
            <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--text-secondary);">No matching items</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Try adjusting your search or filter.
            </MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-3" OnClick="ClearFilters">
                Clear Filters
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-8 text-center" Style="background: var(--card-bg); border: 2px dashed var(--border-color); border-radius: 12px;">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Large" Style="color: var(--text-secondary); font-size: 4rem;" />
            <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--text-secondary);">No source items found</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Add mods to your sync directories or use the "Add Mod" button above.
            </MudText>
        </MudPaper>
    }
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var group in _filteredGroups)
        {
            var optionalCount = group.Items.Count(i => i.Optional);
            var requiredCount = group.Items.Count - optionalCount;
            var totalSize = group.Items.Sum(i => i.TotalSize);

            <MudExpansionPanel Class="mb-4 source-group-panel" IsInitiallyExpanded="true"
                               Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px !important;">
                <TitleContent>
                    <div class="d-flex justify-space-between align-center" style="width: 100%;">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" Style="color: var(--accent-cyan);" />
                            <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 600;">
                                @group.DisplayName
                            </MudText>
                        </div>
                        <div class="d-flex gap-2 align-center mr-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                @group.Items.Count items
                            </MudChip>
                            @if (requiredCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    @requiredCount required
                                </MudChip>
                            }
                            @if (optionalCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                    @optionalCount optional
                                </MudChip>
                            }
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                     Style="background: var(--secondary-bg);">
                                @FormatSize(totalSize)
                            </MudChip>
                        </div>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudGrid Class="pa-2">
                        @foreach (var item in group.Items)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <SourceItemCard Item="@item"
                                               OnEdit="EditSourceItem"
                                               OnToggleOptional="ToggleOptional"
                                               OnDelete="DeleteSourceItem"
                                               OnViewFiles="ViewFiles"
                                               OnUpdate="HandleUpdate"
                                               OnReinstall="HandleReinstall" />
                            </MudItem>
                        }
                    </MudGrid>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<!-- Edit Source Item Dialog -->
<EditSourceItemDialog Visible="@_editDialogVisible"
                      VisibleChanged="HandleDialogVisibilityChanged"
                      Item="_editingItem"
                      OnSave="HandleEditSave"
                      OnDelete="HandleEditDelete"
                      OnUpdate="HandleUpdate"
                      OnReinstall="HandleReinstall" />

<!-- Add Mod Dialog -->
<AddModDialog Visible="@_addModDialogVisible"
              VisibleChanged="@(v => _addModDialogVisible = v)"
              OnModsAdded="HandleModsAdded" />

<!-- View Files Dialog -->
<ViewFilesDialog Visible="@_viewFilesDialogVisible"
                 VisibleChanged="@(v => _viewFilesDialogVisible = v)"
                 Item="_viewFilesItem" />

@code {
    [Parameter] public EventCallback OnConfigChanged { get; set; }

    private List<SourceGroup> _sourceGroups = new();
    private List<SourceGroup> _filteredGroups = new();
    private List<SourceItem> _allItems = new();
    private bool _loading = true;

    // Filter state
    private string _searchQuery = "";
    private string? _filterStatus;

    // Edit dialog state
    private bool _editDialogVisible;
    private SourceItem? _editingItem;
    private DateTime _dialogClosedAt = DateTime.MinValue;

    // Add mod dialog
    private bool _addModDialogVisible;

    // View files dialog
    private bool _viewFilesDialogVisible;
    private SourceItem? _viewFilesItem;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task NotifyConfigChanged()
    {
        await OnConfigChanged.InvokeAsync();
    }

    public async Task RefreshAsync()
    {
        _loading = true;
        StateHasChanged();

        await Task.Run(() =>
        {
            _sourceGroups = ConfigService.ScanSourceItems();
            _allItems = _sourceGroups.SelectMany(g => g.Items).ToList();
        });

        ApplyFilters();
        _loading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Reload state from staged config (called when discarding changes)
    /// </summary>
    public void ReloadFromConfig()
    {
        _ = RefreshAsync();
    }

    #region Filtering

    private void SetFilter(string? status)
    {
        _filterStatus = status;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _searchQuery = "";
        _filterStatus = null;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var filteredItems = _allItems.AsEnumerable();

        // Apply status filter
        if (_filterStatus == "Required")
            filteredItems = filteredItems.Where(i => !i.Optional);
        else if (_filterStatus == "Optional")
            filteredItems = filteredItems.Where(i => i.Optional);

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var query = _searchQuery.Trim();
            filteredItems = filteredItems.Where(i =>
                i.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                i.Path.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        // Rebuild groups with filtered items
        var filteredItemsList = filteredItems.ToList();
        _filteredGroups = _sourceGroups
            .Select(g => new SourceGroup
            {
                SyncRoot = g.SyncRoot,
                DisplayName = g.DisplayName,
                Items = g.Items.Where(i => filteredItemsList.Contains(i)).ToList()
            })
            .Where(g => g.Items.Count > 0)
            .ToList();

        StateHasChanged();
    }

    private string GetStatChipStyle(string? status)
    {
        var isActive = _filterStatus == status;
        var baseStyle = "cursor: pointer; transition: all 0.2s;";

        if (isActive)
        {
            var color = status switch
            {
                "Required" => "var(--accent-orange)",
                "Optional" => "var(--accent-green)",
                _ => "var(--accent-cyan)"
            };
            return $"{baseStyle} background: {color}; color: #000; box-shadow: 0 0 12px {color};";
        }

        return $"{baseStyle} background: var(--secondary-bg); color: var(--text-primary);";
    }

    #endregion

    #region Edit Dialog

    private void EditSourceItem(SourceItem item)
    {
        // Guard against reopening immediately after backdrop close
        if ((DateTime.Now - _dialogClosedAt).TotalMilliseconds < 200)
            return;

        _editingItem = item;
        _editDialogVisible = true;
    }

    private void HandleDialogVisibilityChanged(bool visible)
    {
        _editDialogVisible = visible;
        if (!visible)
        {
            _dialogClosedAt = DateTime.Now;
        }
    }

    private async Task HandleEditSave(SourceItem item)
    {
        _editDialogVisible = false;
        _editingItem = null;
        await RefreshAsync();
        await NotifyConfigChanged();
    }

    private async Task HandleEditDelete(SourceItem item)
    {
        _editDialogVisible = false;
        _editingItem = null;
        await DeleteSourceItem(item);
    }

    #endregion

    #region Add Mod Dialog

    private void OpenAddModDialog()
    {
        _addModDialogVisible = true;
    }

    private async Task HandleModsAdded()
    {
        await RefreshAsync();
        await NotifyConfigChanged();
        Snackbar.Add("Mod(s) added successfully! Click 'Apply Changes' to save.", Severity.Success);
    }

    #endregion

    #region View Files Dialog

    private void ViewFiles(SourceItem item)
    {
        _viewFilesItem = item;
        _viewFilesDialogVisible = true;
    }

    #endregion

    #region Update / Reinstall

    private async Task HandleUpdate(SourceItem item)
    {
        if (item.Health?.UpdateAvailable != true || string.IsNullOrEmpty(item.Health.UpdateUrl))
        {
            Snackbar.Add("No update available or update URL missing", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Update Mod",
            $"Download and install update for '{item.DisplayName}'?",
            yesText: "Update",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        await DownloadAndInstallAsync(item.Health.UpdateUrl, item.DisplayName, item.Optional);
    }

    private async Task HandleReinstall(SourceItem item)
    {
        // Try to find on Forge by GUID
        if (item.Health?.ForgeGuid != null)
        {
            Snackbar.Add($"Searching Forge for '{item.DisplayName}'...", Severity.Info);

            var modResult = await ForgeService.GetModByGuidAsync(item.Health.ForgeGuid);
            if (modResult?.Success == true && modResult.Mod != null)
            {
                var latestVersion = modResult.Mod.Versions?.FirstOrDefault();
                if (latestVersion?.Link != null)
                {
                    var confirmed = await DialogService.ShowMessageBox(
                        "Reinstall Mod",
                        $"Download and reinstall '{modResult.Mod.Name}' v{latestVersion.Version}?",
                        yesText: "Reinstall",
                        cancelText: "Cancel");

                    if (confirmed != true)
                        return;

                    var downloadUrl = latestVersion.Link.StartsWith("http")
                        ? latestVersion.Link
                        : ForgeService.BuildDownloadUrl(modResult.Mod.Id, modResult.Mod.Slug, latestVersion.Version);

                    await DownloadAndInstallAsync(downloadUrl, modResult.Mod.Name, item.Optional);
                    return;
                }
            }

            Snackbar.Add("Could not find mod on Forge. Try using 'Add Mod' to reinstall manually.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("No Forge GUID detected. Use 'Add Mod' to reinstall manually.", Severity.Warning);
        }
    }

    private async Task DownloadAndInstallAsync(string url, string modName, bool optional)
    {
        Snackbar.Add($"Downloading {modName}...", Severity.Info);

        try
        {
            var downloadResult = await ModDownloadService.DownloadAndExtractAsync(url);

            if (!downloadResult.Success)
            {
                Snackbar.Add($"Download failed: {downloadResult.Error}", Severity.Error);
                return;
            }

            var installResult = await ModDownloadService.InstallExtractedAsync(
                downloadResult.ExtractPath!,
                downloadResult.SuggestedInstallPaths);

            if (downloadResult.TempDir != null)
            {
                ModDownloadService.CleanupTempDir(downloadResult.TempDir);
            }

            if (installResult.Success)
            {
                Snackbar.Add($"Successfully installed {installResult.CopiedFiles} files!", Severity.Success);
                await RefreshAsync();
                await NotifyConfigChanged();
            }
            else
            {
                Snackbar.Add($"Install failed: {installResult.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    #endregion

    #region Actions

    private async Task ToggleOptional(SourceItem item)
    {
        try
        {
            await ConfigService.ToggleOptionalStagedAsync(item.Path);
            item.Optional = !item.Optional;
            Snackbar.Add($"'{item.DisplayName}' marked as {(item.Optional ? "optional" : "required")}. Click 'Apply Changes' to save.", Severity.Info);
            ApplyFilters();
            await NotifyConfigChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSourceItem(SourceItem item)
    {
        if (item.LinkedTo.Count > 0)
        {
            var result = await DialogService.ShowMessageBox(
                "Delete Linked Items?",
                $"'{item.DisplayName}' is linked to {item.LinkedTo.Count} other item(s). Do you want to delete all linked items as well?",
                yesText: "Delete All", noText: "Delete This Only", cancelText: "Cancel");

            if (result == null)
                return;

            await ConfigService.DeleteSourceItemAsync(item.Path, deleteLinked: result == true);
        }
        else
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Delete Source Item",
                $"Are you sure you want to delete '{item.DisplayName}'? This will remove the files from disk.",
                yesText: "Delete", cancelText: "Cancel");

            if (confirmed != true)
                return;

            await ConfigService.DeleteSourceItemAsync(item.Path);
        }

        Snackbar.Add($"'{item.DisplayName}' deleted", Severity.Warning);
        await RefreshAsync();
    }

    #endregion

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }
}

<style>
    .source-group-panel {
        overflow: hidden;
    }

    .source-group-panel .mud-expand-panel-header {
        background: transparent !important;
    }

    .source-group-panel .mud-expand-panel-content {
        padding: 0 !important;
    }

    .stat-chip {
        cursor: pointer;
    }

    .stat-chip:hover {
        filter: brightness(1.1);
    }
</style>
