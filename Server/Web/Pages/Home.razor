@page "/modgod"
@layout MainLayout

@using ModGod.Models
@using ModGod.Services
@using Color = MudBlazor.Color
@using System.Linq
@using Microsoft.JSInterop
@using System.IO
@using System.Text.Json

@inject ConfigService ConfigService
@inject ModInstallService ModInstallService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ModDownloadService ModDownloadService

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <!-- Header Section -->
    <MudPaper Class="pa-6 mb-4 glass-panel" Style="border-radius: 16px; margin-top: 55px;">
        <div class="d-flex justify-space-between align-center">
            <div>
                <MudText Typo="Typo.h4" Style="color: var(--text-primary); font-weight: 800; letter-spacing: -1px;">SPT Server Mod Manager</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--text-secondary); max-width: 600px;">
                    Add mods to be installed on your SPT server. Clients will automatically sync from the installed files on the server.
                </MudText>
            </div>
            <div class="d-flex gap-2">
                <MudTooltip Text="Reload config from disk (if edited externally)">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   OnClick="ReloadFromDisk"
                                   Disabled="@_isApplying"
                                   Style="color: var(--text-secondary);" />
                </MudTooltip>
            </div>
        </div>

        @if (ConfigService.HasPendingChanges())
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4" Dense="true">
                You have unsaved changes. Click "Apply Changes" to install/remove mods.
                @{
                    var changes = ConfigService.CalculateStagedChanges();
                }
                @if (changes.ModsToInstall.Count > 0)
                {
                    <span class="ml-2">📦 @changes.ModsToInstall.Count to install</span>
                }
                @if (changes.ModsToRemove.Count > 0)
                {
                    <span class="ml-2">🗑️ @changes.ModsToRemove.Count to remove</span>
                }
                @if (changes.ModsToUpdate.Count > 0)
                {
                    <span class="ml-2">🔄 @changes.ModsToUpdate.Count to update</span>
                }
                @if (changes.ModsToReinstall.Count > 0)
                {
                    <span class="ml-2">🔁 @changes.ModsToReinstall.Count to reinstall</span>
                }
            </MudAlert>
        }
    </MudPaper>

    <MudTabs ActivePanelIndex="@_activeTabIndex"
             ActivePanelIndexChanged="OnTabChanged"
             Class="mb-4">
        <MudTabPanel Text="Mods" class="mt-4">
            <!-- Stats Bar (Clickable Filters) -->
            <StatsBar TotalCount="@ConfigService.StagedConfig.ModList.Count"
                      InstalledCount="@GetInstalledModCount()"
                      PendingCount="@GetPendingModCount()"
                      PendingRemovalCount="@GetPendingRemovalCount()"
                      RequiredCount="@ConfigService.StagedConfig.ModList.Count(m => !m.Optional)"
                      OptionalCount="@ConfigService.StagedConfig.ModList.Count(m => m.Optional)"
                      ActiveFilter="@_activeStatusFilter"
                      OnFilterChanged="@((filter) => { _activeStatusFilter = filter; })" />

            <!-- Search Bar -->
            <div class="d-flex align-center justify-space-between mb-4">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_searchQuery"
                                  Placeholder="Search mods..."
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Clearable="true"
                                  Style="max-width: 400px; background: var(--card-bg);" />
                    @if (_activeStatusFilter != null || !string.IsNullOrEmpty(_searchQuery))
                    {
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearFilters"
                                   Style="color: var(--text-secondary);">
                            Clear Filters
                        </MudButton>
                    }
                </div>
                @{
                    var modsWithWarnings = GetModsWithWarnings();
                    var warningCount = modsWithWarnings.Count;
                }
                @if (warningCount > 0)
                {
                    <MudTooltip>
                        <TooltipContent>
                            <div style="max-width: 300px;">
                                <MudText Typo="Typo.body2" Class="mb-2"><b>Why reinstall mods with warnings?</b></MudText>
                                <MudText Typo="Typo.caption">
                                    Mods with warnings have missing files or aren't being tracked by ModGod. 
                                    Reinstalling will re-download these mods and refresh their file tracking, 
                                    which helps ensure clients sync properly.
                                </MudText>
                            </div>
                        </TooltipContent>
                        <ChildContent>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Warning"
                                       Style="font-weight: 600; border-color: var(--accent-orange); color: var(--accent-orange);"
                                       OnClick="ReinstallAllModsWithWarnings">
                                Reinstall @warningCount with Warnings
                            </MudButton>
                        </ChildContent>
                    </MudTooltip>
                }
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Style="background: var(--accent-cyan); color: #000; font-weight: 600; box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);"
                           OnClick="OpenAddModsDialog">
                    Add Mods
                </MudButton>
            </div>

            <!-- Mod Cards -->
            @{
                var hasPendingRemoval = GetPendingRemovalCount() > 0;
            }

            @if (ConfigService.StagedConfig.ModList.Count == 0 && !hasPendingRemoval)
            {
                <MudPaper Class="pa-8 text-center" Style="background: var(--card-bg); border: 2px dashed var(--border-color); border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Style="color: var(--text-secondary); font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--text-secondary);">No mods configured yet</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">Click "Add Mods" to get started</MudText>
                </MudPaper>
            }
            else
            {
                // Apply search and status filters
                var filteredMods = GetFilteredMods();

                // Sort: Protected mods first (ModGod), then pending install, pending uninstall, then installed
                // Within each group: needs-config first, then alphabetically
                var pendingMods = filteredMods
                    .Where(m => IsModPendingInstall(m))
                    .OrderByDescending(m => m.IsProtected)
                    .ThenByDescending(m => ModNeedsConfiguration(m))
                    .ThenBy(m => m.ModName, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                var removalMods = filteredMods
                    .Where(m => IsModPendingRemoval(m))
                    .OrderByDescending(m => m.IsProtected)
                    .ThenBy(m => m.ModName, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                var installedMods = filteredMods
                    .Where(m => !IsModPendingInstall(m) && !IsModPendingRemoval(m))
                    .OrderByDescending(m => m.IsProtected)
                    .ThenBy(m => m.ModName, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                @if (filteredMods.Count == 0)
                {
                    <MudPaper Class="pa-6 text-center" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px;">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color: var(--text-secondary);" />
                        <MudText Typo="Typo.body1" Class="mt-2" Style="color: var(--text-secondary);">No mods match your search or filter</MudText>
                    </MudPaper>
                }
                else
                {
                    if (pendingMods.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2" Style="color: var(--accent-orange); font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Pending" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                            Pending (@pendingMods.Count)
                        </MudText>
                        <MudGrid Class="mb-4">
                            @foreach (var mod in pendingMods)
                            {
<ModCard Mod="@mod"
                                         IsPendingInstall="@IsModPendingInstall(mod)"
                                         IsPendingRemoval="@IsModPendingRemoval(mod)"
                                         NeedsConfiguration="@ModNeedsConfiguration(mod)"
                                         OverwriteCount="@GetOverwriteStatsForMod(mod).OverwriteCount"
                                         SkippedCount="@GetOverwriteStatsForMod(mod).SkippedCount"
                                         MissingFilesCount="@GetMissingInstalledFiles(mod).Count"
                                         CardStyle="@GetModCardStyle(mod)"
                                         StatusChipStyle="@GetStatusChipStyleForMod(mod)"
                                         StatusText="@GetStatusTextForMod(mod)"
                                         OnEdit="EditMod"
                                         OnDelete="DeleteMod"
                                         OnToggleOptional="ToggleModOptional"
                                         OnOpenUninstallDialog="OpenUninstallDialog"
                                         OnUndoRemoval="UndoRemoval"
                                         OnReinstall="ReinstallMod" />
                            }
                        </MudGrid>
                    }

                    if (removalMods.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2" Style="color: var(--accent-red); font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                            Pending Uninstall (@removalMods.Count)
                        </MudText>
                        <MudGrid Class="mb-4">
                            @foreach (var mod in removalMods)
                            {
<ModCard Mod="@mod"
                                         IsPendingInstall="@IsModPendingInstall(mod)"
                                         IsPendingRemoval="@IsModPendingRemoval(mod)"
                                         NeedsConfiguration="@ModNeedsConfiguration(mod)"
                                         OverwriteCount="@GetOverwriteStatsForMod(mod).OverwriteCount"
                                         SkippedCount="@GetOverwriteStatsForMod(mod).SkippedCount"
                                         MissingFilesCount="@GetMissingInstalledFiles(mod).Count"
                                         CardStyle="@GetModCardStyle(mod)"
                                         StatusChipStyle="@GetStatusChipStyleForMod(mod)"
                                         StatusText="@GetStatusTextForMod(mod)"
                                         OnEdit="EditMod"
                                         OnDelete="DeleteMod"
                                         OnToggleOptional="ToggleModOptional"
                                         OnOpenUninstallDialog="OpenUninstallDialog"
                                         OnUndoRemoval="UndoRemoval"
                                         OnReinstall="ReinstallMod" />
                            }
                        </MudGrid>
                    }

                    if (installedMods.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2" Style="color: var(--accent-green); font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                            Installed (@installedMods.Count)
                        </MudText>
                        <MudGrid>
                            @foreach (var mod in installedMods)
                            {
<ModCard Mod="@mod"
                                         IsPendingInstall="@IsModPendingInstall(mod)"
                                         IsPendingRemoval="@IsModPendingRemoval(mod)"
                                         NeedsConfiguration="@ModNeedsConfiguration(mod)"
                                         OverwriteCount="@GetOverwriteStatsForMod(mod).OverwriteCount"
                                         SkippedCount="@GetOverwriteStatsForMod(mod).SkippedCount"
                                         MissingFilesCount="@GetMissingInstalledFiles(mod).Count"
                                         CardStyle="@GetModCardStyle(mod)"
                                         StatusChipStyle="@GetStatusChipStyleForMod(mod)"
                                         StatusText="@GetStatusTextForMod(mod)"
                                         OnEdit="EditMod"
                                         OnDelete="DeleteMod"
                                         OnToggleOptional="ToggleModOptional"
                                         OnOpenUninstallDialog="OpenUninstallDialog"
                                         OnUndoRemoval="UndoRemoval"
                                         OnReinstall="ReinstallMod" />
                            }
                        </MudGrid>
                    }
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Sync Rules" Class="mt-4">
            <SyncRulesTab @ref="_syncRulesTab" OnConfigChanged="StateHasChanged" />
        </MudTabPanel>

        <MudTabPanel Text="Health Check (Experimental)" Class="mt-4">
            <HealthCheckTab OnModsStaged="StateHasChanged" />
        </MudTabPanel>

        <MudTabPanel Text="Settings" Class="mt-4">
            <div style="max-width: 930px;">
                <!-- Forge Integration (full width row) -->
                <MudText Typo="Typo.h6" Class="mb-3" Style="color: var(--text-primary);">
                    <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-2" Style="vertical-align: middle;" />
                    Forge Integration
                </MudText>
                <ForgeApiKeyInput OnApiKeyChanged="StateHasChanged" />

                <!-- Default Install Paths (full width row) -->
                <MudText Typo="Typo.h6" Class="mb-3 mt-6" Style="color: var(--text-primary);">
                    <MudIcon Icon="@Icons.Material.Filled.FolderCopy" Class="mr-2" Style="vertical-align: middle;" />
                    Default Install Paths
                </MudText>
                <DefaultInstallPathsEditor @ref="_defaultInstallPathsEditor" OnChange="StateHasChanged" />
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

<!-- Floating Apply/Discard Footer -->
@if (ConfigService.HasPendingChanges())
{
    <div class="floating-action-footer visible">
        <div class="floating-action-content">
            <div class="floating-action-info">
                @{
                    var footerChanges = ConfigService.CalculateStagedChanges();
                    var changeItems = new List<string>();
                    if (footerChanges.ModsToInstall.Count > 0) changeItems.Add($"{footerChanges.ModsToInstall.Count} to install");
                    if (footerChanges.ModsToRemove.Count > 0) changeItems.Add($"{footerChanges.ModsToRemove.Count} to remove");
                    if (footerChanges.ModsToUpdate.Count > 0) changeItems.Add($"{footerChanges.ModsToUpdate.Count} to update");
                    if (footerChanges.ModsToReinstall.Count > 0) changeItems.Add($"{footerChanges.ModsToReinstall.Count} to reinstall");
                }
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="color: var(--accent-orange);" />
                <span>Pending changes: @string.Join(", ", changeItems)</span>
            </div>
            <div class="floating-action-buttons">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Undo"
                           Color="Color.Default"
                           Size="Size.Small"
                           Style="font-weight: 600; border-color: var(--border-color); color: var(--text-secondary);"
                           OnClick="DiscardChanges"
                           Disabled="@_isApplying">
                    Discard
                </MudButton>
                <MudTooltip Text="@(AnyModsNeedConfiguration() ? "Configure all mods before applying" : "")" Disabled="@(!AnyModsNeedConfiguration())">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               Color="Color.Success"
                               Size="Size.Small"
                               Style="font-weight: 600; box-shadow: 0 0 8px rgba(74, 222, 128, 0.3);"
                               OnClick="ApplyChanges"
                               Disabled="@(_isApplying || AnyModsNeedConfiguration())">
                        @if (_isApplying)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Applying...</span>
                        }
                        else if (AnyModsNeedConfiguration())
                        {
                            <span>Mods Need Config</span>
                        }
                        else
                        {
                            <span>Apply Changes</span>
                        }
                    </MudButton>
                </MudTooltip>
            </div>
        </div>
    </div>
}

<!-- Add Mods Dialog -->
<AddModsDialog @bind-Visible="_addDialogVisible" OnModsAdded="StateHasChanged" />

<!-- Edit Mod Dialog -->
<EditModDialog @bind-Visible="_editDialogVisible"
               Mod="_editingMod"
               IsPendingInstall="@(_editingMod != null && IsModPendingInstall(_editingMod))"
               MissingFiles="@(_editingMod != null ? GetMissingInstalledFiles(_editingMod) : new List<string>())"
               OnSave="HandleEditModSave" />

<!-- Uninstall Mod Dialog -->
<UninstallDialog @bind-Visible="_uninstallDialogVisible"
                 Mod="_uninstallMod"
                 OnConfirm="HandleUninstallConfirm" />

<!-- Apply Changes Result Dialog -->
<ApplyResultDialog @bind-Visible="_applyResultDialogVisible" Result="_applyResult" />

<!-- Migration Dialog (for legacy config) -->
<MigrationDialog @bind-Visible="_migrationDialogVisible" OnMigrationComplete="StateHasChanged" />

<!-- Reinstall Progress Dialog -->
<ReinstallProgressDialog @bind-Visible="_reinstallDialogVisible"
                         ModsToReinstall="_modsToReinstall"
                         OnReinstallComplete="StateHasChanged" />

@code {
    private bool _hasLoggedInit = false;
    private int _activeTabIndex = 0;

    // Tab references for refresh on discard
    private SyncRulesTab? _syncRulesTab;
    private DefaultInstallPathsEditor? _defaultInstallPathsEditor;

    // Search and filter
    private string _searchQuery = "";
    private string? _activeStatusFilter = null; // null = show all, "Installed", "Pending", "Required"

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasLoggedInit)
        {
            _hasLoggedInit = true;
            await JS.InvokeVoidAsync("console.log", "[ModGod] Frontend loaded!");

            // Check for legacy config and show migration dialog if needed
            if (ConfigService.IsLegacyConfig)
            {
                _migrationDialogVisible = true;
                StateHasChanged();
            }
        }
    }

    // Migration dialog state
    private bool _migrationDialogVisible;

    // RenderModCard moved to ModCard component

    private async Task ToggleModOptional(ModEntry mod)
    {
        CloseAllDialogs();
        mod.Optional = !mod.Optional;
        await ConfigService.SaveStagedConfigAsync();
        Snackbar.Add($"'{mod.ModName}' is now {(mod.Optional ? "optional" : "required")}", Severity.Info);
        StateHasChanged();
    }

    // State
    private bool _isApplying = false;
    private ApplyChangesResult? _applyResult;
    private bool _applyResultDialogVisible = false;

    // Add Mods Dialog - state managed by AddModsDialog component
    private bool _addDialogVisible;

    // Edit Mod Dialog - state managed by EditModDialog component
    private bool _editDialogVisible;
    private ModEntry? _editingMod;


    // Enums and shared classes moved to ViewModels.cs

    // Uninstall dialog - state managed by UninstallDialog component
    private bool _uninstallDialogVisible;
    private ModEntry? _uninstallMod;

    // Reinstall progress dialog
    private bool _reinstallDialogVisible;
    private List<ModEntry> _modsToReinstall = new();

    // Apply Changes
    private async Task ApplyChanges()
    {
        CloseAllDialogs();
        _isApplying = true;
        StateHasChanged();

        try
        {
            _applyResult = await ModInstallService.ApplyPendingChangesAsync(NavigationManager.BaseUri.TrimEnd('/'));
            _applyResultDialogVisible = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error applying changes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isApplying = false;
            StateHasChanged();
        }
    }

    // Discard Changes - reset staged config to match live config
    private async Task DiscardChanges()
    {
        CloseAllDialogs(); // Must be BEFORE showing message box to prevent edit dialog from reopening

        var result = await DialogService.ShowMessageBox(
            "Discard Changes",
            "This will discard all unsaved changes and reset to the last applied state. Continue?",
            yesText: "Discard", cancelText: "Cancel");

        if (result == true)
        {
            await ConfigService.ResetStagedConfigAsync();

            // Refresh sync rules tab to reload from config
            if (_syncRulesTab != null)
                await _syncRulesTab.ReloadFromConfigAsync();

            // Refresh default install paths editor
            _defaultInstallPathsEditor?.ReloadFromConfig();

            Snackbar.Add("Changes discarded.", Severity.Info);
            StateHasChanged();
        }
    }

    // Reload config from disk (useful if edited externally)
    private async Task ReloadFromDisk()
    {
        CloseAllDialogs();
        await ConfigService.ReloadConfigFromDiskAsync();

        // Refresh sync rules tab to reload from config
        if (_syncRulesTab != null)
            await _syncRulesTab.ReloadFromConfigAsync();

        // Refresh default install paths editor
        _defaultInstallPathsEditor?.ReloadFromConfig();

        Snackbar.Add("Reloaded config from disk.", Severity.Info);
        StateHasChanged();
    }

    // Add Mods Dialog Methods
    private void OpenAddModsDialog()
    {
        _addDialogVisible = true;
    }

    // Tab change handler
    private void OnTabChanged(int index)
    {
        _activeTabIndex = index;
        CloseAllDialogs();
    }

    // Helper to close all dialogs - prevents dialogs from reopening on state changes
    private void CloseAllDialogs()
    {
        _editDialogVisible = false;
        _editingMod = null;
        _uninstallDialogVisible = false;
        _uninstallMod = null;
        _addDialogVisible = false;
        _reinstallDialogVisible = false;
        _modsToReinstall.Clear();
    }

    // Edit Mod Dialog Methods
    private void EditMod(ModEntry mod)
    {
        // Prevent editing protected mods (like ModGod itself)
        if (mod.IsProtected)
        {
            Snackbar.Add($"'{mod.ModName}' is a built-in mod and cannot be edited.", Severity.Info);
            return;
        }

        // Ensure uninstall dialog is closed before opening edit dialog
        _uninstallDialogVisible = false;
            _editingMod = mod;
            _editDialogVisible = true;
    }

    private async Task HandleEditModSave(EditModResult result)
    {
        if (_editingMod == null) return;

        _editingMod.ModName = result.ModName;
        _editingMod.Optional = result.IsOptional;
        _editingMod.InstallPaths = result.InstallPaths;
        _editingMod.FileRules = result.FileRules;

        // Update installed files if they were modified
        if (result.InstalledFiles != null)
        {
            _editingMod.InstalledFiles = result.InstalledFiles;
        }

        await ConfigService.SaveStagedConfigAsync();
        Snackbar.Add($"Mod '{result.ModName}' updated!", Severity.Success);

        _editDialogVisible = false;
        _editingMod = null;
        StateHasChanged();
    }

    // File rules helpers - now handled by EditModDialog component
    // NormalizeRulePath is still needed by Sync Exclusions and other methods

    private string NormalizeRulePath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return string.Empty;
        return path.Replace("\\", "/").TrimStart('/');
    }

    // File rules tree building moved to EditModDialog component

    // Uninstall helpers moved to UninstallDialog component

    private void OpenUninstallDialog(ModEntry mod)
    {
        // Ensure edit dialog is closed before opening uninstall dialog
        _editDialogVisible = false;
        _uninstallMod = mod;
        _uninstallDialogVisible = true;
    }

    private async Task HandleUninstallConfirm(List<string> selectedPaths)
    {
        if (_uninstallMod == null) return;

        ConfigService.SetRemovalSelection(_uninstallMod.DownloadUrl, selectedPaths);

        await ConfigService.RemoveModFromStagedAsync(_uninstallMod.DownloadUrl);
        Snackbar.Add($"Mod '{_uninstallMod.ModName}' will be removed. Click 'Apply Changes' to uninstall.", Severity.Warning);

        _uninstallDialogVisible = false;
        _uninstallMod = null;
        StateHasChanged();
    }

    // Delete Mod
    private async Task DeleteMod(ModEntry mod)
    {
        // Prevent deletion of protected mods (like ModGod itself)
        if (mod.IsProtected)
        {
            Snackbar.Add($"'{mod.ModName}' is a protected mod and cannot be removed.", Severity.Warning);
            return;
        }

        // With staged config, we always remove from staged config
        // The difference is just in the messaging
        var isPending = IsModPendingInstall(mod);
        var isRemoval = IsModPendingRemoval(mod);

        if (isPending)
        {
            // Not yet installed - just remove from staged config
            CloseAllDialogs(); // Must be BEFORE showing message box

            var result = await DialogService.ShowMessageBox(
                "Remove Mod",
                $"Remove '{mod.ModName}' from the mod list? (It hasn't been installed yet)",
                yesText: "Remove", cancelText: "Cancel");

            if (result == true)
            {
                await ConfigService.RemoveModFromStagedAsync(mod.DownloadUrl);
                Snackbar.Add($"Mod '{mod.ModName}' removed.", Severity.Warning);
                StateHasChanged();
            }
        }
        else if (isRemoval)
        {
            CloseAllDialogs(); // Close before opening uninstall dialog
            OpenUninstallDialog(mod);
        }
        else
        {
            CloseAllDialogs(); // Close before opening uninstall dialog
            OpenUninstallDialog(mod);
        }
    }

    // Search and Filter Methods
    private List<ModEntry> GetFilteredMods()
    {
        // Combine staged mods (working copy) with pending removal mods (from live config but removed in staged)
        var stagedMods = ConfigService.StagedConfig.ModList;
        var removalSet = GetPendingRemovalUrlSet();
        var removalMods = ConfigService.Config.ModList
            .Where(m => removalSet.Contains(m.DownloadUrl))
            .ToList();

        var allMods = stagedMods.Concat(removalMods)
            .GroupBy(m => m.DownloadUrl)
            .Select(g => g.First())
            .AsEnumerable();

        // Apply status filter
        if (_activeStatusFilter != null)
        {
            allMods = _activeStatusFilter switch
            {
                "Installed" => allMods.Where(m => !IsModPendingInstall(m) && !IsModPendingRemoval(m)),
                "Pending" => allMods.Where(m => IsModPendingInstall(m)),
                "PendingRemoval" => allMods.Where(m => IsModPendingRemoval(m)),
                "Required" => allMods.Where(m => !m.Optional),
                "Optional" => allMods.Where(m => m.Optional),
                _ => allMods
            };
        }

        // Apply search filter (case insensitive)
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var query = _searchQuery.Trim();
            allMods = allMods.Where(m =>
                m.ModName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                m.DownloadUrl.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        return allMods.ToList();
    }

    // ToggleStatusFilter and GetStatsCardStyle moved to StatsBar component

    private void ClearFilters()
    {
        _searchQuery = "";
        _activeStatusFilter = null;
    }

// Utility Methods
    /// <summary>
    /// Check if a mod is pending install (in staged but not in live config, OR pending reinstall)
    /// </summary>
    private bool IsModPendingInstall(ModEntry mod)
    {
        // True if mod is new (not in live config) OR if it's marked for reinstall
        return !ConfigService.Config.ModList.Any(m => m.DownloadUrl == mod.DownloadUrl)
            || ConfigService.StagedConfig.PendingReinstallUrls.Contains(mod.DownloadUrl);
    }

    /// <summary>
    /// Get set of URLs pending removal (present in live but removed from staged)
    /// </summary>
    private HashSet<string> GetPendingRemovalUrlSet()
    {
        return ConfigService.CalculateStagedChanges().ModsToRemove
            .Select(m => m.DownloadUrl)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

/// <summary>
    /// Get count of mods that are already installed (in both staged and live, and NOT pending reinstall)
    /// </summary>
    private int GetInstalledModCount()
    {
        var liveUrls = ConfigService.Config.ModList.Select(m => m.DownloadUrl).ToHashSet();
        var reinstallUrls = ConfigService.StagedConfig.PendingReinstallUrls;
        return ConfigService.StagedConfig.ModList.Count(m => 
            liveUrls.Contains(m.DownloadUrl) && !reinstallUrls.Contains(m.DownloadUrl));
    }

    /// <summary>
    /// Get count of mods pending install (in staged but not in live, OR pending reinstall)
    /// </summary>
    private int GetPendingModCount()
    {
        var liveUrls = ConfigService.Config.ModList.Select(m => m.DownloadUrl).ToHashSet();
        var reinstallUrls = ConfigService.StagedConfig.PendingReinstallUrls;
        return ConfigService.StagedConfig.ModList.Count(m => 
            !liveUrls.Contains(m.DownloadUrl) || reinstallUrls.Contains(m.DownloadUrl));
    }

    /// <summary>
    /// Get count of mods pending removal (in live but removed from staged)
    /// </summary>
    private int GetPendingRemovalCount()
    {
        return GetPendingRemovalUrlSet().Count;
    }

    /// <summary>
    /// Check if a mod needs configuration (pending install but no install paths)
    /// </summary>
    private bool ModNeedsConfiguration(ModEntry mod)
    {
        return IsModPendingInstall(mod) &&
            (mod.InstallPaths.Count == 0 ||
             mod.InstallPaths.All(p => p == null || p.Length < 2 || string.IsNullOrWhiteSpace(p[0])));
    }

    private bool AnyModsNeedConfiguration()
    {
        return ConfigService.StagedConfig.ModList.Any(ModNeedsConfiguration);
    }

    // FormatTimestamp moved to ModCard component

    private string GetModCardStyle(ModEntry mod)
    {
        var baseStyle = "border-radius: 16px; height: 100%; transition: all 0.2s ease;";

        if (ModNeedsConfiguration(mod))
        {
            return baseStyle + " border-left: 3px solid var(--accent-red); box-shadow: inset 0 0 20px rgba(248, 113, 113, 0.05);";
        }

        // Check staged status instead of mod.Status
        if (IsModPendingInstall(mod))
        {
            return baseStyle + " border-left: 3px solid var(--accent-orange); box-shadow: inset 0 0 20px rgba(251, 191, 36, 0.05);";
        }

        // Check if mod is pending removal (in live but not in staged)
        if (IsModPendingRemoval(mod))
        {
            return baseStyle + " border-left: 3px solid var(--accent-red); opacity: 0.6;";
        }

        return baseStyle;
    }

    /// <summary>
    /// Check if a mod is pending removal (in live config but not in staged - staged from a remove action)
    /// Note: We show mods from staged config in UI, but we can still track this for styling
    /// </summary>
    private bool IsModPendingRemoval(ModEntry mod)
    {
        var removalSet = GetPendingRemovalUrlSet();
        return removalSet.Contains(mod.DownloadUrl);
    }

    private string GetStatusChipStyleForMod(ModEntry mod)
    {
        if (IsModPendingInstall(mod))
        {
            return "background: rgba(251, 191, 36, 0.9); color: #000; font-weight: 600;";
        }
        if (IsModPendingRemoval(mod))
        {
            return "background: rgba(248, 113, 113, 0.9); color: #000; font-weight: 600;";
        }
        return "background: rgba(74, 222, 128, 0.9); color: #000; font-weight: 600;";
    }

    private string GetStatusTextForMod(ModEntry mod)
    {
        if (IsModPendingInstall(mod))
        {
            return "Pending Install";
        }
        if (IsModPendingRemoval(mod))
        {
            return "Pending Uninstall";
        }
        return "Installed";
    }

    private List<string> GetMissingInstalledFiles(ModEntry mod)
    {
        var missing = new List<string>();
        var files = mod.InstalledFiles ?? new List<string>();
        var sptRoot = ConfigService?.SptRoot;
        if (string.IsNullOrWhiteSpace(sptRoot)) return missing;

        foreach (var rel in files)
        {
            if (string.IsNullOrWhiteSpace(rel)) continue;
            var normalized = rel.Replace("\\", "/");
            var full = Path.Combine(sptRoot, normalized.Replace("/", Path.DirectorySeparatorChar.ToString()));
            if (!File.Exists(full))
            {
                missing.Add(normalized);
            }
        }

        return missing;
    }

    private async Task UndoRemoval(ModEntry mod)
    {
        CloseAllDialogs();
        try
        {
            var liveMod = ConfigService.Config.ModList.FirstOrDefault(m => m.DownloadUrl == mod.DownloadUrl);
            if (liveMod == null)
            {
                Snackbar.Add("Unable to undo removal: mod not found in live config.", Severity.Warning);
                return;
            }

            // Deep clone to avoid mutating live reference
            var cloneJson = JsonSerializer.Serialize(liveMod);
            var clone = JsonSerializer.Deserialize<ModEntry>(cloneJson);
            if (clone == null)
            {
                Snackbar.Add("Unable to undo removal: serialization failed.", Severity.Error);
                return;
            }

            await ConfigService.AddModToStagedAsync(clone);
            // Remove from removalSelections in staged config
            ConfigService.StagedConfig.RemovalSelections.Remove(mod.DownloadUrl);
            await ConfigService.SaveStagedConfigAsync();
            Snackbar.Add($"Removal undone for '{clone.ModName}'!", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to undo removal: {ex.Message}", Severity.Error);
        }
    }

// Reinstall mod (re-download and stage) - opens progress dialog
    private void ReinstallMod(ModEntry mod)
    {
        CloseAllDialogs();

        if (string.IsNullOrEmpty(mod.DownloadUrl))
        {
            Snackbar.Add("Cannot reinstall: mod has no download URL.", Severity.Error);
            return;
        }

        _modsToReinstall = new List<ModEntry> { mod };
        _reinstallDialogVisible = true;
        StateHasChanged();
    }

    // Get mods that have warnings (missing files or no files tracked)
    private List<ModEntry> GetModsWithWarnings()
    {
        var sptRoot = ConfigService?.SptRoot;
        if (string.IsNullOrWhiteSpace(sptRoot) || ConfigService == null) return new List<ModEntry>();

        return ConfigService.StagedConfig.ModList
            .Where(m => !m.IsProtected && !IsModPendingInstall(m) && !IsModPendingRemoval(m))
            .Where(m => !string.IsNullOrEmpty(m.DownloadUrl))
            .Where(m => 
            {
                var installedFiles = m.InstalledFiles ?? new List<string>();
                // No files tracked
                if (installedFiles.Count == 0) return true;
                // Has missing files
                return installedFiles.Any(f =>
                {
                    var fullPath = Path.Combine(sptRoot, f.Replace("/", Path.DirectorySeparatorChar.ToString()));
                    return !File.Exists(fullPath);
                });
            })
            .ToList();
    }

    // Reinstall all mods with warnings
    private void ReinstallAllModsWithWarnings()
    {
        CloseAllDialogs();

        var modsWithWarnings = GetModsWithWarnings();
        if (modsWithWarnings.Count == 0)
        {
            Snackbar.Add("No mods with warnings found.", Severity.Info);
            return;
        }

        _modsToReinstall = modsWithWarnings;
        _reinstallDialogVisible = true;
        StateHasChanged();
    }

    // Legacy helpers for backwards compatibility
    private (int OverwriteCount, int SkippedCount) GetOverwriteStatsForMod(ModEntry mod)
    {
        try
        {
            var downloadUrl = mod?.DownloadUrl;
            if (string.IsNullOrEmpty(downloadUrl)) return (0, 0);

            var staging = ConfigService?.Staging;
            if (staging?.UrlToPath == null || !staging.UrlToPath.TryGetValue(downloadUrl, out var stagingPath))
                return (0, 0);

            if (string.IsNullOrEmpty(stagingPath)) return (0, 0);

            var extractedPath = Path.Combine(stagingPath, "extracted");
            if (!Directory.Exists(extractedPath)) return (0, 0);

            var installPaths = mod?.InstallPaths ?? new List<string[]>();
            var sptRoot = ConfigService?.SptRoot ?? string.Empty;

            // Build set of ignored paths from FileRules
            var ignoredPaths = new HashSet<string>(
                (mod?.FileRules ?? new List<FileCopyRule>())
                    .Where(r => r?.State == FileCopyRuleState.Ignore && !string.IsNullOrWhiteSpace(r.Path))
                    .Select(r => NormalizeRulePath(r.Path)),
                StringComparer.OrdinalIgnoreCase);

            var overwriteCount = 0;
            var skippedCount = 0;

            foreach (var pathPair in installPaths.Where(p => p != null && p.Length >= 2))
            {
                var source = pathPair[0];
                var target = pathPair[1];
                if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(target)) continue;

                var sourcePath = Path.Combine(extractedPath, source);
                // Handle both old format (<SPT_ROOT>/path) and new format (path) for backwards compatibility
                var targetRel = target.Replace("<SPT_ROOT>", "").TrimStart('/', '\\');
                var targetBasePath = Path.Combine(sptRoot, targetRel.Replace("/", Path.DirectorySeparatorChar.ToString()));

                if (Directory.Exists(sourcePath))
                {
                    var (ow, sk) = CountOverwriteFilesWithRules(sourcePath, targetBasePath, NormalizeRulePath(source), ignoredPaths);
                    overwriteCount += ow;
                    skippedCount += sk;
                }
                else if (File.Exists(sourcePath))
                {
                    // For single file sources, append the filename to the target path
                    var fileName = Path.GetFileName(sourcePath);
                    var targetFilePath = Path.Combine(targetBasePath, fileName);
                    if (File.Exists(targetFilePath))
                    {
                        var relPath = NormalizeRulePath(source);
                        if (IsPathInIgnoreSet(relPath, ignoredPaths))
                            skippedCount++;
                        else
                            overwriteCount++;
                    }
                }
            }

            return (overwriteCount, skippedCount);
        }
        catch
        {
            return (0, 0);
        }
    }

    private (int OverwriteCount, int SkippedCount) CountOverwriteFilesWithRules(string sourceDir, string targetDir, string relativeBase, HashSet<string> ignoredPaths)
    {
        var overwriteCount = 0;
        var skippedCount = 0;

        foreach (var file in Directory.GetFiles(sourceDir))
        {
            var targetFile = Path.Combine(targetDir, Path.GetFileName(file));
            if (File.Exists(targetFile))
            {
                var relPath = NormalizeRulePath(Path.Combine(relativeBase, Path.GetFileName(file)));
                if (IsPathInIgnoreSet(relPath, ignoredPaths))
                    skippedCount++;
                else
                    overwriteCount++;
            }
        }

        foreach (var dir in Directory.GetDirectories(sourceDir))
        {
            var dirName = Path.GetFileName(dir);
            var targetSubDir = Path.Combine(targetDir, dirName);
            var childRelBase = NormalizeRulePath(Path.Combine(relativeBase, dirName));
            var (ow, sk) = CountOverwriteFilesWithRules(dir, targetSubDir, childRelBase, ignoredPaths);
            overwriteCount += ow;
            skippedCount += sk;
        }

        return (overwriteCount, skippedCount);
    }

    private bool IsPathInIgnoreSet(string path, HashSet<string> ignoredPaths)
    {
        var norm = NormalizeRulePath(path);
        return ignoredPaths.Any(r =>
            norm.Equals(r, StringComparison.OrdinalIgnoreCase) ||
            norm.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase));
    }
}

