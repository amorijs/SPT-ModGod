@using ModGod.Services
@using Color = MudBlazor.Color
@using System.Reflection
@using Microsoft.JSInterop
@inherits LayoutComponentBase

@inject ISnackbar Snackbar
@inject ConfigService ConfigService
@inject IJSRuntime JS

<HeadContent>
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <meta name="robots" content="noindex, nofollow">
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <style>
        /* Dark Mode (default) */
        :root, .theme-dark {
            --primary-bg: #050505;
            --secondary-bg: #0a0a0a;
            --card-bg: rgba(22, 27, 34, 0.6);
            --glass-bg: rgba(22, 27, 34, 0.4);
            --appbar-bg: rgba(10, 10, 10, 0.8);
            
            --accent-cyan: #38bdf8;
            --accent-green: #4ade80;
            --accent-orange: #fbbf24;
            --accent-red: #f87171;
            
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            
            --border-color: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.15);
            --shadow-subtle: 0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
            --shadow-glow: 0 0 15px rgba(56, 189, 248, 0.15);
            --glass-blur: blur(12px);
            
            --bg-gradient: radial-gradient(circle at 15% 50%, rgba(56, 189, 248, 0.03) 0%, transparent 25%),
                           radial-gradient(circle at 85% 30%, rgba(74, 222, 128, 0.03) 0%, transparent 25%);
        }
        
        /* Light Mode */
        .theme-light {
            /* Warm, stone-based palette */
            --primary-bg: #fafaf9;
            --secondary-bg: #f5f5f4;
            --card-bg: #ffffff;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --appbar-bg: rgba(255, 255, 255, 0.8);
            
            --accent-cyan: #0e7490;
            --accent-green: #15803d;
            --accent-orange: #c2410c;
            --accent-red: #be123c;
            
            --text-primary: #1c1917;
            --text-secondary: #57534e;
            --text-muted: #a8a29e;
            
            --border-color: #e7e5e4;
            --border-hover: #d6d3d1;
            --shadow-subtle: 0 2px 8px -2px rgba(0, 0, 0, 0.05), 0 1px 4px -2px rgba(0, 0, 0, 0.02);
            --shadow-glow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
            --glass-blur: blur(12px);
            
            --bg-gradient: radial-gradient(circle at 50% 0%, rgba(120, 113, 108, 0.03) 0%, transparent 50%);
        }

        body {
            background: var(--primary-bg);
            background-image: var(--bg-gradient);
            background-attachment: fixed;
            transition: background 0.3s ease;
        }

        .mono {
            font-family: 'JetBrains Mono', monospace;
        }
        
        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-subtle);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .gradient-border {
            border: 1px solid transparent;
            background: linear-gradient(var(--secondary-bg), var(--secondary-bg)) padding-box,
                        linear-gradient(135deg, rgba(56, 189, 248, 0.5), rgba(74, 222, 128, 0.5)) border-box;
        }

        .glow-cyan {
            box-shadow: var(--shadow-glow);
        }
        
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--primary-bg);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--text-secondary);
        }
        
        /* Theme toggle button */
        .theme-toggle {
            transition: transform 0.3s ease;
        }
        .theme-toggle:hover {
            transform: rotate(15deg);
        }
    </style>
    <script>
        window.setTheme = (isDark) => {
            document.body.classList.remove('theme-dark', 'theme-light');
            document.body.classList.add(isDark ? 'theme-dark' : 'theme-light');
        };
    </script>
</HeadContent>

<MudThemeProvider Theme="@CustomTheme" @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudSnackbarProvider />
<MudDialogProvider />

<MudLayout>
        <MudAppBar Dense Elevation="0" Style="background: var(--appbar-bg); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-color);">
            <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Large" Style="color: var(--accent-cyan); filter: drop-shadow(0 0 5px rgba(56,189,248,0.5));" Class="mr-2" />
            <MudText Typo="Typo.h5" Style="color: var(--text-primary); font-weight: 700; letter-spacing: -0.5px;">ModGod</MudText>
            <MudText Typo="Typo.caption" Class="ml-2" Style="color: var(--text-secondary); align-self: flex-end; margin-bottom: 4px; font-family: monospace;">@Version</MudText>
            <MudSpacer/>
            <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                               Color="Color.Inherit" 
                               OnClick="ToggleTheme"
                               Class="theme-toggle"
                               Style="color: var(--text-secondary);" />
            </MudTooltip>
        </MudAppBar>
        <MudMainContent Class="pt-4 px-4" Style="min-height: calc(100vh - 48px);">
            @Body
        </MudMainContent>
    </MudLayout>

@code {
    private string Version => $"v{Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "0.0.0"}";
    private bool _isDarkMode = true;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("setTheme", _isDarkMode);
        }
    }
    
    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("setTheme", _isDarkMode);
    }
    
    MudTheme CustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0e7490",
            Secondary = "#15803d",
            Tertiary = "#c2410c",
            Background = "#fafaf9",
            Surface = "#ffffff",
            DrawerBackground = "#f5f5f4",
            DrawerText = "#1c1917",
            DrawerIcon = "#57534e",
            AppbarBackground = "#ffffff",
            AppbarText = "#1c1917",
            TextPrimary = "#1c1917",
            TextSecondary = "#57534e",
            TextDisabled = "#a8a29e",
            ActionDefault = "#57534e",
            ActionDisabled = "#d6d3d1",
            ActionDisabledBackground = "#e7e5e4",
            LinesDefault = "rgba(0, 0, 0, 0.06)",
            TableLines = "rgba(0, 0, 0, 0.06)",
            Divider = "rgba(0, 0, 0, 0.06)",
            Success = "#15803d",
            Info = "#0e7490",
            Warning = "#c2410c",
            Error = "#be123c",
            PrimaryContrastText = "#ffffff",
            SecondaryContrastText = "#ffffff",
            TertiaryContrastText = "#ffffff",
            SuccessContrastText = "#ffffff",
            InfoContrastText = "#ffffff",
            WarningContrastText = "#ffffff",
            ErrorContrastText = "#ffffff",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#38bdf8",
            Secondary = "#4ade80",
            Tertiary = "#fbbf24",
            Background = "#050505",
            Surface = "#0a0a0a",
            DrawerBackground = "#0a0a0a",
            DrawerText = "#f8fafc",
            DrawerIcon = "#94a3b8",
            AppbarBackground = "#0a0a0a",
            AppbarText = "#f8fafc",
            TextPrimary = "#f8fafc",
            TextSecondary = "#94a3b8",
            TextDisabled = "#64748b",
            ActionDefault = "#94a3b8",
            ActionDisabled = "#475569",
            ActionDisabledBackground = "#1e293b",
            LinesDefault = "rgba(255, 255, 255, 0.08)",
            TableLines = "rgba(255, 255, 255, 0.08)",
            Divider = "rgba(255, 255, 255, 0.08)",
            Success = "#4ade80",
            Info = "#38bdf8",
            Warning = "#fbbf24",
            Error = "#f87171",
            PrimaryContrastText = "#000000",
            SecondaryContrastText = "#000000",
            TertiaryContrastText = "#000000",
            SuccessContrastText = "#000000",
            InfoContrastText = "#000000",
            WarningContrastText = "#000000",
            ErrorContrastText = "#000000",
        },
    };
}
