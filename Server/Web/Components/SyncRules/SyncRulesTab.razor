@using ModGod.Web.Models
@using ModGod.Web.Components.Dialogs
@using ModGod.Services
@using ModGod.Models

<!-- Profile Selector -->
<div class="d-flex justify-center mb-4">
    <MudToggleGroup T="SyncProfile"
                    Value="_activeProfile"
                    ValueChanged="OnProfileChanged"
                    Color="@GetProfileColor()"
                    Size="Size.Large">
        <MudToggleItem Value="SyncProfile.Player">
            <div class="d-flex align-center gap-2 px-4 py-1">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
                <MudText>Player Clients</MudText>
            </div>
        </MudToggleItem>
        <MudToggleItem Value="SyncProfile.Headless">
            <div class="d-flex align-center gap-2 px-4 py-1">
                <MudIcon Icon="@Icons.Material.Filled.Dns" />
                <MudText>Headless Clients</MudText>
            </div>
        </MudToggleItem>
    </MudToggleGroup>
</div>

<!-- Main Content with Dynamic Accent Border -->
<MudPaper Class="pa-4 mb-4" Style="@($"background: var(--card-bg); border: 1px solid var(--border-color); border-top: 4px solid {GetAccentColor()}; border-radius: 8px;")">
    <!-- Context Header -->
    <div class="d-flex align-center mb-3">
        <MudIcon Icon="@GetProfileIcon()" Size="Size.Large"
                 Style="@($"color: {GetAccentColor()}; margin-right: 12px;")" />
        <div>
            <MudText Typo="Typo.h5" Style="color: var(--text-primary); font-weight: 600;">
                @GetProfileTitle()
            </MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                @GetProfileDescription()
            </MudText>
        </div>
    </div>

    @if (_activeProfile == SyncProfile.Headless)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Dense="true">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
            <strong>Not using a headless client?</strong> You can skip this profile entirely. Most users only need the Player Clients profile.
        </MudAlert>
    }
</MudPaper>

<!-- Sync Paths Section -->
<MudPaper Class="pa-4 mb-4" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px;">
    <div class="d-flex justify-space-between align-center mb-2">
        <div>
            <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" Style="vertical-align: middle;" />
                Sync Paths
            </MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Directories to sync from your server to @(_activeProfile == SyncProfile.Player ? "player" : "headless") clients.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Add"
                   Color="@GetProfileColor()"
                   OnClick="OpenAddSyncPathDialog">
            Add Path
        </MudButton>
    </div>

    @if (_syncPaths.Count == 0)
    {
        <MudAlert Severity="@(_activeProfile == SyncProfile.Player ? Severity.Warning : Severity.Info)" Dense="true" Class="mt-3">
            @if (_activeProfile == SyncProfile.Player)
            {
                <span>No sync paths configured. Player clients will not receive any files.</span>
            }
            else
            {
                <span>No sync paths configured for headless clients. This is normal if you don't use dedicated servers.</span>
            }
        </MudAlert>
    }
    else
    {
        <MudTable Items="_syncPaths" Dense="true" Hover="true" Class="mt-3"
                  Style="background: var(--secondary-bg);">
            <HeaderContent>
                <MudTh Style="color: var(--text-secondary);">Source (Server)</MudTh>
                <MudTh Style="color: var(--text-secondary);">Target (Client)</MudTh>
                <MudTh Style="width: 100px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Source">
                    <code style="color: var(--accent-cyan);">@context.Source</code>
                </MudTd>
                <MudTd DataLabel="Target">
                    <code style="color: var(--accent-green);">@context.Target</code>
                </MudTd>
                <MudTd>
                    <div class="d-flex align-center gap-1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Style="color: var(--text-secondary);"
                                       OnClick="@(() => OpenEditSyncPathDialog(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveSyncPath(context))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<!-- File/Folder Exclusions Section -->
<MudPaper Class="pa-4 mb-4" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px;">
    <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 600;">
        <MudIcon Icon="@Icons.Material.Filled.FolderOff" Class="mr-2" Style="vertical-align: middle;" />
        File/Folder Exclusions
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--text-secondary);">
        Browse files in your sync paths and click to exclude specific files/folders from syncing.
    </MudText>

    <div class="d-flex gap-2 mb-3">
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_loading"
                   OnClick="LoadTreeAsync">
            Refresh
        </MudButton>
        <MudText Typo="Typo.caption" Style="color: var(--text-secondary); align-self: center;">
            Click "Apply Changes" to commit.
        </MudText>
    </div>

    @if (_loading)
    {
        <div class="d-flex align-center mb-2">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <MudText Typo="Typo.body2">Scanning sync paths...</MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Warning">@_error</MudAlert>
    }
    else if (_treeRoot != null && _treeRoot.Children != null && _treeRoot.Children.Any())
    {
        <MudPaper Class="pa-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); max-height: 420px; overflow-y: auto;">
            <div class="mb-2" style="font-size:13px; color: var(--text-secondary);">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: var(--accent-green); vertical-align: middle;" /> Synced
                &nbsp;|&nbsp;
                <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Style="color: var(--accent-red); vertical-align: middle;" /> Excluded
                &nbsp;(click to toggle)
            </div>
            @foreach (var (node, depth) in GetFlattenedTree())
            {
                var state = GetNodeState(node);
                var indent = depth * 18;
                var capturedNode = node;
                var isExpanded = node.IsDirectory && _expandedDirs.Contains(node.RelativePath);
                var hasChildren = node.IsDirectory && node.Children?.Count > 0;
                var isExcluded = state == SyncNodeState.Excluded;

                <div class="d-flex align-center" style="padding-left:@(indent)px; margin-bottom:2px;">
                    @* Expand/collapse button for directories *@
                    @if (hasChildren)
                    {
                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                       Size="Size.Small"
                                       Style="padding: 2px; min-width: 24px; color: var(--text-secondary);"
                                       OnClick="() => ToggleExpand(capturedNode)" />
                    }
                    else
                    {
                        <div style="width: 28px;"></div>
                    }

                    @* Exclude toggle button *@
                    @{
                        var excludeIcon = state switch
                        {
                            SyncNodeState.Excluded => Icons.Material.Filled.Block,
                            SyncNodeState.Mixed => Icons.Material.Filled.RemoveCircleOutline,
                            _ => Icons.Material.Filled.CheckCircle
                        };
                        var iconColor = state switch
                        {
                            SyncNodeState.Excluded => "var(--accent-red)",
                            SyncNodeState.Mixed => "var(--accent-orange)",
                            _ => "var(--accent-green)"
                        };
                    }
                    <MudIconButton Icon="@excludeIcon"
                                   Size="Size.Small"
                                   Style="@($"padding: 2px; min-width: 24px; color: {iconColor};")"
                                   OnClick="() => OnNodeClick(capturedNode)" />

                    @* Directory/file name *@
                    @if (node.IsDirectory && hasChildren)
                    {
                        <span class="ml-1 mono @(isExcluded ? "strikethrough" : "")"
                              style="color: @(isExcluded ? "var(--text-secondary)" : "var(--text-primary)"); font-size: 13px; cursor: pointer;"
                              @onclick="@(() => ToggleExpand(capturedNode))">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />@(node.Name)
                        </span>
                    }
                    else
                    {
                        <span class="ml-1 mono @(isExcluded ? "strikethrough" : "")"
                              style="color: @(isExcluded ? "var(--text-secondary)" : "var(--text-primary)"); font-size: 13px;">
                            <MudIcon Icon="@(node.IsDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.InsertDriveFile)"
                                     Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />@(node.Name)
                        </span>
                    }
                </div>
            }
        </MudPaper>

        @if (_exclusionSet.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mt-3" Style="color: var(--accent-orange);">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="vertical-align: middle;" />
                @_exclusionSet.Count path(s) excluded from syncing
            </MudText>
        }
    }
    else if (_syncPaths.Count > 0)
    {
        <MudAlert Severity="Severity.Info">
            No files found in the sync paths. The directories may be empty.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            Add sync paths above to browse and exclude files.
        </MudAlert>
    }
</MudPaper>

<!-- Advanced: Default Exclusion Patterns (Collapsed) -->
<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Class="mr-2" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                    Advanced: Default Exclusion Patterns
                </MudText>
                <MudChip T="string" Size="Size.Small" Class="ml-2" Color="@(_useDefaultExclusions ? Color.Success : Color.Default)">
                    @(_useDefaultExclusions ? "Enabled" : "Disabled")
                </MudChip>
            </div>
        </TitleContent>
        <ChildContent>
            <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--text-secondary);">
                Built-in patterns to exclude logs, cache, dev files, and common mod data from syncing.
            </MudText>

            <MudSwitch T="bool"
                       Value="@_useDefaultExclusions"
                       ValueChanged="OnUseDefaultExclusionsChanged"
                       Color="Color.Success"
                       Label="@(_useDefaultExclusions ? "Using default exclusion patterns" : "Default exclusion patterns disabled")" />

            @if (_useDefaultExclusions)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--text-secondary);">
                    Patterns support globs: <code>*</code> (any chars), <code>**</code> (any path), <code>?</code> (single char)
                </MudText>
                <MudTextField T="string"
                              Value="@_defaultExclusionPatternsText"
                              ValueChanged="OnDefaultExclusionPatternsChanged"
                              Lines="10"
                              Variant="Variant.Outlined"
                              Placeholder="One pattern per line..."
                              Style="font-family: monospace; font-size: 12px;"
                              HelperText="Edit patterns above. Changes save automatically." />
                <div class="d-flex gap-2 mt-2">
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetDefaultExclusionsToBuiltIn">
                        Reset to Built-in Defaults
                    </MudButton>
                </div>
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

<!-- Add/Edit Sync Path Dialog -->
<AddSyncPathDialog @bind-Visible="_showAddSyncPathDialog"
                   ExistingSyncPaths="_syncPaths"
                   EditEntry="_editSyncPathEntry"
                   OnPathAdded="OnSyncPathAdded"
                   OnPathEdited="OnSyncPathEdited" />

<style>
    .strikethrough {
        text-decoration: line-through;
        opacity: 0.7;
    }
</style>

@code {
    [Inject] private ConfigService ConfigService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    [Parameter] public EventCallback OnConfigChanged { get; set; }

    // Profile selector
    private enum SyncProfile { Player, Headless }
    private SyncProfile _activeProfile = SyncProfile.Player;

    // State
    private bool _initialized = false;
    private bool _loading = false;
    private string? _error;

    // Default exclusions
    private bool _useDefaultExclusions = true;
    private List<string> _defaultExclusionPatterns = new();
    private string _defaultExclusionPatternsText = "";

    // Sync paths
    private List<SyncPathEntry> _syncPaths = new();
    private bool _showAddSyncPathDialog = false;
    private SyncPathEntry? _editSyncPathEntry = null;

    // File tree
    private FileNode? _treeRoot;
    private HashSet<string> _exclusionSet = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _expandedDirs = new(StringComparer.OrdinalIgnoreCase);

    // Dynamic config accessor
    private ClientSyncConfig CurrentConfig => _activeProfile == SyncProfile.Player
        ? (ConfigService.StagedConfig.PlayerSyncConfig ?? ClientSyncConfig.DefaultPlayerConfig())
        : (ConfigService.StagedConfig.HeadlessSyncConfig ?? ClientSyncConfig.DefaultHeadlessConfig());

    // Profile styling helpers
    private Color GetProfileColor() => _activeProfile == SyncProfile.Player ? Color.Primary : Color.Warning;
    private string GetAccentColor() => _activeProfile == SyncProfile.Player ? "var(--accent-cyan)" : "var(--accent-orange)";
    private string GetProfileIcon() => _activeProfile == SyncProfile.Player ? Icons.Material.Filled.Person : Icons.Material.Filled.Dns;

    private string GetProfileTitle() => _activeProfile == SyncProfile.Player
        ? "Player Client Syncing"
        : "Headless Client Syncing";

    private string GetProfileDescription() => _activeProfile == SyncProfile.Player
        ? "Configure which files sync to player game clients. These are regular players joining your server."
        : "Configure which files sync to headless (dedicated raid-hosting) clients. Only files explicitly added here will be synced.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeAsync();
        }
    }

    /// <summary>
    /// Force reload state from config (used when config is discarded/reset)
    /// </summary>
    public async Task ReloadFromConfigAsync()
    {
        _initialized = false;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        if (_initialized) return;
        await LoadProfileStateAsync();
        _initialized = true;
    }

    private async Task OnProfileChanged(SyncProfile profile)
    {
        _activeProfile = profile;
        _expandedDirs.Clear(); // Reset expanded state when switching profiles
        await LoadProfileStateAsync();
        StateHasChanged();
    }

    private async Task LoadProfileStateAsync()
    {
        var config = CurrentConfig;

        // Initialize default exclusions state
        _useDefaultExclusions = config.UseDefaultExclusions;
        _defaultExclusionPatterns = config.ExclusionPatterns?.ToList()
            ?? DefaultSyncExclusions.Patterns.ToList();
        _defaultExclusionPatternsText = string.Join("\n", _defaultExclusionPatterns);

        // Initialize sync paths
        _syncPaths = config.SyncPaths.ToList();

        // Initialize exclusion set
        _exclusionSet = new HashSet<string>(
            config.ExcludedPaths.Select(NormalizePath).Where(p => !string.IsNullOrWhiteSpace(p)),
            StringComparer.OrdinalIgnoreCase);

        await LoadTreeAsync();
    }

    private async Task LoadTreeAsync()
    {
        _loading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var root = new FileNode { Name = "root", IsDirectory = true, RelativePath = "" };

            foreach (var syncPath in _syncPaths)
            {
                var absolutePath = Path.Combine(ConfigService.SptRoot, syncPath.Source.Replace('/', Path.DirectorySeparatorChar));
                if (Directory.Exists(absolutePath))
                {
                    var node = BuildNodeRecursive(absolutePath, NormalizePath(syncPath.Source), syncPath.Source);
                    root.Children.Add(node);
                }
            }

            _treeRoot = root;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load files: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private FileNode BuildNodeRecursive(string fullPath, string relativePath, string? displayName = null)
    {
        var node = new FileNode
        {
            Name = displayName ?? Path.GetFileName(fullPath),
            RelativePath = relativePath,
            IsDirectory = true
        };

        try
        {
            foreach (var dir in Directory.GetDirectories(fullPath).OrderBy(d => Path.GetFileName(d)))
            {
                var childRel = NormalizePath(Path.Combine(relativePath, Path.GetFileName(dir)));
                node.Children.Add(BuildNodeRecursive(dir, childRel));
            }

            foreach (var file in Directory.GetFiles(fullPath).OrderBy(f => Path.GetFileName(f)))
            {
                var childRel = NormalizePath(Path.Combine(relativePath, Path.GetFileName(file)));
                node.Children.Add(new FileNode
                {
                    Name = Path.GetFileName(file),
                    RelativePath = childRel,
                    IsDirectory = false
                });
            }
        }
        catch (UnauthorizedAccessException) { }
        catch (Exception) { }

        return node;
    }

    private SyncNodeState GetNodeState(FileNode? node)
    {
        if (node == null) return SyncNodeState.Included;

        var rel = NormalizePath(node.RelativePath);

        if (!node.IsDirectory)
        {
            return IsExcluded(rel) ? SyncNodeState.Excluded : SyncNodeState.Included;
        }

        var leaves = GetLeafNodes(node).ToList();
        if (leaves.Count == 0) return SyncNodeState.Included;

        var leafStates = leaves
            .Select(leaf => IsExcluded(NormalizePath(leaf.RelativePath)) ? SyncNodeState.Excluded : SyncNodeState.Included)
            .Distinct()
            .ToList();

        if (leafStates.Count == 1) return leafStates[0];
        return SyncNodeState.Mixed;
    }

    private IEnumerable<FileNode> GetLeafNodes(FileNode? node)
    {
        if (node == null) yield break;
        if (!node.IsDirectory) { yield return node; yield break; }
        foreach (var child in node.Children ?? Enumerable.Empty<FileNode>())
            foreach (var leaf in GetLeafNodes(child))
                yield return leaf;
    }

    private bool IsExcluded(string relativePath)
    {
        var norm = NormalizePath(relativePath);
        return _exclusionSet.Any(ex =>
            norm.Equals(ex, StringComparison.OrdinalIgnoreCase) ||
            norm.StartsWith(ex + "/", StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnNodeClick(FileNode node)
    {
        var current = GetNodeState(node);
        var next = current == SyncNodeState.Excluded ? SyncNodeState.Included : SyncNodeState.Excluded;

        if (node.IsDirectory)
            ApplyDirectoryState(node, next);
        else
            ApplyFileState(node, next);

        await SaveExclusionsAsync();
        StateHasChanged();
    }

    private void ToggleExpand(FileNode node)
    {
        if (!node.IsDirectory) return;
        var path = node.RelativePath;
        if (_expandedDirs.Contains(path))
            _expandedDirs.Remove(path);
        else
            _expandedDirs.Add(path);
        StateHasChanged();
    }

    private void ApplyDirectoryState(FileNode? node, SyncNodeState state)
    {
        if (node == null) return;
        var rel = NormalizePath(node.RelativePath);

        foreach (var path in EnumerateAllPaths(node).ToList())
            _exclusionSet.Remove(path);

        if (state == SyncNodeState.Excluded && !string.IsNullOrEmpty(rel))
        {
            _exclusionSet.Add(rel);
        }
    }

    private void ApplyFileState(FileNode? node, SyncNodeState state)
    {
        if (node == null) return;
        var rel = NormalizePath(node.RelativePath);

        if (state == SyncNodeState.Excluded)
        {
            _exclusionSet.Add(rel);
        }
        else
        {
            _exclusionSet.Remove(rel);
        }
    }

    private IEnumerable<string> EnumerateAllPaths(FileNode? node)
    {
        if (node == null) yield break;
        if (!string.IsNullOrEmpty(node.RelativePath))
            yield return NormalizePath(node.RelativePath);
        foreach (var child in node.Children ?? Enumerable.Empty<FileNode>())
            foreach (var p in EnumerateAllPaths(child))
                yield return p;
    }

    private List<(FileNode Node, int Depth)> GetFlattenedTree()
    {
        var result = new List<(FileNode, int)>();
        if (_treeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            result.Add((node, depth));
            if (node.IsDirectory && !_expandedDirs.Contains(node.RelativePath)) return;
            foreach (var child in (node.Children ?? new List<FileNode>()).OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
                Flatten(child, depth + 1);
        }

        foreach (var child in _treeRoot.Children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
            Flatten(child, 0);

        return result;
    }

    private async Task SaveExclusionsAsync()
    {
        try
        {
            var config = CurrentConfig;
            config.ExcludedPaths = _exclusionSet
                .Select(NormalizePath)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p)
                .ToList();

            SaveCurrentConfig(config);
            await ConfigService.SaveStagedConfigAsync();
            await OnConfigChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save exclusions: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnUseDefaultExclusionsChanged(bool value)
    {
        _useDefaultExclusions = value;

        var config = CurrentConfig;
        config.UseDefaultExclusions = value;
        SaveCurrentConfig(config);

        await ConfigService.SaveStagedConfigAsync();
        await OnConfigChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnDefaultExclusionPatternsChanged(string text)
    {
        _defaultExclusionPatternsText = text;
        _defaultExclusionPatterns = text
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Trim())
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

        var config = CurrentConfig;
        config.ExclusionPatterns = _defaultExclusionPatterns.Count > 0 ? _defaultExclusionPatterns : null;
        SaveCurrentConfig(config);

        await ConfigService.SaveStagedConfigAsync();
        await OnConfigChanged.InvokeAsync();
    }

    private async Task ResetDefaultExclusionsToBuiltIn()
    {
        _defaultExclusionPatterns = DefaultSyncExclusions.Patterns.ToList();
        _defaultExclusionPatternsText = string.Join("\n", _defaultExclusionPatterns);

        var config = CurrentConfig;
        config.ExclusionPatterns = null;
        SaveCurrentConfig(config);

        await ConfigService.SaveStagedConfigAsync();
        await OnConfigChanged.InvokeAsync();
        Snackbar.Add("Reset to built-in default patterns.", Severity.Info);
        StateHasChanged();
    }

    private void OpenAddSyncPathDialog()
    {
        _editSyncPathEntry = null;
        _showAddSyncPathDialog = true;
    }

    private void OpenEditSyncPathDialog(SyncPathEntry entry)
    {
        _editSyncPathEntry = entry;
        _showAddSyncPathDialog = true;
    }

    private async Task OnSyncPathAdded(SyncPathEntry entry)
    {
        _syncPaths.Add(entry);

        var config = CurrentConfig;
        config.SyncPaths = _syncPaths.ToList();
        SaveCurrentConfig(config);

        await ConfigService.SaveStagedConfigAsync();
        await OnConfigChanged.InvokeAsync();
        await LoadTreeAsync();

        Snackbar.Add($"Added sync path: {entry.Source}", Severity.Success);
    }

    private async Task OnSyncPathEdited((SyncPathEntry OldEntry, SyncPathEntry NewEntry) args)
    {
        // Find and update the existing entry
        var index = _syncPaths.FindIndex(p => 
            NormalizePath(p.Source).Equals(NormalizePath(args.OldEntry.Source), StringComparison.OrdinalIgnoreCase));
        
        if (index >= 0)
        {
            _syncPaths[index] = args.NewEntry;
        }

        var config = CurrentConfig;
        config.SyncPaths = _syncPaths.ToList();
        
        // If source changed, update exclusions to match new source path
        var oldSourceNorm = NormalizePath(args.OldEntry.Source);
        var newSourceNorm = NormalizePath(args.NewEntry.Source);
        if (!oldSourceNorm.Equals(newSourceNorm, StringComparison.OrdinalIgnoreCase))
        {
            // Update exclusions that were under the old source path
            var updatedExclusions = new List<string>();
            foreach (var exclusion in _exclusionSet.ToList())
            {
                if (exclusion.StartsWith(oldSourceNorm + "/", StringComparison.OrdinalIgnoreCase))
                {
                    // Replace old source prefix with new source prefix
                    var newExclusion = newSourceNorm + exclusion.Substring(oldSourceNorm.Length);
                    updatedExclusions.Add(newExclusion);
                    _exclusionSet.Remove(exclusion);
                    _exclusionSet.Add(newExclusion);
                }
                else if (exclusion.Equals(oldSourceNorm, StringComparison.OrdinalIgnoreCase))
                {
                    _exclusionSet.Remove(exclusion);
                    _exclusionSet.Add(newSourceNorm);
                }
            }
            
            config.ExcludedPaths = _exclusionSet.OrderBy(p => p).ToList();
        }
        
        SaveCurrentConfig(config);

        await ConfigService.SaveStagedConfigAsync();
        await OnConfigChanged.InvokeAsync();
        await LoadTreeAsync();

        Snackbar.Add($"Updated sync path: {args.NewEntry.Source}", Severity.Success);
    }

    private async Task RemoveSyncPath(SyncPathEntry entry)
    {
        _syncPaths.Remove(entry);

        var config = CurrentConfig;
        config.SyncPaths = _syncPaths.ToList();

        // Clean up orphaned exclusions that were under this sync path
        var normalizedSource = NormalizePath(entry.Source);

        // Remove directly from _exclusionSet (the UI state)
        var orphanedFromSet = _exclusionSet
            .Where(p => p.StartsWith(normalizedSource + "/", StringComparison.OrdinalIgnoreCase) ||
                        p.Equals(normalizedSource, StringComparison.OrdinalIgnoreCase))
            .ToList();

        foreach (var orphan in orphanedFromSet)
        {
            _exclusionSet.Remove(orphan);
        }

        // Also clean up config.ExcludedPaths
        var orphanCount = config.ExcludedPaths.RemoveAll(p =>
            NormalizePath(p).StartsWith(normalizedSource + "/", StringComparison.OrdinalIgnoreCase) ||
            NormalizePath(p).Equals(normalizedSource, StringComparison.OrdinalIgnoreCase));

        SaveCurrentConfig(config);

        await ConfigService.SaveStagedConfigAsync();
        await OnConfigChanged.InvokeAsync();
        await LoadTreeAsync();

        var message = orphanCount > 0
            ? $"Removed sync path: {entry.Source} (cleaned up {orphanCount} exclusion(s))"
            : $"Removed sync path: {entry.Source}";
        Snackbar.Add(message, Severity.Info);
    }

    /// <summary>
    /// Save the config back to the appropriate property based on active profile
    /// </summary>
    private void SaveCurrentConfig(ClientSyncConfig config)
    {
        if (_activeProfile == SyncProfile.Player)
        {
            ConfigService.StagedConfig.PlayerSyncConfig = config;
        }
        else
        {
            ConfigService.StagedConfig.HeadlessSyncConfig = config;
        }
    }

    private static string NormalizePath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return string.Empty;
        return path.Replace("\\", "/").TrimStart('/');
    }
}
