@using ModGod.Models
@using ModGod.Services
@using MudBlazor
@using System.Text.Json

<MudPaper Class="pa-4 mb-4" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px;">
    <div class="d-flex justify-space-between align-center mb-3">
        <div>
            <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-2" Style="vertical-align: middle;" />
                Mod Health Check
            </MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Scans all installed mods for dependencies, updates, and compatibility issues using the Forge API.
            </MudText>
        </div>
        <div class="d-flex gap-2">
            @if (_result != null && GetUpdatableMods().Count > 0)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Style="font-weight: 600;"
                           StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                           Disabled="_isChecking || _isBulkUpdating"
                           OnClick="OpenBulkUpdateDialog">
                    Bulk Update (@GetUpdatableMods().Count)
                </MudButton>
            }
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Style="background: var(--accent-cyan); color: #000; font-weight: 600;"
                       StartIcon="@(_isChecking ? null : Icons.Material.Filled.Refresh)"
                       Disabled="_isChecking || !HasApiKey"
                       OnClick="RunHealthCheckAsync">
                @if (_isChecking)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Scanning...</span>
                }
                else
                {
                    <span>Check Mod Health</span>
                }
            </MudButton>
        </div>
    </div>

    @if (!HasApiKey)
    {
        <ForgeApiKeyInput OnApiKeyChanged="OnApiKeyChanged" />
    }
    else if (_result != null)
    {
        <!-- SPT Version Info -->
        <MudPaper Class="pa-3 mb-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); border-radius: 8px;">
            <div class="d-flex justify-space-between align-center">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Memory" Style="color: var(--accent-cyan);" />
                    <MudText Typo="Typo.body1" Style="color: var(--text-primary);">
                        <strong>SPT Version:</strong> @(_result.SptVersion ?? "Unknown")
                    </MudText>
                </div>
                @if (_result.SptUpdateAvailable)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.NewReleases" Size="Size.Small" Class="mr-1" />
                        Update available: @_result.LatestSptVersion
                    </MudChip>
                }
                else if (!string.IsNullOrEmpty(_result.LatestSptVersion))
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                        Up to date
                    </MudChip>
                }
            </div>
        </MudPaper>

        <!-- Stats Summary -->
        <div class="d-flex gap-3 mb-4 flex-wrap">
            <MudPaper Class="pa-3 flex-grow-1" Style="@GetStatCardStyle("total")">
                <MudText Typo="Typo.h4" Style="color: var(--text-primary);">@_result.TotalMods</MudText>
                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">Total Mods</MudText>
            </MudPaper>
            <MudPaper Class="pa-3 flex-grow-1 cursor-pointer" Style="@GetStatCardStyle("uptodate")" @onclick="@(() => SetFilter("uptodate"))">
                <MudText Typo="Typo.h4" Style="color: var(--accent-green);">@_result.UpToDateCount</MudText>
                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">Up to Date</MudText>
            </MudPaper>
            <MudPaper Class="pa-3 flex-grow-1 cursor-pointer" Style="@GetStatCardStyle("updates")" @onclick="@(() => SetFilter("updates"))">
                <MudText Typo="Typo.h4" Style="color: var(--accent-orange);">@_result.UpdatesAvailableCount</MudText>
                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">Updates Available</MudText>
            </MudPaper>
            @if (_result.DependencyIssuesCount > 0)
            {
                <MudPaper Class="pa-3 flex-grow-1 cursor-pointer" Style="@GetStatCardStyle("deps")" @onclick="@(() => SetFilter("deps"))">
                    <MudText Typo="Typo.h4" Style="color: var(--accent-red);">@_result.DependencyIssuesCount</MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">Dep Issues</MudText>
                </MudPaper>
            }
            <MudPaper Class="pa-3 flex-grow-1 cursor-pointer" Style="@GetStatCardStyle("untracked")" @onclick="@(() => SetFilter("untracked"))">
                <MudText Typo="Typo.h4" Style="color: var(--accent-purple);">@_result.UntrackedCount</MudText>
                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">Untracked</MudText>
            </MudPaper>
            <MudPaper Class="@GetAddonsCardClass()" 
                      Style="@GetStatCardStyle("addons")" 
                      @onclick="@(() => { if (_result.TotalAddonsCount > 0) SetFilter("addons"); })">
                @if (_addonsLoading)
                {
                    <div class="d-flex align-center justify-center" style="height: 36px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="color: var(--accent-cyan);" />
                    </div>
                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">Checking Addons...</MudText>
                }
                else
                {
                    var uninstalled = _result.UninstalledAddonsCount;
                    var total = _result.TotalAddonsCount;
                    <MudText Typo="Typo.h4" Style="@(uninstalled > 0 ? "color: var(--accent-cyan);" : "color: var(--accent-green);")">
                        @(uninstalled > 0 ? uninstalled : total)
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                        @if (total == 0)
                        {
                            @("No Addons")
                        }
                        else if (uninstalled > 0)
                        {
                            @($"Addons Available")
                        }
                        else
                        {
                            @("All Addons Installed")
                        }
                    </MudText>
                }
            </MudPaper>
        </div>

        @if (!string.IsNullOrEmpty(_result.Error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_result.Error</MudAlert>
        }

        <!-- Filter bar -->
        @if (_activeFilter != null)
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudChip T="string" Color="Color.Primary" OnClose="ClearFilter" CloseIcon="@Icons.Material.Filled.Close">
                    Filter: @GetFilterLabel(_activeFilter)
                </MudChip>
            </div>
        }

        <!-- Mod List -->
        @if (_result.Mods.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No mods found. Make sure you have mods installed in BepInEx/plugins or SPT/user/mods.</MudAlert>
        }
        else
        {
            var filteredMods = GetFilteredMods();
            
            @if (filteredMods.Count == 0)
            {
                <MudAlert Severity="Severity.Info">No mods match the current filter.</MudAlert>
            }
            else
            {
                <MudTable Items="@filteredMods" 
                          Dense="true" 
                          Hover="true"
                          Striped="true"
                          Style="background: var(--secondary-bg);">
                    <HeaderContent>
                        <MudTh>Mod Name</MudTh>
                        <MudTh>Installed</MudTh>
                        <MudTh>Latest</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="width: 100px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Mod Name">
                            <div class="d-flex align-center gap-2">
                                @if (!string.IsNullOrEmpty(context.ForgeUrl))
                                {
                                    <MudLink Href="@context.ForgeUrl" Target="_blank" Style="color: var(--text-primary); font-weight: 500;">
                                        @context.DisplayName
                                    </MudLink>
                                }
                                else
                                {
                                    <MudText Style="color: var(--text-primary); font-weight: 500;">@context.DisplayName</MudText>
                                }
                                @if (!context.IsTracked)
                                {
                                    <MudTooltip Text="This mod is not tracked by ModGod. It may have been installed manually, or before ModGod was set up, or on an older version of ModGod.">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: var(--accent-purple); border-color: var(--accent-purple);">
                                            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Class="mr-1" />
                                            Untracked
                                        </MudChip>
                                    </MudTooltip>
                                }
                                else if (context.TrackedMod?.Optional == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Style="color: var(--text-secondary);">Optional</MudChip>
                                }
                                @if (context.HasDependencyIssues)
                                {
                                    <MudTooltip Text="@GetDependencyTooltip(context)">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="background: var(--accent-red); color: #fff; cursor: pointer;" OnClick="@(() => ShowDependencyDialog(context))">
                                            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Class="mr-1" />
                                            @(context.MissingDependencyCount > 0 ? $"{context.MissingDependencyCount} missing" : $"{context.VersionMismatchCount} mismatch")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (context.HasAddons)
                                {
                                    var installedCount = context.AvailableAddons.Count(a => a.IsInstalled);
                                    var uninstalledCount = context.UninstalledAddonsCount;
                                    var addonTooltip = installedCount > 0 
                                        ? $"{installedCount} installed, {uninstalledCount} available - click to view"
                                        : $"{context.AvailableAddons.Count} addon(s) available - click to view";
                                    var chipStyle = uninstalledCount > 0 
                                        ? "color: var(--accent-cyan); border-color: var(--accent-cyan); cursor: pointer;"
                                        : "color: var(--accent-green); border-color: var(--accent-green); cursor: pointer;";
                                    
                                    <MudTooltip Text="@addonTooltip">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                 Style="@chipStyle" 
                                                 OnClick="@(() => ShowAddonsDialog(context))">
                                            <MudIcon Icon="@(uninstalledCount > 0 ? Icons.Material.Filled.Extension : Icons.Material.Filled.CheckCircle)" Size="Size.Small" Class="mr-1" />
                                            @if (uninstalledCount > 0)
                                            {
                                                @($"{uninstalledCount} Addon{(uninstalledCount > 1 ? "s" : "")}")
                                            }
                                            else
                                            {
                                                @("All Addons Installed")
                                            }
                                        </MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Installed">
                            <code style="color: var(--text-secondary);">@(context.InstalledVersion ?? "?")</code>
                        </MudTd>
                        <MudTd DataLabel="Latest">
                            @if (!string.IsNullOrEmpty(context.LatestVersion))
                            {
                                <code style="@GetVersionStyle(context)">@context.LatestVersion</code>
                            }
                            else
                            {
                                <span style="color: var(--text-secondary);">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Status">
                            @switch (context.Status)
                            {
                                case ModHealthStatus.UpToDate:
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                        Up to date
                                    </MudChip>
                                    break;
                            case ModHealthStatus.UpdateAvailable:
                                    @if (_updatingMod == context.DisplayName)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width: 16px; height: 16px;" />
                                            Updating...
                                        </MudChip>
                                    }
                                    else if (!string.IsNullOrEmpty(context.LatestDownloadUrl))
                                    {
                                        <MudTooltip Text="Click to download and stage the latest version">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" 
                                                     Style="cursor: pointer;" OnClick="@(() => ShowUpdateConfirmDialog(context))">
                                                <MudIcon Icon="@Icons.Material.Filled.Upgrade" Size="Size.Small" Class="mr-1" />
                                                Update to @context.LatestVersion
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Update available but no download link - visit Forge to update manually">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                                <MudIcon Icon="@Icons.Material.Filled.NewReleases" Size="Size.Small" Class="mr-1" />
                                                Update Available
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    break;
                                case ModHealthStatus.NewerThanForge:
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                                        <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" Class="mr-1" />
                                        Dev/Beta
                                    </MudChip>
                                    break;
                                case ModHealthStatus.NotOnForge:
                                    <MudTooltip Text="This mod was not found on Forge">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Class="mr-1" />
                                            Not found on Forge
                                        </MudChip>
                                    </MudTooltip>
                                    break;
                                case ModHealthStatus.Incompatible:
                                    <MudTooltip Text="@(context.ErrorMessage ?? "Incompatible with current SPT version")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Class="mr-1" />
                                            Incompatible
                                        </MudChip>
                                    </MudTooltip>
                                    break;
                                case ModHealthStatus.Error:
                                    <MudTooltip Text="@(context.ErrorMessage ?? "Error checking this mod")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                            Error
                                        </MudChip>
                                    </MudTooltip>
                                    break;
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            @if (context.HasDependencyIssues)
                            {
                                <MudTooltip Text="View dependency details">
                                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => ShowDependencyDialog(context))" />
                                </MudTooltip>
                            }
                            @if (!string.IsNullOrEmpty(context.ForgeUrl))
                            {
                                <MudTooltip Text="View on Forge">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                   Size="Size.Small"
                                                   Href="@context.ForgeUrl"
                                                   Target="_blank" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }

        <!-- Last checked timestamp -->
        <MudText Typo="Typo.caption" Class="mt-3" Style="color: var(--text-secondary);">
            Last checked: @_result.CheckedAt.ToLocalTime().ToString("g")
        </MudText>
        
        <!-- Version info note -->
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" Style="font-size: 0.85rem;">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
            Version numbers are read from mod metadata (DLL attributes). If a mod author doesn't update their version number in the code, the "Installed" version shown here may not match the actual release version.
        </MudAlert>
    }
    else if (!_isChecking)
    {
        <MudAlert Severity="Severity.Info">
            Click "Check for Updates" to scan your installed mods for updates and compatibility issues.
        </MudAlert>
    }
</MudPaper>

<!-- Dependency Dialog -->
<MudDialog @bind-Visible="_showDependencyDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
            <MudText Typo="Typo.h6">Dependencies: @(_selectedMod?.DisplayName ?? "Unknown")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedMod != null && _selectedMod.Dependencies.Count > 0)
        {
            <MudList T="DependencyInfo" Dense="true">
                @foreach (var dep in _selectedMod.Dependencies)
                {
                    <MudListItem>
                        <div class="d-flex justify-space-between align-center" style="width: 100%;">
                            <div class="d-flex align-center gap-2">
                                @switch (dep.Status)
                                {
                                    case DependencyStatus.Satisfied:
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        break;
                                    case DependencyStatus.Missing:
                                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                        break;
                                    case DependencyStatus.VersionMismatch:
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                        break;
                                    default:
                                        <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Size="Size.Small" />
                                        break;
                                }
                                <div>
                                    @if (!string.IsNullOrEmpty(dep.ForgeUrl))
                                    {
                                        <MudLink Href="@dep.ForgeUrl" Target="_blank" Style="color: var(--text-primary); font-weight: 500;">
                                            @dep.Name
                                        </MudLink>
                                    }
                                    else
                                    {
                                        <MudText Style="color: var(--text-primary); font-weight: 500;">@dep.Name</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                                        @GetDependencyStatusText(dep)
                                    </MudText>
                                </div>
                            </div>
                            <div class="d-flex align-center gap-1">
                                @if (dep.Status == DependencyStatus.Missing && !string.IsNullOrEmpty(dep.DownloadLink))
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@(_isDownloading && _downloadingItem == dep.Name ? null : Icons.Material.Filled.Download)"
                                               Disabled="_isDownloading"
                                               OnClick="@(() => DownloadAndStageDependency(dep))">
                                        @if (_isDownloading && _downloadingItem == dep.Name)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                        }
                                        Install @(dep.LatestVersion ?? "")
                                    </MudButton>
                                }
                                else if (dep.Status == DependencyStatus.VersionMismatch && !string.IsNullOrEmpty(dep.DownloadLink))
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               StartIcon="@(_isDownloading && _downloadingItem == dep.Name ? null : Icons.Material.Filled.Upgrade)"
                                               Disabled="_isDownloading"
                                               OnClick="@(() => DownloadAndStageDependency(dep))">
                                        @if (_isDownloading && _downloadingItem == dep.Name)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                        }
                                        Update to @(dep.LatestVersion ?? "latest")
                                    </MudButton>
                                }
                                @if (!string.IsNullOrEmpty(dep.ForgeUrl))
                                {
                                    <MudTooltip Text="View on Forge">
                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                       Size="Size.Small"
                                                       Href="@dep.ForgeUrl"
                                                       Target="_blank" />
                                    </MudTooltip>
                                }
                            </div>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
        else
        {
            <MudText>No dependencies found.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDependencyDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- Addons Dialog -->
<MudDialog @bind-Visible="_showAddonsDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Extension" Style="color: var(--accent-cyan);" />
            <MudText Typo="Typo.h6">Addons: @(_selectedModForAddons?.DisplayName ?? "Unknown")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedModForAddons != null && _selectedModForAddons.AvailableAddons.Count > 0)
        {
            <MudList T="AddonInfo" Dense="true">
                @foreach (var addon in _selectedModForAddons.AvailableAddons)
                {
                    <MudListItem>
                        <div class="d-flex justify-space-between align-center" style="width: 100%;">
                            <div class="d-flex align-center gap-2">
                                @if (addon.IsInstalled)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Extension" Style="color: var(--accent-cyan);" Size="Size.Small" />
                                }
                                <div>
                                    <MudLink Href="@addon.ForgeUrl" Target="_blank" Style="color: var(--text-primary); font-weight: 500;">
                                        @addon.Name
                                    </MudLink>
                                    @if (!string.IsNullOrEmpty(addon.Author))
                                    {
                                        <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                                            by @addon.Author
                                        </MudText>
                                    }
                                    @if (!string.IsNullOrEmpty(addon.Teaser))
                                    {
                                        <MudText Typo="Typo.body2" Style="color: var(--text-secondary); font-size: 0.85rem;">
                                            @addon.Teaser
                                        </MudText>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-center gap-1">
                                @if (addon.IsInstalled)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                        Installed
                                    </MudChip>
                                }
                                else if (!string.IsNullOrEmpty(addon.DownloadUrl))
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Style="background: var(--accent-cyan); color: #000;"
                                               StartIcon="@(_installingAddon == addon.Name ? null : Icons.Material.Filled.Download)"
                                               Disabled="_installingAddon != null"
                                               OnClick="@(() => InstallAddonAsync(addon))">
                                        @if (_installingAddon == addon.Name)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width: 16px; height: 16px;" />
                                            <span>Installing...</span>
                                        }
                                        else
                                        {
                                            <span>Install v@(addon.LatestCompatibleVersion)</span>
                                        }
                                    </MudButton>
                                }
                                <MudTooltip Text="View on Forge">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                   Size="Size.Small"
                                                   Href="@addon.ForgeUrl"
                                                   Target="_blank" />
                                </MudTooltip>
                            </div>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
        else
        {
            <MudText>No addons found for this mod.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAddonsDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- Update Confirmation Dialog -->
<MudDialog @bind-Visible="_showUpdateConfirmDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Small }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Upgrade" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Update Mod?</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_modToUpdate != null)
        {
            <MudText Class="mb-3">
                Update <strong>@_modToUpdate.DisplayName</strong> from v@(_modToUpdate.InstalledVersion) to v@(_modToUpdate.LatestVersion)?
            </MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                The new version will be downloaded and staged. You'll need to click "Apply Changes" to complete the installation.
            </MudAlert>
            @if (_modToUpdate.IsTracked)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The current version will be marked for removal. Any custom configuration files may be overwritten unless you edit the file rules after staging.
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelUpdate" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="ConfirmUpdate" Color="Color.Warning" Variant="Variant.Filled">
            <MudIcon Icon="@Icons.Material.Filled.Upgrade" Class="mr-1" />
            Update
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Bulk Update Dialog -->
<MudDialog @bind-Visible="_showBulkUpdateDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = !_isBulkUpdating, BackdropClick = !_isBulkUpdating }">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">
            @if (_bulkUpdateStep == BulkUpdateStep.Select)
            {
                <span>Bulk Update Mods</span>
            }
            else if (_bulkUpdateStep == BulkUpdateStep.Updating)
            {
                <span>Updating Mods...</span>
            }
            else
            {
                <span>Update Complete</span>
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_bulkUpdateStep == BulkUpdateStep.Select)
        {
            <div class="pa-2">
                <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--text-secondary);">
                    Select which mods you want to update. All mods with available updates are checked by default.
                </MudText>
                
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudButton Variant="Variant.Text" 
                               Size="Size.Small" 
                               OnClick="ToggleAllBulkUpdateSelection"
                               StartIcon="@(_bulkUpdateSelection.All(kv => kv.Value) ? Icons.Material.Filled.CheckBoxOutlineBlank : Icons.Material.Filled.CheckBox)">
                        @(_bulkUpdateSelection.All(kv => kv.Value) ? "Deselect All" : "Select All")
                    </MudButton>
                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                        @_bulkUpdateSelection.Count(kv => kv.Value) of @_bulkUpdateSelection.Count selected
                    </MudText>
                </div>
                
                <MudList T="string" Dense="true" Style="max-height: 400px; overflow-y: auto;">
                    @foreach (var mod in GetUpdatableMods())
                    {
                        <MudListItem T="string" @onclick="@(() => ToggleBulkUpdateSelection(mod))">
                            <div class="d-flex align-center gap-3" style="width: 100%;">
                                <MudCheckBox T="bool" 
                                             Value="@(_bulkUpdateSelection.GetValueOrDefault(mod.DisplayName, true))"
                                             ValueChanged="@((bool val) => SetBulkUpdateSelection(mod, val))"
                                             Color="Color.Warning"
                                             @onclick:stopPropagation="true" />
                                <div style="flex: 1;">
                                    <MudText Style="color: var(--text-primary); font-weight: 500;">@mod.DisplayName</MudText>
                                    <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                                        <code>@mod.InstalledVersion</code> → <code style="color: var(--accent-orange);">@mod.LatestVersion</code>
                                    </MudText>
                                </div>
                                @if (!mod.IsTracked)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: var(--accent-purple); border-color: var(--accent-purple);">
                                        Untracked
                                    </MudChip>
                                }
                            </div>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>
                
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Updated mods will be staged. You'll need to click "Apply Changes" to complete the installation.
                </MudAlert>
            </div>
        }
        else if (_bulkUpdateStep == BulkUpdateStep.Updating)
        {
            <div class="pa-4">
                <MudText Typo="Typo.body1" Class="mb-2" Style="color: var(--text-primary);">
                    Updating @(_bulkUpdateCurrentIndex + 1) of @_bulkUpdateTotalCount
                </MudText>
                <MudProgressLinear Value="@((_bulkUpdateCurrentIndex + 1) * 100.0 / _bulkUpdateTotalCount)" 
                                   Color="Color.Warning" 
                                   Rounded="true" 
                                   Size="Size.Large"
                                   Class="mb-4" />
                
                <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--text-primary); font-weight: 500;">
                    @(_bulkUpdateCurrentMod ?? "Starting...")
                </MudText>
                
                @if (_bulkUpdateResults.Count > 0)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--text-secondary);">
                        Status: @_bulkUpdateResults.Count(r => r.Success) succeeded, @_bulkUpdateResults.Count(r => !r.Success) failed
                    </MudText>
                }
            </div>
        }
        else if (_bulkUpdateStep == BulkUpdateStep.Results)
        {
            <div class="pa-2">
                @{
                    var successes = _bulkUpdateResults.Where(r => r.Success).ToList();
                    var failures = _bulkUpdateResults.Where(r => !r.Success).ToList();
                }
                
                @if (failures.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        Failed to update @failures.Count mod(s)
                    </MudAlert>
                    
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--accent-red);">
                        Failed (@failures.Count)
                    </MudText>
                    <MudList T="string" Dense="true" Class="mb-4">
                        @foreach (var result in failures)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Error" IconColor="Color.Error">
                                <MudText Style="color: var(--text-primary);">@result.ModName</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--accent-red);">
                                    @result.Error
                                </MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
                
                @if (successes.Count > 0)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">
                        Successfully staged @successes.Count mod(s) for update
                    </MudAlert>
                    
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--accent-green);">
                        Updated (@successes.Count)
                    </MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var result in successes)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                                <MudText Style="color: var(--text-primary);">@result.ModName</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                                    Updated to @result.NewVersion
                                </MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_bulkUpdateStep == BulkUpdateStep.Select)
        {
            <MudButton OnClick="CloseBulkUpdateDialog" Variant="Variant.Text">Cancel</MudButton>
            <MudButton Color="Color.Warning" 
                       Variant="Variant.Filled"
                       Disabled="@(!_bulkUpdateSelection.Any(kv => kv.Value))"
                       OnClick="StartBulkUpdate">
                <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Class="mr-1" />
                Update @_bulkUpdateSelection.Count(kv => kv.Value) Mod(s)
            </MudButton>
        }
        else if (_bulkUpdateStep == BulkUpdateStep.Updating)
        {
            <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                Please wait...
            </MudText>
        }
        else if (_bulkUpdateStep == BulkUpdateStep.Results)
        {
            <MudButton Color="Color.Primary" 
                       Variant="Variant.Filled"
                       OnClick="CloseBulkUpdateDialog">
                Done
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ModHealthService HealthService { get; set; } = default!;
    [Inject] private ForgeService ForgeService { get; set; } = default!;
    [Inject] private ModDownloadService ModDownloadService { get; set; } = default!;
    [Inject] private ConfigService ConfigService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    /// <summary>
    /// Called when mods are staged (e.g., dependency installed) - use to refresh parent UI
    /// </summary>
    [Parameter] public EventCallback OnModsStaged { get; set; }

    private bool _isChecking = false;
    private HealthCheckResult? _result;
    private string? _activeFilter = null;
    private bool _showDependencyDialog = false;
    private ModHealthInfo? _selectedMod;
    
    // Download state
    private bool _isDownloading = false;
    private string? _downloadingItem = null;
    
    // Update state
    private string? _updatingMod = null;
    
    // Addon loading state
    private bool _addonsLoading = false;
    
    // Addon dialog state
    private bool _showAddonsDialog = false;
    private ModHealthInfo? _selectedModForAddons;
    private string? _installingAddon = null;
    
    // Update confirmation dialog state
    private bool _showUpdateConfirmDialog = false;
    private ModHealthInfo? _modToUpdate;

    // Bulk update dialog state
    private bool _showBulkUpdateDialog = false;
    private bool _isBulkUpdating = false;
    private Dictionary<string, bool> _bulkUpdateSelection = new();
    private BulkUpdateStep _bulkUpdateStep = BulkUpdateStep.Select;
    private int _bulkUpdateCurrentIndex = 0;
    private int _bulkUpdateTotalCount = 0;
    private string? _bulkUpdateCurrentMod;
    private List<BulkUpdateResult> _bulkUpdateResults = new();

    private enum BulkUpdateStep { Select, Updating, Results }
    
    private class BulkUpdateResult
    {
        public string ModName { get; set; } = "";
        public string? NewVersion { get; set; }
        public bool Success { get; set; }
        public string? Error { get; set; }
    }

    private bool HasApiKey => ForgeService.HasApiKey;

    private void OnApiKeyChanged()
    {
        // Refresh state when API key is added/removed
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        // Load cached result so switching tabs doesn't lose the health check
        _result = HealthService.GetCachedResult();
    }

    private async Task RunHealthCheckAsync()
    {
        _isChecking = true;
        _activeFilter = null;
        StateHasChanged();

        try
        {
            _result = await HealthService.RunHealthCheckAsync(forceRefresh: true);
            
            if (!_result.Success)
            {
                Snackbar.Add(_result.Error ?? "Health check failed", Severity.Error);
            }
            else
            {
                // Check for addons (runs in parallel with UI update)
                _ = CheckAddonsInBackgroundAsync();
                
                if (_result.DependencyIssuesCount > 0)
                {
                    Snackbar.Add($"Found {_result.DependencyIssuesCount} mod(s) with dependency issues!", Severity.Warning);
                }
                else if (_result.UpdatesAvailableCount > 0)
                {
                    Snackbar.Add($"Found {_result.UpdatesAvailableCount} mod(s) with updates available!", Severity.Info);
                }
                else
                {
                    Snackbar.Add("All mods are up to date!", Severity.Success);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isChecking = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Checks for addons in the background without blocking the UI
    /// </summary>
    private async Task CheckAddonsInBackgroundAsync()
    {
        if (_result == null) return;
        
        _addonsLoading = true;
        await InvokeAsync(StateHasChanged);
        
        try
        {
            await HealthService.CheckAddonsAsync(
                _result.Mods, 
                scannedMods: null, // Will be populated from cached data in service
                sptVersion: _result.SptVersion,
                onlyCompatibleWithSpt: true);
            
            // Update UI with results
            if (_result.TotalAddonsCount > 0)
            {
                Snackbar.Add($"Found {_result.TotalAddonsCount} addon(s) available for your mods", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            // Silently fail addon check - it's not critical
            System.Diagnostics.Debug.WriteLine($"Addon check failed: {ex.Message}");
        }
        finally
        {
            _addonsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetFilter(string filter)
    {
        _activeFilter = _activeFilter == filter ? null : filter;
    }

    private void ClearFilter()
    {
        _activeFilter = null;
    }

    private string GetFilterLabel(string? filter) => filter switch
    {
        "uptodate" => "Up to Date",
        "updates" => "Updates Available",
        "untracked" => "Untracked",
        "deps" => "Dependency Issues",
        "addons" => "Has Addons",
        "issues" => "Issues",
        _ => filter ?? ""
    };

    private List<ModHealthInfo> GetFilteredMods()
    {
        if (_result == null) return [];

        var mods = _result.Mods.AsEnumerable();

        mods = _activeFilter switch
        {
            "uptodate" => mods.Where(m => m.Status == ModHealthStatus.UpToDate),
            "updates" => mods.Where(m => m.Status == ModHealthStatus.UpdateAvailable || m.Status == ModHealthStatus.NewerThanForge),
            "untracked" => mods.Where(m => !m.IsTracked),
            "deps" => mods.Where(m => m.HasDependencyIssues),
            "addons" => mods.Where(m => m.HasAddons),
            "issues" => mods.Where(m => m.Status == ModHealthStatus.Incompatible || m.Status == ModHealthStatus.NotOnForge || m.Status == ModHealthStatus.Error),
            _ => mods
        };

        // Sort alphabetically by name
        return mods
            .OrderBy(m => m.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string GetStatCardStyle(string type)
    {
        var baseStyle = "background: var(--secondary-bg); border: 1px solid var(--border-color); border-radius: 8px; min-width: 100px; text-align: center;";
        
        if (_activeFilter == type)
        {
            baseStyle += " border-color: var(--accent-cyan); box-shadow: 0 0 0 1px var(--accent-cyan);";
        }
        
        return baseStyle;
    }

    private string GetAddonsCardClass()
    {
        var classes = "pa-3 flex-grow-1";
        if (_result?.TotalAddonsCount > 0)
        {
            classes += " cursor-pointer";
        }
        return classes;
    }

    private string GetVersionStyle(ModHealthInfo info)
    {
        return info.Status switch
        {
            ModHealthStatus.UpToDate => "color: var(--accent-green);",
            ModHealthStatus.UpdateAvailable => "color: var(--accent-orange); font-weight: 600;",
            ModHealthStatus.NewerThanForge => "color: var(--accent-cyan);",
            _ => "color: var(--text-secondary);"
        };
    }

    private string GetDependencyTooltip(ModHealthInfo info)
    {
        var missing = info.Dependencies.Where(d => d.Status == DependencyStatus.Missing).ToList();
        var mismatch = info.Dependencies.Where(d => d.Status == DependencyStatus.VersionMismatch).ToList();
        
        var parts = new List<string>();
        if (missing.Count > 0)
            parts.Add($"Missing: {string.Join(", ", missing.Select(d => d.Name))}");
        if (mismatch.Count > 0)
            parts.Add($"Version mismatch: {string.Join(", ", mismatch.Select(d => d.Name))}");
        
        return string.Join(" | ", parts);
    }

    private string GetDependencyStatusText(DependencyInfo dep)
    {
        return dep.Status switch
        {
            DependencyStatus.Satisfied => $"Installed: {dep.InstalledVersion ?? "unknown"}",
            DependencyStatus.Missing => $"Required: {dep.VersionConstraint ?? "any"} — Not installed",
            DependencyStatus.VersionMismatch => $"Required: {dep.VersionConstraint} — Installed: {dep.InstalledVersion}",
            _ => "Unknown status"
        };
    }

    private void ShowDependencyDialog(ModHealthInfo mod)
    {
        _selectedMod = mod;
        _showDependencyDialog = true;
    }

    private void CloseDependencyDialog()
    {
        _showDependencyDialog = false;
        _selectedMod = null;
    }

    private void ShowAddonsDialog(ModHealthInfo mod)
    {
        _selectedModForAddons = mod;
        _showAddonsDialog = true;
    }

    private void CloseAddonsDialog()
    {
        _showAddonsDialog = false;
        _selectedModForAddons = null;
    }

    /// <summary>
    /// Installs an addon by downloading and staging it as a separate mod
    /// </summary>
    private async Task InstallAddonAsync(AddonInfo addon)
    {
        if (string.IsNullOrEmpty(addon.DownloadUrl))
        {
            Snackbar.Add($"Cannot install {addon.Name}: no download URL available", Severity.Error);
            return;
        }

        _installingAddon = addon.Name;
        StateHasChanged();

        try
        {
            var (success, error) = await ModDownloadService.DownloadAndStageAsync(addon.DownloadUrl, addon.Name);

            if (success)
            {
                // Mark as installed in the UI (note: this is a heuristic until next health check)
                addon.IsInstalled = true;
                
                Snackbar.Add($"✓ {addon.Name} downloaded and staged! Review in 'Staged Mods' and click 'Apply Changes'.", Severity.Success);
                await OnModsStaged.InvokeAsync();
            }
            else
            {
                Snackbar.Add($"Failed to install {addon.Name}: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error installing {addon.Name}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _installingAddon = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Downloads and stages a dependency using the API-provided download link
    /// </summary>
    private async Task DownloadAndStageDependency(DependencyInfo dep)
    {
        // Use the download link from the API response (latest_compatible_version.link)
        if (string.IsNullOrEmpty(dep.DownloadLink))
        {
            Snackbar.Add($"Cannot download {dep.Name}: no download link available", Severity.Error);
            return;
        }

        await DownloadAndStageModAsync(dep.DownloadLink, dep.Name);
    }

    /// <summary>
    /// Core download and stage logic - delegates to ModDownloadService
    /// </summary>
    private async Task DownloadAndStageModAsync(string downloadUrl, string modName)
    {
        _isDownloading = true;
        _downloadingItem = modName;
        StateHasChanged();

        try
        {
            var (success, error) = await ModDownloadService.DownloadAndStageAsync(downloadUrl, modName);

            if (success)
            {
                Snackbar.Add($"✓ {modName} downloaded and staged! Go to 'Staged Mods' to review.", Severity.Success);
                // Notify parent to refresh UI (e.g., show "Apply Changes" button)
                await OnModsStaged.InvokeAsync();
            }
            else
            {
                Snackbar.Add($"Failed to download {modName}: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error downloading {modName}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDownloading = false;
            _downloadingItem = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Updates a mod by removing the old tracked version and downloading the latest.
    /// Uses detected paths from the new archive (does not preserve old paths).
    /// </summary>
    private async Task UpdateModAsync(ModHealthInfo mod)
    {
        if (string.IsNullOrEmpty(mod.LatestDownloadUrl))
        {
            Snackbar.Add($"Cannot update {mod.DisplayName}: no download URL available", Severity.Error);
            return;
        }

        _updatingMod = mod.DisplayName;
        StateHasChanged();

        try
        {
            // If mod is tracked, remove it from staged config so it gets uninstalled
            if (mod.TrackedMod != null)
            {
                var existingMod = ConfigService.StagedConfig.ModList
                    .FirstOrDefault(m => m.DownloadUrl == mod.TrackedMod.DownloadUrl);
                
                if (existingMod != null)
                {
                    ConfigService.StagedConfig.ModList.Remove(existingMod);
                    // Also clear any staging data for the old URL
                    ConfigService.ClearStagingForUrl(existingMod.DownloadUrl);
                }
            }

            // Download and stage the new version
            var (success, error) = await ModDownloadService.DownloadAndStageAsync(
                mod.LatestDownloadUrl, 
                mod.DisplayName);

            if (success)
            {
                // Save the staged config with the old mod removed and new mod added
                await ConfigService.SaveStagedConfigAsync();
                
                // Update the UI state to show update is staged
                mod.InstalledVersion = $"{mod.InstalledVersion} → {mod.LatestVersion}";
                mod.Status = ModHealthStatus.UpToDate; // Mark as "handled" so button disappears
                mod.LatestDownloadUrl = null; // Clear download URL to prevent re-clicking
                
                Snackbar.Add($"✓ {mod.DisplayName} updated to v{mod.LatestVersion}! Review in 'Staged Mods' and click 'Apply Changes'.", Severity.Success);
                
                // Notify parent to refresh UI
                await OnModsStaged.InvokeAsync();
            }
            else
            {
                // Rollback: re-add the old mod if we removed it
                if (mod.TrackedMod != null && !ConfigService.StagedConfig.ModList.Any(m => m.DownloadUrl == mod.TrackedMod.DownloadUrl))
                {
                    ConfigService.StagedConfig.ModList.Add(mod.TrackedMod);
                }
                Snackbar.Add($"Failed to update {mod.DisplayName}: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating {mod.DisplayName}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _updatingMod = null;
            StateHasChanged();
        }
    }

    private void ShowUpdateConfirmDialog(ModHealthInfo mod)
    {
        _modToUpdate = mod;
        _showUpdateConfirmDialog = true;
    }

    private void CancelUpdate()
    {
        _showUpdateConfirmDialog = false;
        _modToUpdate = null;
    }

    private async Task ConfirmUpdate()
    {
        _showUpdateConfirmDialog = false;
        if (_modToUpdate != null)
        {
            await UpdateModAsync(_modToUpdate);
        }
        _modToUpdate = null;
    }

    // Bulk Update Methods
    private List<ModHealthInfo> GetUpdatableMods()
    {
        if (_result == null) return new List<ModHealthInfo>();
        
        return _result.Mods
            .Where(m => m.Status == ModHealthStatus.UpdateAvailable && !string.IsNullOrEmpty(m.LatestDownloadUrl))
            .OrderBy(m => m.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void OpenBulkUpdateDialog()
    {
        var updatableMods = GetUpdatableMods();
        _bulkUpdateSelection = updatableMods.ToDictionary(m => m.DisplayName, _ => true);
        _bulkUpdateStep = BulkUpdateStep.Select;
        _bulkUpdateResults.Clear();
        _bulkUpdateCurrentIndex = 0;
        _bulkUpdateCurrentMod = null;
        _showBulkUpdateDialog = true;
    }

    private void CloseBulkUpdateDialog()
    {
        _showBulkUpdateDialog = false;
        _isBulkUpdating = false;
    }

    private void ToggleBulkUpdateSelection(ModHealthInfo mod)
    {
        if (_bulkUpdateSelection.ContainsKey(mod.DisplayName))
        {
            _bulkUpdateSelection[mod.DisplayName] = !_bulkUpdateSelection[mod.DisplayName];
        }
    }

    private void SetBulkUpdateSelection(ModHealthInfo mod, bool value)
    {
        _bulkUpdateSelection[mod.DisplayName] = value;
    }

    private void ToggleAllBulkUpdateSelection()
    {
        var allSelected = _bulkUpdateSelection.All(kv => kv.Value);
        var newValue = !allSelected;
        foreach (var key in _bulkUpdateSelection.Keys.ToList())
        {
            _bulkUpdateSelection[key] = newValue;
        }
    }

    private async Task StartBulkUpdate()
    {
        var selectedMods = GetUpdatableMods()
            .Where(m => _bulkUpdateSelection.GetValueOrDefault(m.DisplayName, false))
            .ToList();

        if (selectedMods.Count == 0) return;

        _isBulkUpdating = true;
        _bulkUpdateStep = BulkUpdateStep.Updating;
        _bulkUpdateResults.Clear();
        _bulkUpdateCurrentIndex = 0;
        _bulkUpdateTotalCount = selectedMods.Count;
        await InvokeAsync(StateHasChanged);

        foreach (var mod in selectedMods)
        {
            _bulkUpdateCurrentMod = mod.DisplayName;
            await InvokeAsync(StateHasChanged);

            var result = new BulkUpdateResult 
            { 
                ModName = mod.DisplayName,
                NewVersion = mod.LatestVersion
            };

            try
            {
                if (string.IsNullOrEmpty(mod.LatestDownloadUrl))
                {
                    result.Success = false;
                    result.Error = "No download URL available";
                }
                else
                {
                    // If mod is tracked, remove it from staged config so it gets uninstalled
                    if (mod.TrackedMod != null)
                    {
                        var existingMod = ConfigService.StagedConfig.ModList
                            .FirstOrDefault(m => m.DownloadUrl == mod.TrackedMod.DownloadUrl);
                        
                        if (existingMod != null)
                        {
                            ConfigService.StagedConfig.ModList.Remove(existingMod);
                            ConfigService.ClearStagingForUrl(existingMod.DownloadUrl);
                        }
                    }

                    // Download and stage the new version
                    var (success, error) = await ModDownloadService.DownloadAndStageAsync(
                        mod.LatestDownloadUrl, 
                        mod.DisplayName);

                    result.Success = success;
                    result.Error = error;

                    if (success)
                    {
                        // Update the UI state to show update is staged
                        mod.InstalledVersion = $"{mod.InstalledVersion} → {mod.LatestVersion}";
                        mod.Status = ModHealthStatus.UpToDate;
                        mod.LatestDownloadUrl = null;
                    }
                    else if (mod.TrackedMod != null)
                    {
                        // Rollback: re-add the old mod if we removed it
                        if (!ConfigService.StagedConfig.ModList.Any(m => m.DownloadUrl == mod.TrackedMod.DownloadUrl))
                        {
                            ConfigService.StagedConfig.ModList.Add(mod.TrackedMod);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                result.Success = false;
                result.Error = ex.Message;
            }

            _bulkUpdateResults.Add(result);
            _bulkUpdateCurrentIndex++;
            await InvokeAsync(StateHasChanged);
        }

        // Save the staged config with all changes
        await ConfigService.SaveStagedConfigAsync();

        _bulkUpdateStep = BulkUpdateStep.Results;
        _isBulkUpdating = false;
        
        // Notify parent to refresh UI
        await OnModsStaged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }
}
