@using ModGod.Models
@using ModGod.Services

<MudPaper Class="pa-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); border-radius: 8px;">
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--text-secondary);">
        When installing a mod, ModGod maps directories from the archive to your server. 
        Customize these mappings to redirect specific folders (e.g., install <code>BepInEx/plugins</code> to a custom location).
    </MudText>

    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        <strong>How it works:</strong> If a mod archive contains a "BepInEx" folder at the top level, 
        it will be installed to the "BepInEx" folder on your server (by default). 
        Add custom mappings to change where specific directories are installed.
        <br /><br />
        <strong>Note:</strong> These mappings are used to pre-populate install paths when you add a mod. 
        You can always customize the final install paths for each mod individually in the Edit Mod dialog.
    </MudAlert>

    <!-- Mappings List -->
    @if (_mappings.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color: var(--text-secondary); font-style: italic;" Class="mb-3">
            No custom mappings configured. Using defaults (BepInEx &rarr; BepInEx, SPT &rarr; SPT).
        </MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Class="mb-3" Style="background: var(--card-bg);">
            <thead>
                <tr>
                    <th style="color: var(--text-secondary);">Source (in archive)</th>
                    <th style="width: 40px; text-align: center; color: var(--text-secondary);"></th>
                    <th style="color: var(--text-secondary);">Target (on server)</th>
                    <th style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (mapping, index) in _mappings.Select((m, i) => (m, i)))
                {
                    <tr>
                        <td style="color: var(--text-primary);">
                            @if (_editingIndex == index)
                            {
                                <MudTextField @bind-Value="_editSource" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense"
                                              Placeholder="e.g., BepInEx/plugins" />
                            }
                            else
                            {
                                <code>@mapping.Source</code>
                            }
                        </td>
                        <td style="text-align: center; color: var(--text-secondary);">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </td>
                        <td style="color: var(--text-primary);">
                            @if (_editingIndex == index)
                            {
                                <MudTextField @bind-Value="_editTarget" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense"
                                              Placeholder="e.g., BepInEx/plugins_custom" />
                            }
                            else
                            {
                                <code>@mapping.Target</code>
                            }
                        </td>
                        <td>
                            @if (_editingIndex == index)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Check" 
                                               Color="Color.Success" 
                                               Size="Size.Small"
                                               OnClick="() => SaveEdit(index)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                               Color="Color.Default" 
                                               Size="Size.Small"
                                               OnClick="CancelEdit" />
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                               Color="Color.Default" 
                                               Size="Size.Small"
                                               OnClick="() => StartEdit(index)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Size="Size.Small"
                                               OnClick="() => DeleteMapping(index)" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    <!-- Add New Mapping Form -->
    @if (_isAdding)
    {
        <MudPaper Class="pa-3 mb-3" Style="background: var(--card-bg); border: 1px dashed var(--border-color); border-radius: 8px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--text-primary);">Add New Mapping</MudText>
            <div class="d-flex gap-2 align-center">
                <MudTextField @bind-Value="_newSource" 
                              Label="Source" 
                              Placeholder="e.g., BepInEx/plugins"
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense"
                              Style="flex: 1;" />
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="color: var(--text-secondary);" />
                <MudTextField @bind-Value="_newTarget" 
                              Label="Target" 
                              Placeholder="e.g., BepInEx/plugins_custom"
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense"
                              Style="flex: 1;" />
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Success" 
                           OnClick="AddMapping"
                           Disabled="@(string.IsNullOrWhiteSpace(_newSource))">
                    Add
                </MudButton>
                <MudButton Variant="Variant.Text" 
                           Color="Color.Default" 
                           OnClick="CancelAdd">
                    Cancel
                </MudButton>
            </div>
        </MudPaper>
    }

    <!-- Action Buttons -->
    <div class="d-flex gap-2">
        @if (!_isAdding)
        {
            <MudButton Variant="Variant.Outlined" 
                       StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       OnClick="StartAdd"
                       Disabled="@(_editingIndex >= 0)">
                Add Mapping
            </MudButton>
        }
        
        <MudButton Variant="Variant.Text" 
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   Color="Color.Warning"
                   OnClick="ResetToDefaults"
                   Disabled="@(_editingIndex >= 0 || _isAdding)">
            Reset to Defaults
        </MudButton>
    </div>
</MudPaper>

@code {
    [Inject] private ConfigService ConfigService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    
    [Parameter] public EventCallback OnChange { get; set; }

    private List<DefaultInstallPathMapping> _mappings = new();

    // Add form state
    private bool _isAdding;
    private string _newSource = "";
    private string _newTarget = "";

    // Edit state
    private int _editingIndex = -1;
    private string _editSource = "";
    private string _editTarget = "";

    protected override void OnInitialized()
    {
        LoadMappings();
    }

    /// <summary>
    /// Reload mappings from config (called when discarding changes)
    /// </summary>
    public void ReloadFromConfig()
    {
        LoadMappings();
        StateHasChanged();
    }

    private void LoadMappings()
    {
        // Get effective mappings (from config or defaults)
        var effectiveMappings = DefaultInstallPaths.GetEffectiveMappings(ConfigService.StagedConfig);
        
        // Clone to avoid mutating the original
        _mappings = effectiveMappings.Select(m => new DefaultInstallPathMapping 
        { 
            Source = m.Source, 
            Target = m.Target 
        }).ToList();
    }

    private async Task SaveToConfig()
    {
        // Save to staged config only - user must click "Apply Changes" to commit
        ConfigService.StagedConfig.DefaultInstallPaths = _mappings.Count > 0 
            ? _mappings.ToList() 
            : null; // null = use defaults
        
        await ConfigService.SaveStagedConfigAsync();
        
        // Notify parent that settings changed (so Apply Changes button appears)
        await OnChange.InvokeAsync();
    }

    // Add mapping
    private void StartAdd()
    {
        _isAdding = true;
        _newSource = "";
        _newTarget = "";
    }

    private void CancelAdd()
    {
        _isAdding = false;
        _newSource = "";
        _newTarget = "";
    }

    private async Task AddMapping()
    {
        if (string.IsNullOrWhiteSpace(_newSource))
            return;

        var normalizedSource = NormalizePath(_newSource);
        var normalizedTarget = string.IsNullOrWhiteSpace(_newTarget) 
            ? normalizedSource 
            : NormalizePath(_newTarget);

        // Check for duplicate source
        if (_mappings.Any(m => m.Source.Equals(normalizedSource, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add($"A mapping for '{normalizedSource}' already exists.", Severity.Warning);
            return;
        }

        _mappings.Add(new DefaultInstallPathMapping
        {
            Source = normalizedSource,
            Target = normalizedTarget
        });

        _isAdding = false;
        _newSource = "";
        _newTarget = "";
        
        await SaveToConfig();
        Snackbar.Add("Mapping added.", Severity.Success);
    }

    // Edit mapping
    private void StartEdit(int index)
    {
        _editingIndex = index;
        _editSource = _mappings[index].Source;
        _editTarget = _mappings[index].Target;
    }

    private void CancelEdit()
    {
        _editingIndex = -1;
        _editSource = "";
        _editTarget = "";
    }

    private async Task SaveEdit(int index)
    {
        if (string.IsNullOrWhiteSpace(_editSource))
        {
            Snackbar.Add("Source path cannot be empty.", Severity.Warning);
            return;
        }

        var normalizedSource = NormalizePath(_editSource);
        var normalizedTarget = string.IsNullOrWhiteSpace(_editTarget) 
            ? normalizedSource 
            : NormalizePath(_editTarget);

        // Check for duplicate (excluding current item)
        if (_mappings.Where((m, i) => i != index)
                     .Any(m => m.Source.Equals(normalizedSource, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add($"A mapping for '{normalizedSource}' already exists.", Severity.Warning);
            return;
        }

        _mappings[index].Source = normalizedSource;
        _mappings[index].Target = normalizedTarget;
        
        _editingIndex = -1;
        _editSource = "";
        _editTarget = "";
        
        await SaveToConfig();
        Snackbar.Add("Mapping updated.", Severity.Success);
    }

    // Delete mapping
    private async Task DeleteMapping(int index)
    {
        var mapping = _mappings[index];
        var result = await DialogService.ShowMessageBox(
            "Delete Mapping",
            $"Remove the mapping '{mapping.Source}' -> '{mapping.Target}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result == true)
        {
            _mappings.RemoveAt(index);
            await SaveToConfig();
            Snackbar.Add("Mapping removed.", Severity.Info);
        }
    }

    private async Task ResetToDefaults()
    {
        var result = await DialogService.ShowMessageBox(
            "Reset to Defaults",
            "Reset install path mappings to the defaults (BepInEx -> BepInEx, SPT -> SPT)?",
            yesText: "Reset",
            cancelText: "Cancel");

        if (result == true)
        {
            _mappings = DefaultInstallPaths.Mappings.Select(m => new DefaultInstallPathMapping 
            { 
                Source = m.Source, 
                Target = m.Target 
            }).ToList();
            
            await SaveToConfig();
            Snackbar.Add("Reset to defaults.", Severity.Info);
        }
    }

    private static string NormalizePath(string path)
    {
        if (string.IsNullOrEmpty(path)) return string.Empty;
        return path.Replace('\\', '/').Trim('/');
    }
}
