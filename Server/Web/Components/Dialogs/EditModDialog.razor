@using ModGod.Models
@using ModGod.Web.Models
@using ModGod.Services
@using Color = MudBlazor.Color
@using System.IO

@inject ConfigService ConfigService
@inject ModDownloadService ModDownloadService

<MudDialog @bind-Visible="Visible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = true })">
    <TitleContent>
        <div class="d-flex justify-space-between align-center" style="width: 100%;">
            <MudText Typo="Typo.h6" Style="color: var(--text-primary);">Edit Mod</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Style="color: var(--text-secondary);"
                           OnClick="Close" />
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_modName"
                      Label="Mod Name (For your reference only)"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      Required="true" />

        <MudTextField Value="@_downloadUrl"
                      Label="Download URL"
                      Variant="Variant.Outlined"
                      Class="mb-4 mono"
                      ReadOnly="true"
                      HelperText="URL cannot be changed. Delete and re-add to update / use a different URL." />

        <MudCheckBox @bind-Value="_isOptional"
                     Label="Optional mod (not enforced on clients)"
                     Color="Color.Primary"
                     Class="mb-4" />



        @if (Mod != null && IsPendingInstall)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2" Style="color: var(--text-primary); font-weight: 600;">
                Install Paths
            </MudText>
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                    Map folders from the archive to destinations on your server. All target paths are relative to your SPT root.
                </MudText>
                <div style="position: relative;">
                    <MudLink Typo="Typo.caption"
                             Style="color: var(--accent-cyan); cursor: pointer; white-space: nowrap; margin-left: 16px;"
                             OnClick="@(() => _isArchiveContentsPopoverOpen = true)">
                        See Archive Contents
                    </MudLink>

                    @if (_isArchiveContentsPopoverOpen)
                    {
                        <div class="file-tree-backdrop" @onclick="@(() => _isArchiveContentsPopoverOpen = false)"></div>
                        <MudPaper Class="pa-3"
                                  Style="position: absolute; top: 100%; right: 0; width: 400px; max-height: 350px; background: #1a1a1a; border: 1px solid var(--border-color); z-index: 1001; margin-top: 4px; border-radius: 8px;">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--text-primary);">
                                    Archive Contents
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Style="color: var(--text-secondary);"
                                               OnClick="@(() => _isArchiveContentsPopoverOpen = false)" />
                            </div>

                            <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--text-secondary);">
                                Files and folders extracted from the mod archive.
                            </MudText>

                            <div style="max-height: 260px; overflow-y: auto;">
                                @if (_archiveTreeRoot == null || _archiveTreeRoot.Children.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="px-2" Style="color: var(--text-secondary);">
                                        No archive contents available. Try re-downloading the mod.
                                    </MudText>
                                }
                                else
                                {
                                    @foreach (var item in GetFlattenedArchiveTreeReadOnly())
                                    {
                                        var node = item.Node;
                                        var depth = item.Depth;
                                        var isExpanded = node.IsDirectory && _archiveContentsExpandedDirs.Contains(node.RelativePath);
                                        var capturedNode = node;

                                        <div class="d-flex align-center py-1 source-tree-item"
                                             style="padding-left:@(depth * 14 + 4)px; border-radius: 4px; margin: 1px 0;">

                                            @if (node.IsDirectory)
                                            {
                                                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                                                               Size="Size.Small"
                                                               Style="padding: 2px; min-width: 20px; color: var(--text-secondary);"
                                                               OnClick="@(() => ToggleArchiveContentsExpand(capturedNode))" />
                                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" Style="color: var(--accent-cyan);" />
                                            }
                                            else
                                            {
                                                <span style="width: 24px;"></span>
                                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="mr-2" Style="color: var(--text-secondary);" />
                                            }
                                            <span class="mono" style="font-size: 12px; color: var(--text-primary);">@node.Name</span>
                                        </div>
                                    }
                                }
                            </div>
                        </MudPaper>
                    }
                </div>
            </div>
            <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--text-secondary); opacity: 0.8;">
                <b>Tip:</b> If you select a <b>directory</b> as the source, its contents will be merged into the target.
                If you select a <b>file</b>, it will be copied directly into the target directory.
            </MudText>

            @if (_installPaths != null)
            {
                @for (int i = 0; i < _installPaths.Count; i++)
                {
                    var index = i;
                    <MudPaper Class="pa-4 mb-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); position: relative;">
                        <div class="d-flex align-center justify-space-between mb-3">
                             <MudText Typo="Typo.caption" Style="color: var(--text-secondary); font-weight: 600;">INSTALL PATH @(index + 1)</MudText>
                             <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                            Color="Color.Error"
                                            Size="Size.Small"
                                            OnClick="@(() => RemoveInstallPath(index))"
                                            title="Remove path" />
                        </div>

                        <div class="d-flex align-center gap-3">
                            @* Source Selection *@
                            <div style="flex: 1; position: relative;">
                                <MudText Typo="Typo.caption" Class="mb-1" Style="color: var(--text-secondary);">Source (Archive)</MudText>
                                <div class="d-flex align-center" style="border: 1px solid var(--border-color); border-radius: 4px; background: var(--secondary-bg); height: 40px;">
                                    <input type="text"
                                           class="mono"
                                           style="flex: 1; background: transparent; border: none; outline: none; color: var(--text-primary); font-size: 14px; padding: 0 12px;"
                                           placeholder="Select a directory or file"
                                           value="@_installPaths[index].Source"
                                           @onchange="@((ChangeEventArgs e) => OnInstallPathChanged(index, e.Value?.ToString() ?? "", isSource: true))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                                   Size="Size.Small"
                                                   Style="color: var(--text-secondary);"
                                                   OnClick="@(() => OpenSourceTree(index))" />
                                </div>

                                @if (_activeSourceIndex == index && _isSourcePopoverOpen)
                                {
                                    <div class="file-tree-backdrop" @onclick="@(() => _isSourcePopoverOpen = false)"></div>
                                    <MudPaper Class="pa-2"
                                              Style="position: absolute; top: 100%; left: 0; width: 320px; max-height: 280px; overflow-y: auto; background: #1a1a1a; border: 1px solid var(--border-color); z-index: 1001; margin-top: 4px; border-radius: 4px;">
                                        <div class="d-flex justify-space-between align-center mb-2 px-1">
                                            <MudText Typo="Typo.caption" Style="font-weight:bold; color: var(--text-primary);">Select Source</MudText>
                                        </div>
                                        @if (_archiveTreeRoot == null || _archiveTreeRoot.Children.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="px-2" Style="color: var(--text-secondary);">No archive contents available</MudText>
                                        }
                                        else
                                        {
                                            @foreach (var item in GetFlattenedArchiveTree())
                                            {
                                                var node = item.Node;
                                                var depth = item.Depth;
                                                var isExpanded = node.IsDirectory && _archiveExpandedDirs.Contains(node.RelativePath);
                                                var capturedNode = node;
                                                var capturedIndex = index;

                                                <div class="d-flex align-center py-1 source-tree-item"
                                                     style="padding-left:@(depth * 14 + 4)px; border-radius: 4px; margin: 1px 0;">

                                                    @if (node.IsDirectory)
                                                    {
                                                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                                                                       Size="Size.Small"
                                                                       Style="padding: 2px; min-width: 20px; color: var(--text-secondary);"
                                                                       OnClick="@(() => ToggleArchiveExpand(capturedNode))" />
                                                    }
                                                    else
                                                    {
                                                        <span style="width: 24px;"></span>
                                                    }

                                                    <div class="d-flex align-center flex-grow-1"
                                                         style="cursor: pointer; padding: 2px 4px; border-radius: 4px;"
                                                         @onclick="@(() => SelectSourcePath(capturedIndex, capturedNode.RelativePath))"
                                                         @onclick:stopPropagation="true">
                                                        @if (node.IsDirectory)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" Style="color: var(--accent-cyan);" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="mr-2" Style="color: var(--text-secondary);" />
                                                        }
                                                        <span class="mono" style="font-size: 12px; color: var(--text-primary);">@node.Name</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </MudPaper>
                                }
                            </div>

                            @* Arrow *@
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="color: var(--text-secondary); opacity: 0.5; flex-shrink: 0; margin-top: 18px; fill: #00fe5d;" />

                            @* Target Selection *@
                            <div style="flex: 1; position: relative;">
                                <MudText Typo="Typo.caption" Class="mb-1" Style="color: var(--text-secondary);">Target (Server)</MudText>
                                <div class="d-flex align-center" style="border: 1px solid var(--border-color); border-radius: 4px; background: var(--secondary-bg); height: 40px;">
                                    <span class="mono" style="color: var(--text-secondary); font-size: 12px; white-space: nowrap; border-right: 1px solid var(--border-color); padding: 0 10px; background: rgba(0,0,0,0.2); height: 100%; display: flex; align-items: center;">&lt;SPT_ROOT&gt;/</span>
                                    <input type="text"
                                           class="mono"
                                           style="flex: 1; background: transparent; border: none; outline: none; color: var(--text-primary); font-size: 14px; padding: 0 8px;"
                                           placeholder="Select a directory"
                                           value="@_installPaths[index].Target"
                                           @onchange="@((ChangeEventArgs e) => OnInstallPathChanged(index, e.Value?.ToString() ?? "", isSource: false))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                                   Size="Size.Small"
                                                   Style="color: var(--text-secondary);"
                                                   OnClick="@(() => OpenTargetTree(index))" />
                                </div>

                                @if (_activeTargetIndex == index && _isTargetPopoverOpen)
                                {
                                    <div class="file-tree-backdrop" @onclick="@(() => _isTargetPopoverOpen = false)"></div>
                                    <MudPaper Class="pa-2"
                                              Style="position: absolute; top: 100%; right: 0; width: 320px; max-height: 280px; overflow-y: auto; background: #1a1a1a; border: 1px solid var(--border-color); z-index: 1001; margin-top: 4px; border-radius: 4px;">
                                        <div class="d-flex justify-space-between align-center mb-2 px-1">
                                            <MudText Typo="Typo.caption" Style="font-weight:bold; color: var(--text-primary);">Select Target</MudText>
                                        </div>
                                        @if (_serverTreeRoot == null || _serverTreeRoot.Children.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="px-2" Style="color: var(--text-secondary);">No directories found</MudText>
                                        }
                                        else
                                        {
                                            @foreach (var item in GetFlattenedServerTree())
                                            {
                                                var node = item.Node;
                                                var depth = item.Depth;
                                                var isExpanded = _serverExpandedDirs.Contains(node.RelativePath);
                                                var capturedNode = node;
                                                var capturedIndex = index;

                                                <div class="d-flex align-center py-1 source-tree-item"
                                                     style="padding-left:@(depth * 14 + 4)px; border-radius: 4px; margin: 1px 0;">

                                                    @if (node.Children.Count > 0)
                                                    {
                                                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                                                                       Size="Size.Small"
                                                                       Style="padding: 2px; min-width: 20px; color: var(--text-secondary);"
                                                                       OnClick="@(() => ToggleServerExpand(capturedNode))" />
                                                    }
                                                    else
                                                    {
                                                        <span style="width: 24px;"></span>
                                                    }

                                                    <div class="d-flex align-center flex-grow-1"
                                                         style="cursor: pointer; padding: 2px 4px; border-radius: 4px;"
                                                         @onclick="@(() => SelectTargetPath(capturedIndex, capturedNode.RelativePath))"
                                                         @onclick:stopPropagation="true">
                                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" Style="color: var(--accent-green);" />
                                                        <span class="mono" style="font-size: 12px; color: var(--text-primary);">@node.Name</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </MudPaper>
                                }
                            </div>
                        </div>
                    </MudPaper>
                }
            }

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       OnClick="AddInstallPath"
                       Class="mt-2">
                Add Install Path
            </MudButton>
        }

        @if (Mod != null && !IsPendingInstall)
        {
            <MudDivider Class="my-4" />

            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.subtitle1" Style="color: var(--text-primary); font-weight: 600;">
                    Tracked Files
                </MudText>
                <MudChip T="string" Size="Size.Small" Style="background: var(--secondary-bg);">
                    @_installedFilesSet.Count file(s)
                </MudChip>
            </div>

            <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--text-secondary);">
                ModGod tracks which files belong to this mod for two purposes:
                <b>automatic cleanup</b> when uninstalling, and <b>skipping verification</b> for optional mods.
                You can manually add or remove files if the tracking is incorrect.
            </MudText>

            @if (_installedFilesSet.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    <b>No files are being tracked.</b> This may be because the mod was installed manually or with an older version of ModGod.
                    <br /><br />
                    You can either use "Browse & Add Files" below to manually select the files, or remove this mod and reinstall it through ModGod to automatically track files.
                </MudAlert>
            }
            else
            {
                @if (MissingFiles.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                        @MissingFiles.Count tracked file(s) missing from disk. Consider removing them from tracking.
                    </MudAlert>
                }

                <MudPaper Class="pa-3 mb-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); max-height: 280px; overflow-y: auto;">
                    @foreach (var file in _installedFilesSet.OrderBy(f => f))
                    {
                        var isMissing = MissingFiles.Contains(file, StringComparer.OrdinalIgnoreCase);
                        var capturedFile = file;
                        <div class="d-flex align-center justify-space-between mb-1 installed-file-row" style="padding: 4px 8px; border-radius: 4px;">
                            <div class="d-flex align-center" style="font-family: monospace; font-size: 12px; color: @(isMissing ? "var(--accent-red)" : "var(--text-primary)"); overflow: hidden;">
                                @if (isMissing)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Class="mr-2" Style="color: var(--accent-red); flex-shrink: 0;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-2" Style="color: var(--accent-green); flex-shrink: 0;" />
                                }
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@file">@file</span>
                            </div>
                            <MudTooltip Text="Remove from tracking">
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Style="color: var(--text-secondary); padding: 2px;"
                                               OnClick="@(() => RemoveInstalledFile(capturedFile))" />
                            </MudTooltip>
                        </div>
                    }
                </MudPaper>
            }

            <div style="position: relative;">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.CreateNewFolder"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="OpenInstalledFilesBrowser">
                    Browse & Add Files
                </MudButton>

                @if (_isInstalledFilesPopoverOpen)
                {
                    <div class="file-tree-backdrop" @onclick="@(() => _isInstalledFilesPopoverOpen = false)"></div>
                    <MudPaper Class="pa-3"
                              Style="position: absolute; bottom: 100%; left: 0; width: 450px; max-height: 350px; background: #1a1a1a; border: 1px solid var(--border-color); z-index: 1001; margin-bottom: 4px; border-radius: 8px;">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--text-primary);">
                                Select Files to Track
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Style="color: var(--text-secondary);"
                                           OnClick="@(() => _isInstalledFilesPopoverOpen = false)" />
                        </div>

                        <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--text-secondary);">
                            Select a folder to track all files within it.
                        </MudText>

                        <div style="max-height: 260px; overflow-y: auto;">
                            @if (_installedFilesTreeRoot == null || _installedFilesTreeRoot.Children.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Class="px-2" Style="color: var(--text-secondary);">
                                    No directories found. Ensure your SPT root is configured correctly.
                                </MudText>
                            }
                            else
                            {
                                @foreach (var item in GetFlattenedInstalledFilesTree())
                                {
                                    var node = item.Node;
                                    var depth = item.Depth;
                                    var isExpanded = node.IsDirectory && _installedFilesExpandedDirs.Contains(node.RelativePath);
                                    var capturedNode = node;
                                    var dirState = node.IsDirectory ? GetDirectoryTrackingState(node) : null;
                                    var isTracked = !node.IsDirectory && _installedFilesSet.Contains(node.RelativePath);

                                    // Compute directory checkbox icon and color
                                    var dirIcon = dirState switch
                                    {
                                        FileRuleState.Overwrite => Icons.Material.Filled.CheckBox,
                                        FileRuleState.Ignore => Icons.Material.Filled.CheckBoxOutlineBlank,
                                        _ => Icons.Material.Filled.IndeterminateCheckBox
                                    };
                                    var dirColor = dirState switch
                                    {
                                        FileRuleState.Overwrite => "var(--accent-green)",
                                        FileRuleState.Ignore => "var(--text-secondary)",
                                        _ => "var(--accent-orange)"
                                    };

                                    <div class="d-flex align-center py-1 source-tree-item"
                                         style="padding-left:@(depth * 14 + 4)px; border-radius: 4px; margin: 1px 0;">

                                        @if (node.IsDirectory)
                                        {
                                            <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                                                           Size="Size.Small"
                                                           Style="padding: 2px; min-width: 20px; color: var(--text-secondary);"
                                                           OnClick="@(() => ToggleInstalledFilesExpand(capturedNode))" />
                                            <MudIconButton Icon="@dirIcon"
                                                           Size="Size.Small"
                                                           Style="@($"padding: 2px; min-width: 24px; color: {dirColor};")"
                                                           OnClick="@(() => ToggleDirectoryTracking(capturedNode))" />
                                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" Style="color: var(--accent-cyan);" />
                                            <span class="mono" style="font-size: 12px; color: var(--text-primary); cursor: pointer;"
                                                  @onclick="@(() => ToggleInstalledFilesExpand(capturedNode))">
                                                @node.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="width: 24px;"></span>
                                            <MudCheckBox T="bool"
                                                         Value="@isTracked"
                                                         ValueChanged="@((bool val) => ToggleInstalledFile(capturedNode.RelativePath, val))"
                                                         Size="Size.Small"
                                                         Style="margin: 0; padding: 0;"
                                                         Color="Color.Primary" />
                                            <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="mr-2" Style="color: var(--text-secondary);" />
                                            <span class="mono" style="font-size: 12px; color: @(isTracked ? "var(--accent-green)" : "var(--text-primary)");">
                                                @node.Name
                                            </span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </MudPaper>
                }
            </div>
        }

        @if (Mod != null && IsPendingInstall)
        {
            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1" Class="mb-1" Style="color: var(--text-primary); font-weight: 600;">
                Files to be Overwritten
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--text-secondary);">
                Any files <b>that will be overwritten</b> will appear below.
                <br />
                <span>
                    <b>Uncheck</b> any files you <b>do not want to overwrite</b>.
                </span>
                <br />
                <span style="color: var(--accent-orange);">
                    <i>
                        Example: Updating a server mod but want to keep your existing <code>config.json</code>? Simply uncheck that item.
                    </i>
                </span>
            </MudText>

            @if (_fileTreeLoading)
            {
                <div class="d-flex align-center mb-3">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <MudText Typo="Typo.body2">Loading file tree...</MudText>
                </div>
            }
            else if (!string.IsNullOrEmpty(_fileTreeError))
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    @_fileTreeError
                </MudAlert>
            }
            else if (_noFilesToOverwrite)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    No existing files would be overwritten by this mod. All files are new.
                </MudAlert>
            }
            else if (_fileTreeRoot != null && _fileTreeRoot.Children != null && _fileTreeRoot.Children.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    This mod will overwrite existing files. Uncheck any files you want to keep.
                </MudAlert>
                <MudPaper Class="pa-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); max-height: 360px; overflow-y: auto;">
                    <div class="mb-2" style="font-size:13px; color: var(--text-secondary);">
                        ✓ Checked = overwrite (default) &nbsp;|&nbsp; ☐ Unchecked = ignore (keep existing)
                    </div>
                    @foreach (var item in GetFlattenedTree())
                    {
                        var node = item.Node;
                        var depth = item.Depth;
                        var state = GetNodeState(node);
                        var capturedNode = node;
                        var isExpanded = node.IsDirectory && _expandedDirs.Contains(node.RelativePath);
                        var hasChildren = node.IsDirectory && node.Children?.Count > 0;
                        <div class="d-flex align-center" style="padding-left:@(depth * 18)px; margin-bottom:2px;">
                            @if (hasChildren)
                            {
                                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)"
                                               Size="Size.Small"
                                               Style="padding: 2px; min-width: 24px; color: var(--text-secondary);"
                                               OnClick="() => ToggleExpand(capturedNode)" />
                            }
                            else
                            {
                                <div style="width: 28px;"></div>
                            }
                            @{
                                var checkIcon = state switch
                                {
                                    FileRuleState.Overwrite => Icons.Material.Filled.CheckBox,
                                    FileRuleState.Ignore => Icons.Material.Filled.CheckBoxOutlineBlank,
                                    _ => Icons.Material.Filled.IndeterminateCheckBox
                                };
                                var iconColor = state switch
                                {
                                    FileRuleState.Overwrite => "var(--accent-green)",
                                    FileRuleState.Ignore => "var(--text-secondary)",
                                    _ => "var(--accent-orange)"
                                };
                            }
                            <MudIconButton Icon="@checkIcon"
                                           Size="Size.Small"
                                           Style="@($"padding: 2px; min-width: 24px; color: {iconColor};")"
                                           OnClick="() => ToggleNode(capturedNode)" />
                            @if (node.IsDirectory && hasChildren)
                            {
                                <span class="ml-1 mono" style="color: var(--text-primary); cursor: pointer;" @onclick="() => ToggleExpand(capturedNode)">
                                    📁 @(node.Name)
                                </span>
                            }
                            else
                            {
                                <span class="ml-1 mono" style="color: var(--text-primary);">
                                    @(node.IsDirectory ? "📁" : "📄") @(node.Name)
                                </span>
                            }
                        </div>
                    }
                </MudPaper>
                <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--text-secondary);">
                    Note: Directories are never overwritten—only files within them.
                </MudText>
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    No files found in staging for this mod. Delete and reinstall to refresh the file list.
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-space-between align-center" style="width: 100%;">
            <MudButton OnClick="Reset"
                       Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Style="color: var(--text-secondary);">
                Reset
            </MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(string.IsNullOrWhiteSpace(_modName) || (_installPaths?.Count ?? 0) == 0)"
                       OnClick="Save">
                Save Changes
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public ModEntry? Mod { get; set; }
    [Parameter] public bool IsPendingInstall { get; set; }
    [Parameter] public List<string> MissingFiles { get; set; } = new();
    [Parameter] public EventCallback<EditModResult> OnSave { get; set; }

    // Edit state
    private string _modName = "";
    private string _downloadUrl = "";
    private bool _isOptional;
    private List<InstallPathItem> _installPaths = new();
    private List<string>? _archiveContents;

    // File tree state
    private FileNode? _fileTreeRoot;
    private HashSet<string> _ignoredPaths = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _expandedDirs = new(StringComparer.OrdinalIgnoreCase);
    private bool _fileTreeLoading;
    private string? _fileTreeError;
    private bool _noFilesToOverwrite;

    // Archive tree state for source selection
    private FileNode? _archiveTreeRoot;
    private HashSet<string> _archiveExpandedDirs = new(StringComparer.OrdinalIgnoreCase);
    private int _activeSourceIndex = -1;
    private bool _isSourcePopoverOpen;

    // Archive contents viewer (read-only popup)
    private bool _isArchiveContentsPopoverOpen;
    private HashSet<string> _archiveContentsExpandedDirs = new(StringComparer.OrdinalIgnoreCase);

    // Server tree state for target selection
    private FileNode? _serverTreeRoot;
    private HashSet<string> _serverExpandedDirs = new(StringComparer.OrdinalIgnoreCase);
    private int _activeTargetIndex = -1;
    private bool _isTargetPopoverOpen;

    // Installed files state (for already-installed mods)
    private HashSet<string> _installedFilesSet = new(StringComparer.OrdinalIgnoreCase);
    private bool _installedFilesModified;
    private FileNode? _installedFilesTreeRoot;
    private HashSet<string> _installedFilesExpandedDirs = new(StringComparer.OrdinalIgnoreCase);
    private bool _isInstalledFilesPopoverOpen;

    // Track which mod we initialized for
    private string? _initializedForUrl;

    protected override async Task OnParametersSetAsync()
    {
        // Re-initialize when a different mod is passed or when dialog opens fresh
        if (Visible && Mod != null && _initializedForUrl != Mod.DownloadUrl)
        {
            // Initialize from mod
            _initializedForUrl = Mod.DownloadUrl;
            _modName = Mod.ModName ?? "";
            _downloadUrl = Mod.DownloadUrl ?? "";
            _isOptional = Mod.Optional;

            var installPaths = Mod.InstallPaths ?? new List<string[]>();
            _installPaths = installPaths
                .Where(p => p != null && p.Length >= 2)
                .Select(p => new InstallPathItem { Source = p[0] ?? "", Target = p[1] ?? "" })
                .ToList();
            if (_installPaths.Count == 0)
            {
                _installPaths.Add(new InstallPathItem());
            }

            // Load archive contents
            _archiveContents = null;
            if (!string.IsNullOrEmpty(Mod.DownloadUrl) &&
                ConfigService.Staging?.UrlToPath != null &&
                ConfigService.Staging.UrlToPath.TryGetValue(Mod.DownloadUrl, out var stagingPath))
            {
                _archiveContents = ModDownloadService.GetExtractedContents(stagingPath);
                BuildArchiveTree();
            }

            // Initialize file rules
            var rules = Mod.FileRules ?? new List<FileCopyRule>();
            _ignoredPaths = new HashSet<string>(
                rules.Where(r => r != null && r.State == FileCopyRuleState.Ignore && !string.IsNullOrWhiteSpace(r.Path))
                     .Select(r => NormalizePath(r.Path)),
                StringComparer.OrdinalIgnoreCase);
            _expandedDirs.Clear();
            _fileTreeError = null;
            _fileTreeRoot = null;
            _fileTreeLoading = true;

            // Initialize installed files tracking (for already-installed mods)
            _installedFilesSet = new HashSet<string>(
                (Mod.InstalledFiles ?? new List<string>()).Select(NormalizePath),
                StringComparer.OrdinalIgnoreCase);
            _installedFilesModified = false;
            _installedFilesExpandedDirs.Clear();
            _isInstalledFilesPopoverOpen = false;

            await LoadFileTreeAsync();
        }
        else if (!Visible)
        {
            // Close any open popovers when dialog closes
            _isSourcePopoverOpen = false;
            _isTargetPopoverOpen = false;
            _isInstalledFilesPopoverOpen = false;
            _isArchiveContentsPopoverOpen = false;
        }
    }

    private async Task LoadFileTreeAsync()
    {
        if (Mod == null) return;

        try
        {
            var downloadUrl = Mod.DownloadUrl;
            if (string.IsNullOrEmpty(downloadUrl))
            {
                _fileTreeError = "No download URL for this mod.";
                return;
            }

            var staging = ConfigService.Staging;
            if (staging?.UrlToPath == null || !staging.UrlToPath.TryGetValue(downloadUrl, out var stagingPath))
            {
                _fileTreeError = "Staging not found. Delete and reinstall this mod to view files.";
                return;
            }

            if (string.IsNullOrEmpty(stagingPath))
            {
                _fileTreeError = "Staging path is empty. Delete and reinstall this mod.";
                return;
            }

            var extractedPath = Path.Combine(stagingPath, "extracted");

            if (!Directory.Exists(extractedPath))
            {
                _fileTreeError = "Staging extraction not found. Delete and reinstall this mod to view files.";
                return;
            }

            var root = new FileNode { Name = "root", IsDirectory = true, RelativePath = "" };
            var installPaths = _installPaths ?? new List<InstallPathItem>();
            var sptRoot = ConfigService.SptRoot ?? "";
            var filesFound = 0;

            foreach (var install in installPaths
                .Where(p => p != null && !string.IsNullOrWhiteSpace(p.Source) && !string.IsNullOrWhiteSpace(p.Target))
                .DistinctBy(p => p.Source, StringComparer.OrdinalIgnoreCase))
            {
                var sourcePath = Path.Combine(extractedPath, install.Source);
                // Handle both old format (<SPT_ROOT>/path) and new format (path) for backwards compatibility
                var targetRel = install.Target.Replace("<SPT_ROOT>", "").TrimStart('/', '\\');
                var targetBasePath = Path.Combine(sptRoot, targetRel.Replace("/", Path.DirectorySeparatorChar.ToString()));

                if (Directory.Exists(sourcePath))
                {
                    var node = BuildNodeWithOverwriteCheck(sourcePath, NormalizePath(install.Source), targetBasePath, ref filesFound);
                    if (node != null && (node.Children?.Count > 0 || !node.IsDirectory))
                    {
                        MergeNode(root, node);
                    }
                }
                else if (File.Exists(sourcePath))
                {
                    // For single file sources, append the filename to the target path
                    var fileName = Path.GetFileName(sourcePath);
                    var targetFile = Path.Combine(targetBasePath, fileName);
                    if (File.Exists(targetFile))
                    {
                        AddFileNode(root, NormalizePath(install.Source));
                        filesFound++;
                    }
                }
            }

            _fileTreeRoot = root;
            _noFilesToOverwrite = filesFound == 0;
            _fileTreeError = null;
        }
        catch (Exception ex)
        {
            _fileTreeError = $"Failed to load file tree: {ex.Message}";
        }
        finally
        {
            _fileTreeLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private FileNode? BuildNodeWithOverwriteCheck(string fullSourcePath, string relativePath, string fullTargetPath, ref int filesFound)
    {
        var node = new FileNode
        {
            Name = Path.GetFileName(fullSourcePath),
            RelativePath = relativePath,
            IsDirectory = true
        };

        foreach (var dir in Directory.GetDirectories(fullSourcePath))
        {
            var dirName = Path.GetFileName(dir);
            var childRel = NormalizePath(Path.Combine(relativePath, dirName));
            var childTargetPath = Path.Combine(fullTargetPath, dirName);

            var childNode = BuildNodeWithOverwriteCheck(dir, childRel, childTargetPath, ref filesFound);
            if (childNode != null && (childNode.Children?.Count > 0 || !childNode.IsDirectory))
            {
                node.Children.Add(childNode);
            }
        }

        foreach (var file in Directory.GetFiles(fullSourcePath))
        {
            var fileName = Path.GetFileName(file);
            var childRel = NormalizePath(Path.Combine(relativePath, fileName));
            var targetFilePath = Path.Combine(fullTargetPath, fileName);

            if (File.Exists(targetFilePath))
            {
                node.Children.Add(new FileNode
                {
                    Name = fileName,
                    RelativePath = childRel,
                    IsDirectory = false
                });
                filesFound++;
            }
        }

        return node.Children.Count > 0 ? node : null;
    }

    private void MergeNode(FileNode parent, FileNode child)
    {
        var existing = parent.Children.FirstOrDefault(c =>
            c.IsDirectory &&
            c.Name.Equals(child.Name, StringComparison.OrdinalIgnoreCase) &&
            c.RelativePath.Equals(child.RelativePath, StringComparison.OrdinalIgnoreCase));

        if (existing == null)
        {
            parent.Children.Add(child);
            return;
        }

        foreach (var grand in child.Children)
        {
            if (grand.IsDirectory)
            {
                MergeNode(existing, grand);
            }
            else if (!existing.Children.Any(c => !c.IsDirectory && c.RelativePath.Equals(grand.RelativePath, StringComparison.OrdinalIgnoreCase)))
            {
                existing.Children.Add(grand);
            }
        }
    }

    private void AddFileNode(FileNode root, string relativePath)
    {
        var parts = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var current = root;
        var accumulated = "";
        for (int i = 0; i < parts.Length; i++)
        {
            accumulated = string.IsNullOrEmpty(accumulated) ? parts[i] : $"{accumulated}/{parts[i]}";
            var part = parts[i];
            var isLast = i == parts.Length - 1;
            if (isLast)
            {
                if (!current.Children.Any(c => !c.IsDirectory && c.Name.Equals(part, StringComparison.OrdinalIgnoreCase)))
                {
                    current.Children.Add(new FileNode
                    {
                        Name = part,
                        RelativePath = accumulated,
                        IsDirectory = false
                    });
                }
            }
            else
            {
                var dir = current.Children.FirstOrDefault(c => c.IsDirectory && c.Name.Equals(part, StringComparison.OrdinalIgnoreCase));
                if (dir == null)
                {
                    dir = new FileNode { Name = part, RelativePath = accumulated, IsDirectory = true };
                    current.Children.Add(dir);
                }
                current = dir;
            }
        }
    }

    private static string NormalizePath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        return path.Replace("\\", "/").TrimStart('/');
    }

    private FileRuleState GetNodeState(FileNode? node)
    {
        if (node == null) return FileRuleState.Overwrite;

        if (!node.IsDirectory)
        {
            return IsPathIgnored(node.RelativePath) ? FileRuleState.Ignore : FileRuleState.Overwrite;
        }

        var leafStates = GetLeafNodes(node).Select(GetNodeState).Distinct().ToList();
        if (leafStates.Count == 0) return FileRuleState.Overwrite;
        if (leafStates.Count == 1) return leafStates[0];
        return FileRuleState.Mixed;
    }

    private IEnumerable<FileNode> GetLeafNodes(FileNode? node)
    {
        if (node == null) yield break;

        if (!node.IsDirectory)
        {
            yield return node;
            yield break;
        }

        var children = node.Children;
        if (children == null) yield break;

        foreach (var child in children)
        {
            foreach (var leaf in GetLeafNodes(child))
                yield return leaf;
        }
    }

    private bool IsPathIgnored(string relativePath)
    {
        var norm = NormalizePath(relativePath);
        return _ignoredPaths.Any(r =>
            norm.Equals(r, StringComparison.OrdinalIgnoreCase) ||
            norm.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleExpand(FileNode node)
    {
        if (!node.IsDirectory) return;

        var path = node.RelativePath;
        if (_expandedDirs.Contains(path))
            _expandedDirs.Remove(path);
        else
            _expandedDirs.Add(path);
    }

    private void ToggleNode(FileNode? node)
    {
        if (node == null) return;

        var current = GetNodeState(node);
        var next = current == FileRuleState.Ignore ? FileRuleState.Overwrite : FileRuleState.Ignore;

        if (node.IsDirectory)
        {
            ApplyDirectoryState(node, next);
        }
        else
        {
            ApplyFileState(node, next);
        }
    }

    private void ApplyFileState(FileNode? node, FileRuleState state)
    {
        if (node == null) return;
        var rel = NormalizePath(node.RelativePath);

        if (state == FileRuleState.Ignore)
        {
            _ignoredPaths.Add(rel);
        }
        else
        {
            var ancestorIgnore = _ignoredPaths
                .FirstOrDefault(r => rel.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase));

            if (ancestorIgnore != null)
            {
                _ignoredPaths.Remove(ancestorIgnore);
                var ancestorNode = FindNodeByPath(_fileTreeRoot, ancestorIgnore);
                if (ancestorNode != null)
                {
                    foreach (var leaf in GetLeafNodes(ancestorNode))
                    {
                        var leafRel = NormalizePath(leaf.RelativePath);
                        if (!leafRel.Equals(rel, StringComparison.OrdinalIgnoreCase))
                        {
                            _ignoredPaths.Add(leafRel);
                        }
                    }
                }
            }
            _ignoredPaths.Remove(rel);
        }
    }

    private FileNode? FindNodeByPath(FileNode? node, string relativePath)
    {
        if (node == null) return null;
        var norm = NormalizePath(relativePath);
        if (NormalizePath(node.RelativePath).Equals(norm, StringComparison.OrdinalIgnoreCase))
            return node;

        foreach (var child in node.Children ?? Enumerable.Empty<FileNode>())
        {
            var found = FindNodeByPath(child, relativePath);
            if (found != null) return found;
        }
        return null;
    }

    private void ApplyDirectoryState(FileNode? node, FileRuleState state)
    {
        if (node == null) return;

        foreach (var path in EnumeratePaths(node).ToList())
        {
            _ignoredPaths.Remove(path);
        }

        if (state == FileRuleState.Ignore && !string.IsNullOrEmpty(node.RelativePath))
        {
            _ignoredPaths.Add(NormalizePath(node.RelativePath));
        }
        else if (state == FileRuleState.Overwrite && !string.IsNullOrEmpty(node.RelativePath))
        {
            var rel = NormalizePath(node.RelativePath);
            var ancestorIgnore = _ignoredPaths
                .FirstOrDefault(r => rel.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase));

            if (ancestorIgnore != null)
            {
                _ignoredPaths.Remove(ancestorIgnore);
                var ancestorNode = FindNodeByPath(_fileTreeRoot, ancestorIgnore);
                if (ancestorNode != null)
                {
                    foreach (var leaf in GetLeafNodes(ancestorNode))
                    {
                        var leafRel = NormalizePath(leaf.RelativePath);
                        if (!leafRel.StartsWith(rel + "/", StringComparison.OrdinalIgnoreCase) &&
                            !leafRel.Equals(rel, StringComparison.OrdinalIgnoreCase))
                        {
                            _ignoredPaths.Add(leafRel);
                        }
                    }
                }
            }
        }
    }

    private IEnumerable<string> EnumeratePaths(FileNode? node)
    {
        if (node == null) yield break;

        if (!string.IsNullOrEmpty(node.RelativePath))
            yield return NormalizePath(node.RelativePath);

        var children = node.Children;
        if (children == null) yield break;

        foreach (var child in children)
        {
            foreach (var p in EnumeratePaths(child))
                yield return p;
        }
    }

    private List<(FileNode Node, int Depth)> GetFlattenedTree()
    {
        var result = new List<(FileNode, int)>();
        if (_fileTreeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            if (node == null) return;
            result.Add((node, depth));

            if (node.IsDirectory && !_expandedDirs.Contains(node.RelativePath))
                return;

            var children = node.Children;
            if (children != null)
            {
                foreach (var child in children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
                {
                    Flatten(child, depth + 1);
                }
            }
        }

        foreach (var child in _fileTreeRoot.Children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
        {
            Flatten(child, 0);
        }

        return result;
    }

    private void AddInstallPath()
    {
        _installPaths.Add(new InstallPathItem());
    }

    private async Task RemoveInstallPath(int index)
    {
        if (index >= 0 && index < _installPaths.Count)
        {
            _installPaths.RemoveAt(index);
            await RefreshFileTreeAsync();
        }
    }

    private void BuildArchiveTree()
    {
        _archiveTreeRoot = new FileNode { Name = "Archive Root", IsDirectory = true, RelativePath = "" };
        _archiveExpandedDirs.Clear();
        _archiveContentsExpandedDirs.Clear();

        if (_archiveContents == null) return;

        foreach (var path in _archiveContents)
        {
            var isDir = path.StartsWith("[DIR]");
            var cleanPath = isDir ? path.Substring(5).TrimStart() : path;
            cleanPath = NormalizePath(cleanPath);

            var parts = cleanPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            var current = _archiveTreeRoot;
            var accumulated = "";

            for (int i = 0; i < parts.Length; i++)
            {
                var part = parts[i];
                accumulated = string.IsNullOrEmpty(accumulated) ? part : accumulated + "/" + part;
                var isLast = i == parts.Length - 1;

                var existing = current.Children.FirstOrDefault(c => c.Name.Equals(part, StringComparison.OrdinalIgnoreCase));
                if (existing == null)
                {
                    // If it's the last part, use the actual isDir flag. Intermediate parts are always dirs.
                    var nodeIsDir = isLast ? isDir : true;
                    var newNode = new FileNode
                    {
                        Name = part,
                        RelativePath = accumulated,
                        IsDirectory = nodeIsDir
                    };

                    current.Children.Add(newNode);
                    current = newNode;

                    // Auto-expand top level folders
                    if (nodeIsDir && i == 0)
                    {
                        _archiveExpandedDirs.Add(accumulated);
                        _archiveContentsExpandedDirs.Add(accumulated);
                    }
                }
                else
                {
                    current = existing;
                }
            }
        }
    }

    private List<(FileNode Node, int Depth)> GetFlattenedArchiveTree()
    {
        var result = new List<(FileNode, int)>();
        if (_archiveTreeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            if (node == null) return;
            result.Add((node, depth));

            if (node.IsDirectory && !_archiveExpandedDirs.Contains(node.RelativePath))
                return;

            var children = node.Children;
            if (children != null)
            {
                // Sort directories first, then files
                foreach (var child in children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
                {
                    Flatten(child, depth + 1);
                }
            }
        }

        foreach (var child in _archiveTreeRoot.Children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
        {
            Flatten(child, 0);
        }

        return result;
    }

    private void ToggleArchiveExpand(FileNode node)
    {
        if (!node.IsDirectory) return;
        var path = node.RelativePath;
        if (_archiveExpandedDirs.Contains(path))
            _archiveExpandedDirs.Remove(path);
        else
            _archiveExpandedDirs.Add(path);
    }

    private void ToggleArchiveContentsExpand(FileNode node)
    {
        if (!node.IsDirectory) return;
        var path = node.RelativePath;
        if (_archiveContentsExpandedDirs.Contains(path))
            _archiveContentsExpandedDirs.Remove(path);
        else
            _archiveContentsExpandedDirs.Add(path);
    }

    private List<(FileNode Node, int Depth)> GetFlattenedArchiveTreeReadOnly()
    {
        var result = new List<(FileNode, int)>();
        if (_archiveTreeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            if (node == null) return;
            result.Add((node, depth));

            if (node.IsDirectory && !_archiveContentsExpandedDirs.Contains(node.RelativePath))
                return;

            var children = node.Children;
            if (children != null)
            {
                foreach (var child in children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
                {
                    Flatten(child, depth + 1);
                }
            }
        }

        foreach (var child in _archiveTreeRoot.Children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
        {
            Flatten(child, 0);
        }

        return result;
    }

    private void OpenSourceTree(int index)
    {
        _activeSourceIndex = index;
        _isSourcePopoverOpen = true;
    }

    private async Task SelectSourcePath(int index, string path)
    {
        if (index >= 0 && index < _installPaths.Count)
        {
            _installPaths[index].Source = path;
        }
        _isSourcePopoverOpen = false;
        _activeSourceIndex = -1;
        await RefreshFileTreeAsync();
    }

    private void OpenTargetTree(int index)
    {
        BuildServerTree();
        _activeTargetIndex = index;
        _isTargetPopoverOpen = true;
    }

    private async Task SelectTargetPath(int index, string path)
    {
        if (index >= 0 && index < _installPaths.Count)
        {
            _installPaths[index].Target = path;
        }
        _isTargetPopoverOpen = false;
        _activeTargetIndex = -1;
        await RefreshFileTreeAsync();
    }

    private async Task OnInstallPathChanged(int index, string value, bool isSource)
    {
        if (index >= 0 && index < _installPaths.Count)
        {
            if (isSource)
                _installPaths[index].Source = value;
            else
                _installPaths[index].Target = value;
        }
        await RefreshFileTreeAsync();
    }

    private async Task RefreshFileTreeAsync()
    {
        if (!IsPendingInstall) return;
        _fileTreeLoading = true;
        await InvokeAsync(StateHasChanged);
        await LoadFileTreeAsync();
    }

    private void ToggleServerExpand(FileNode node)
    {
        var path = node.RelativePath;
        if (_serverExpandedDirs.Contains(path))
            _serverExpandedDirs.Remove(path);
        else
            _serverExpandedDirs.Add(path);
    }

    private void BuildServerTree()
    {
        var root = ConfigService.SptRoot;
        _serverTreeRoot = new FileNode { Name = "root", IsDirectory = true, RelativePath = "" };

        if (string.IsNullOrEmpty(root) || !Directory.Exists(root))
            return;

        try
        {
            // Build tree with limited depth (2 levels deep for performance)
            BuildServerTreeRecursive(_serverTreeRoot, root, "", 0, 2);
        }
        catch { /* Ignore permission errors */ }
    }

    private void BuildServerTreeRecursive(FileNode parent, string basePath, string relativePath, int depth, int maxDepth)
    {
        if (depth >= maxDepth) return;

        var currentPath = string.IsNullOrEmpty(relativePath)
            ? basePath
            : Path.Combine(basePath, relativePath);

        try
        {
            foreach (var dir in Directory.GetDirectories(currentPath).OrderBy(d => Path.GetFileName(d)))
            {
                var dirName = Path.GetFileName(dir);
                var childRelPath = string.IsNullOrEmpty(relativePath)
                    ? dirName
                    : $"{relativePath}/{dirName}";

                var node = new FileNode
                {
                    Name = dirName,
                    RelativePath = childRelPath,
                    IsDirectory = true
                };

                parent.Children.Add(node);

                // Recursively build children
                BuildServerTreeRecursive(node, basePath, childRelPath, depth + 1, maxDepth);
            }
        }
        catch { /* Ignore permission errors */ }
    }

    private List<(FileNode Node, int Depth)> GetFlattenedServerTree()
    {
        var result = new List<(FileNode, int)>();
        if (_serverTreeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            result.Add((node, depth));
            if (!_serverExpandedDirs.Contains(node.RelativePath)) return;
            foreach (var child in node.Children.OrderBy(c => c.Name))
                Flatten(child, depth + 1);
        }

        foreach (var child in _serverTreeRoot.Children.OrderBy(c => c.Name))
            Flatten(child, 0);

        return result;
    }

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Reset()
    {
        if (Mod == null) return;

        // Reset to original mod values
        _modName = Mod.ModName ?? "";
        _downloadUrl = Mod.DownloadUrl ?? "";
        _isOptional = Mod.Optional;

        var installPaths = Mod.InstallPaths ?? new List<string[]>();
        _installPaths = installPaths
            .Where(p => p != null && p.Length >= 2)
            .Select(p => new InstallPathItem { Source = p[0] ?? "", Target = p[1] ?? "" })
            .ToList();
        if (_installPaths.Count == 0)
        {
            _installPaths.Add(new InstallPathItem());
        }

        // Reset file rules
        var rules = Mod.FileRules ?? new List<FileCopyRule>();
        _ignoredPaths = new HashSet<string>(
            rules.Where(r => r != null && r.State == FileCopyRuleState.Ignore && !string.IsNullOrWhiteSpace(r.Path))
                 .Select(r => NormalizePath(r.Path)),
            StringComparer.OrdinalIgnoreCase);

        // Reset installed files
        _installedFilesSet = new HashSet<string>(
            (Mod.InstalledFiles ?? new List<string>()).Select(NormalizePath),
            StringComparer.OrdinalIgnoreCase);
        _installedFilesModified = false;

        // Refresh file tree
        _fileTreeLoading = true;
        await LoadFileTreeAsync();
    }

    private async Task Save()
    {
        var result = new EditModResult
        {
            ModName = _modName,
            IsOptional = _isOptional,
            InstallPaths = _installPaths.Select(p => new[] { p.Source, p.Target }).ToList(),
            FileRules = _ignoredPaths
                .Select(p => new FileCopyRule { Path = p, State = FileCopyRuleState.Ignore })
                .ToList(),
            // Only include InstalledFiles if they were modified (for installed mods)
            InstalledFiles = _installedFilesModified ? _installedFilesSet.ToList() : null
        };

        await OnSave.InvokeAsync(result);
        await Close();
    }

    // ========== Installed Files Browser Methods ==========

    private void OpenInstalledFilesBrowser()
    {
        BuildInstalledFilesTree();
        _isInstalledFilesPopoverOpen = true;
    }

    private void BuildInstalledFilesTree()
    {
        var root = ConfigService.SptRoot;
        _installedFilesTreeRoot = new FileNode { Name = "root", IsDirectory = true, RelativePath = "" };
        _installedFilesExpandedDirs.Clear(); // Start with all folders collapsed

        if (string.IsNullOrEmpty(root) || !Directory.Exists(root))
            return;

        try
        {
            // Build tree from SPT root showing all directories
            BuildInstalledFilesTreeRecursive(_installedFilesTreeRoot, root, "", 0, 6);
        }
        catch { /* Ignore permission errors */ }
    }

    private void BuildInstalledFilesTreeRecursive(FileNode parent, string basePath, string relativePath, int depth, int maxDepth)
    {
        if (depth >= maxDepth) return;

        try
        {
            // Add directories
            foreach (var dir in Directory.GetDirectories(basePath).OrderBy(d => Path.GetFileName(d)))
            {
                var dirName = Path.GetFileName(dir);
                var childRelPath = string.IsNullOrEmpty(relativePath) ? dirName : $"{relativePath}/{dirName}";

                var node = new FileNode
                {
                    Name = dirName,
                    RelativePath = childRelPath,
                    IsDirectory = true
                };

                parent.Children.Add(node);
                BuildInstalledFilesTreeRecursive(node, dir, childRelPath, depth + 1, maxDepth);
            }

            // Add files
            foreach (var file in Directory.GetFiles(basePath).OrderBy(f => Path.GetFileName(f)))
            {
                var fileName = Path.GetFileName(file);
                var childRelPath = string.IsNullOrEmpty(relativePath) ? fileName : $"{relativePath}/{fileName}";

                parent.Children.Add(new FileNode
                {
                    Name = fileName,
                    RelativePath = childRelPath,
                    IsDirectory = false
                });
            }
        }
        catch { /* Ignore permission errors */ }
    }

    private void ToggleInstalledFilesExpand(FileNode node)
    {
        if (!node.IsDirectory) return;
        var path = node.RelativePath;
        if (_installedFilesExpandedDirs.Contains(path))
            _installedFilesExpandedDirs.Remove(path);
        else
            _installedFilesExpandedDirs.Add(path);
    }

    private List<(FileNode Node, int Depth)> GetFlattenedInstalledFilesTree()
    {
        var result = new List<(FileNode, int)>();
        if (_installedFilesTreeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            result.Add((node, depth));
            if (!node.IsDirectory || !_installedFilesExpandedDirs.Contains(node.RelativePath)) return;

            var children = node.Children;
            if (children != null)
            {
                // Sort directories first, then files
                foreach (var child in children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
                {
                    Flatten(child, depth + 1);
                }
            }
        }

        foreach (var child in _installedFilesTreeRoot.Children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
            Flatten(child, 0);

        return result;
    }

    private void ToggleInstalledFile(string path, bool isTracked)
    {
        if (isTracked)
            _installedFilesSet.Add(path);
        else
            _installedFilesSet.Remove(path);

        _installedFilesModified = true;
    }

    private void RemoveInstalledFile(string path)
    {
        _installedFilesSet.Remove(path);
        _installedFilesModified = true;
    }

    private FileRuleState? GetDirectoryTrackingState(FileNode dirNode)
    {
        if (!dirNode.IsDirectory) return null;

        var allFiles = GetAllDescendantFiles(dirNode).ToList();
        if (allFiles.Count == 0) return FileRuleState.Ignore;

        var trackedCount = allFiles.Count(f => _installedFilesSet.Contains(f));

        if (trackedCount == 0) return FileRuleState.Ignore;
        if (trackedCount == allFiles.Count) return FileRuleState.Overwrite;
        return FileRuleState.Mixed;
    }

    private void ToggleDirectoryTracking(FileNode dirNode)
    {
        if (!dirNode.IsDirectory) return;

        var allFiles = GetAllDescendantFiles(dirNode).ToList();
        var currentState = GetDirectoryTrackingState(dirNode);

        // If all or some are tracked, untrack all. If none tracked, track all.
        if (currentState == FileRuleState.Overwrite || currentState == FileRuleState.Mixed)
        {
            foreach (var file in allFiles)
                _installedFilesSet.Remove(file);
        }
        else
        {
            foreach (var file in allFiles)
                _installedFilesSet.Add(file);
        }

        _installedFilesModified = true;
    }

    private IEnumerable<string> GetAllDescendantFiles(FileNode node)
    {
        if (!node.IsDirectory)
        {
            yield return node.RelativePath;
            yield break;
        }

        foreach (var child in node.Children ?? Enumerable.Empty<FileNode>())
        {
            foreach (var file in GetAllDescendantFiles(child))
                yield return file;
        }
    }
