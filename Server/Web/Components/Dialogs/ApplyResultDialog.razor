@using ModGod.Models
@using ModGod.Web.Models
@using Color = MudBlazor.Color

<MudDialog @bind-Visible="Visible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--text-primary);">Apply Changes Result</MudText>
    </TitleContent>
    <DialogContent>
        @if (Result != null)
        {
            @if (Result.InstalledMods.Count > 0)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">✓ Installed @Result.InstalledMods.Count mod(s):</MudText>
                    @foreach (var mod in Result.InstalledMods)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• @mod</MudText>
                    }
                </MudAlert>
            }
            
            @if (Result.QueuedForInstall.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">📦 @Result.QueuedForInstall.Count mod(s) will be installed on server restart:</MudText>
                    @foreach (var mod in Result.QueuedForInstall)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• @mod</MudText>
                    }
                </MudAlert>
            }
            
            @if (Result.RemovedMods.Count > 0)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">🗑️ Removed @Result.RemovedMods.Count mod(s):</MudText>
                    @foreach (var mod in Result.RemovedMods)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• @mod</MudText>
                    }
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--text-secondary);">
                        Files have been deleted. Changes will take effect on server restart.
                    </MudText>
                </MudAlert>
            }
            
            @if (Result.QueuedForRemoval.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">🗑️ @Result.QueuedForRemoval.Count mod(s) queued for removal:</MudText>
                    @foreach (var mod in Result.QueuedForRemoval)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• @mod</MudText>
                    }
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--text-secondary);">
                        A PowerShell script will run when you close the server to complete the removal.
                    </MudText>
                </MudAlert>
            }
            
            @if (Result.Errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">❌ Errors:</MudText>
                    @foreach (var error in Result.Errors)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• @error</MudText>
                    }
                </MudAlert>
            }
            
            @if (Result.FailedDeletions.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">⚠️ Some files could not be deleted:</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Please manually delete the following files:
                    </MudText>
                    @foreach (var path in Result.FailedDeletions.Take(10))
                    {
                        <MudText Typo="Typo.caption" Class="ml-3" Style="font-family: monospace; word-break: break-all;">
                            • @path.Replace("<SPT_ROOT>", "")
                        </MudText>
                    }
                    @if (Result.FailedDeletions.Count > 10)
                    {
                        <MudText Typo="Typo.caption" Class="ml-3" Style="color: var(--text-secondary);">
                            ...and @(Result.FailedDeletions.Count - 10) more file(s)
                        </MudText>
                    }
                </MudAlert>
            }
            
            @if (Result.SyncExclusionsChanged || Result.HeadlessSyncPathsChanged)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    <MudText Typo="Typo.subtitle2">⚙️ Config Updated:</MudText>
                    @if (Result.SyncExclusionsChanged)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• Sync exclusions updated (@Result.SyncExclusionCount paths)</MudText>
                    }
                    @if (Result.HeadlessSyncPathsChanged)
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">• Headless sync paths updated (@Result.HeadlessSyncPathCount paths)</MudText>
                    }
                </MudAlert>
            }

            @if (Result.AutoInstallerLaunched && Result.IsWindows)
            {
                <MudAlert Severity="Severity.Success" Class="mt-4">
                    <MudText Typo="Typo.subtitle2">🚀 Auto-Installer Launched!</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        A PowerShell window has opened that will automatically complete the pending operations
                        when you stop the SPT server.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <strong>Just stop the server normally</strong> - the installer will detect it and complete the process.
                    </MudText>
                </MudAlert>
            }
            else if (Result.QueuedForInstall.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">
                    <MudText Typo="Typo.body2">
                        @(Result.QueuedForInstall.Count) mod(s) queued for installation on next server restart.
                    </MudText>
                </MudAlert>
            }
            
            @if (!HasAnyChanges())
            {
                <MudText Typo="Typo.body1" Style="color: var(--text-secondary);">
                    No changes were made.
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">
            OK
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public ApplyChangesResult? Result { get; set; }
    
    private bool HasAnyChanges()
    {
        if (Result == null) return false;
        return Result.InstalledMods.Count > 0 ||
               Result.QueuedForInstall.Count > 0 ||
               Result.RemovedMods.Count > 0 ||
               Result.QueuedForRemoval.Count > 0 ||
               Result.SyncExclusionsChanged ||
               Result.HeadlessSyncPathsChanged ||
               Result.Errors.Count > 0 ||
               Result.FailedDeletions.Count > 0;
    }
    
    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
