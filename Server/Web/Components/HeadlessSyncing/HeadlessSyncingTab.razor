@using ModGod.Web.Models
@using ModGod.Services
@using ModGod.Models

<MudPaper Class="pa-4 mb-4" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px;">
    <div class="d-flex align-center mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Computer" Class="mr-2" Style="color: var(--accent-cyan);" />
        <div>
            <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 600;">
                Headless Client Syncing
            </MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Select files/folders to sync to headless clients. By default, nothing is synced to headless clients.
            </MudText>
        </div>
    </div>
    
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
        <strong>Not using headless client?</strong> You can skip this tab entirely.
    </MudAlert>
    
    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
        <strong>Headless clients</strong> are dedicated raid-hosting instances that don't need most mods.
        Only check the specific files/folders that headless clients require.
    </MudAlert>
</MudPaper>

<!-- File Tree Inclusions Section -->
<MudPaper Class="pa-4" Style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px;">
    <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 600;">
        <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" Style="vertical-align: middle;" />
        File/Folder Inclusions for Headless
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--text-secondary);">
        Browse files under <code>BepInEx/plugins</code> and <code>SPT/user/mods</code> and check items to include them for headless clients.
        <br/><em style="color: var(--text-secondary); opacity: 0.8;">💡 Headless clients only need files from <code>BepInEx/plugins</code> — the <code>SPT/user/mods</code> is not used on headless instances.</em>
    </MudText>

    <div class="d-flex gap-2 mb-3">
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_loading"
                   OnClick="LoadTreeAsync">
            Refresh
        </MudButton>
        <MudText Typo="Typo.caption" Style="color: var(--text-secondary); align-self: center;">
            Click "Apply Changes" to commit.
        </MudText>
    </div>

    @if (_loading)
    {
        <div class="d-flex align-center mb-2">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <MudText Typo="Typo.body2">Scanning mod folders...</MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Warning">@_error</MudAlert>
    }
    else if (_treeRoot != null && _treeRoot.Children != null && _treeRoot.Children.Any())
    {
        <MudPaper Class="pa-3" Style="background: var(--secondary-bg); border: 1px solid var(--border-color); max-height: 420px; overflow-y: auto;">
            <div class="mb-2" style="font-size:13px; color: var(--text-secondary);">
                ✓ Checked = sync to headless &nbsp;|&nbsp; ☐ Unchecked = don't sync
            </div>
            @foreach (var (node, depth) in GetFlattenedTree())
            {
                var state = GetNodeState(node);
                var indent = depth * 18;
                var capturedNode = node;
                var isExpanded = node.IsDirectory && _expandedDirs.Contains(node.RelativePath);
                var hasChildren = node.IsDirectory && node.Children?.Count > 0;
                <div class="d-flex align-center" style="padding-left:@(indent)px; margin-bottom:2px;">
                    @* Expand/collapse button for directories *@
                    @if (hasChildren)
                    {
                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)"
                                       Size="Size.Small"
                                       Style="padding: 2px; min-width: 24px; color: var(--text-secondary);"
                                       OnClick="() => ToggleExpand(capturedNode)" />
                    }
                    else
                    {
                        <div style="width: 28px;"></div>
                    }
                    @* Checkbox for sync state *@
                    @{
                        var checkIcon = state switch
                        {
                            SyncNodeState.Included => Icons.Material.Filled.CheckBox,
                            SyncNodeState.Excluded => Icons.Material.Filled.CheckBoxOutlineBlank,
                            _ => Icons.Material.Filled.IndeterminateCheckBox
                        };
                        var iconColor = state switch
                        {
                            SyncNodeState.Included => "var(--accent-cyan)",
                            SyncNodeState.Excluded => "var(--text-secondary)",
                            _ => "var(--accent-orange)"
                        };
                    }
                    <MudIconButton Icon="@checkIcon"
                                   Size="Size.Small"
                                   Style="@($"padding: 2px; min-width: 24px; color: {iconColor};")"
                                   OnClick="() => OnNodeClick(capturedNode)" />
                    @* Directory/file name (click to expand/collapse for directories) *@
                    @if (node.IsDirectory && hasChildren)
                    {
                        <span class="ml-1 mono" style="color: var(--text-primary); cursor: pointer;" @onclick="() => ToggleExpand(capturedNode)">
                            📁 @(node.Name)
                        </span>
                    }
                    else
                    {
                        <span class="ml-1 mono" style="color: var(--text-primary);">
                            @(node.IsDirectory ? "📁" : "📄") @(node.Name)
                        </span>
                    }
                </div>
            }
        </MudPaper>
        
        @if (_inclusionSet.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mt-3" Style="color: var(--accent-cyan);">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="vertical-align: middle;" />
                @_inclusionSet.Count path(s) selected for headless syncing
            </MudText>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            No files found in the tracked directories. Install mods or refresh.
        </MudAlert>
    }
</MudPaper>

@code {
    [Inject] private ConfigService ConfigService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    
    /// <summary>
    /// Called when config changes are made (for parent to update UI)
    /// </summary>
    [Parameter] public EventCallback OnConfigChanged { get; set; }

    // State
    private bool _initialized = false;
    private bool _loading = false;
    private string? _error;
    
    // File tree
    private FileNode? _treeRoot;
    private HashSet<string> _inclusionSet = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _expandedDirs = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeAsync();
        }
    }

    /// <summary>
    /// Initialize the component (called automatically on first render)
    /// </summary>
    public async Task InitializeAsync()
    {
        if (_initialized) return;
        
        await LoadTreeAsync();
        _initialized = true;
    }

    private async Task LoadTreeAsync()
    {
        _loading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Load inclusion set (paths that ARE synced to headless)
            _inclusionSet = new HashSet<string>(
                (ConfigService.StagedConfig.HeadlessSyncPaths ?? new List<string>())
                    .Select(NormalizePath)
                    .Where(p => !string.IsNullOrWhiteSpace(p)),
                StringComparer.OrdinalIgnoreCase);

            var root = new FileNode { Name = "root", IsDirectory = true, RelativePath = "" };

            AddRoot(ConfigService.BepInExPluginsPath, "BepInEx/plugins", root);
            AddRoot(ConfigService.SptUserModsPath, "SPT/user/mods", root);

            _treeRoot = root;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load headless sync paths: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddRoot(string absolutePath, string relativePath, FileNode root)
    {
        if (!Directory.Exists(absolutePath)) return;

        var node = BuildNodeRecursive(absolutePath, NormalizePath(relativePath), relativePath);
        root.Children.Add(node);
    }

    private FileNode BuildNodeRecursive(string fullPath, string relativePath, string? displayName = null)
    {
        var node = new FileNode
        {
            Name = displayName ?? Path.GetFileName(fullPath),
            RelativePath = relativePath,
            IsDirectory = true
        };

        foreach (var dir in Directory.GetDirectories(fullPath))
        {
            var childRel = NormalizePath(Path.Combine(relativePath, Path.GetFileName(dir)));
            node.Children.Add(BuildNodeRecursive(dir, childRel));
        }

        foreach (var file in Directory.GetFiles(fullPath))
        {
            var childRel = NormalizePath(Path.Combine(relativePath, Path.GetFileName(file)));
            node.Children.Add(new FileNode
            {
                Name = Path.GetFileName(file),
                RelativePath = childRel,
                IsDirectory = false
            });
        }

        return node;
    }

    /// <summary>
    /// Get the state of a node - for headless, INCLUDED means it's in the inclusion set
    /// </summary>
    private SyncNodeState GetNodeState(FileNode? node)
    {
        if (node == null) return SyncNodeState.Excluded; // Default to excluded for headless

        var rel = NormalizePath(node.RelativePath);

        if (!node.IsDirectory)
        {
            var isIncluded = IsIncluded(rel);
            return isIncluded ? SyncNodeState.Included : SyncNodeState.Excluded;
        }

        // For directories: derive state from all leaf nodes
        var leaves = GetLeafNodes(node).ToList();
        if (leaves.Count == 0) return SyncNodeState.Excluded;
        
        var leafStates = leaves
            .Select(leaf => IsIncluded(NormalizePath(leaf.RelativePath)) ? SyncNodeState.Included : SyncNodeState.Excluded)
            .Distinct()
            .ToList();
        
        if (leafStates.Count == 1) return leafStates[0];
        return SyncNodeState.Mixed;
    }

    private IEnumerable<FileNode> GetLeafNodes(FileNode? node)
    {
        if (node == null) yield break;

        if (!node.IsDirectory)
        {
            yield return node;
            yield break;
        }

        var children = node.Children;
        if (children == null) yield break;

        foreach (var child in children)
        {
            foreach (var leaf in GetLeafNodes(child))
                yield return leaf;
        }
    }

    /// <summary>
    /// Check if a path is included for headless syncing
    /// </summary>
    private bool IsIncluded(string relativePath)
    {
        var norm = NormalizePath(relativePath);
        return _inclusionSet.Any(inc =>
            norm.Equals(inc, StringComparison.OrdinalIgnoreCase) ||
            norm.StartsWith(inc + "/", StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnNodeClick(FileNode node)
    {
        await ToggleNodeAsync(node);
    }

    private void ToggleExpand(FileNode node)
    {
        if (!node.IsDirectory) return;
        
        var path = node.RelativePath;
        if (_expandedDirs.Contains(path))
            _expandedDirs.Remove(path);
        else
            _expandedDirs.Add(path);
        
        StateHasChanged();
    }

    private async Task ToggleNodeAsync(FileNode? node)
    {
        if (node == null) return;

        var current = GetNodeState(node);
        // Toggle: if excluded or mixed -> include, if included -> exclude
        var next = current == SyncNodeState.Included ? SyncNodeState.Excluded : SyncNodeState.Included;

        if (node.IsDirectory)
        {
            ApplyDirectoryState(node, next);
        }
        else
        {
            ApplyFileState(node, next);
        }

        // Immediately save to staged config
        await SaveInclusionsAsync();
        
        StateHasChanged();
    }

    private void ApplyDirectoryState(FileNode? node, SyncNodeState state)
    {
        if (node == null) return;
        var rel = NormalizePath(node.RelativePath);

        // Clear this directory and all its descendants from inclusions
        foreach (var path in EnumerateAllPaths(node).ToList())
            _inclusionSet.Remove(path);

        if (state == SyncNodeState.Included && !string.IsNullOrEmpty(rel))
        {
            _inclusionSet.Add(rel);
        }
        else if (state == SyncNodeState.Excluded && !string.IsNullOrEmpty(rel))
        {
            // Check if a PROPER ANCESTOR (not self) is included - need to lift it
            var ancestorInclusion = _inclusionSet
                .FirstOrDefault(inc => rel.StartsWith(inc + "/", StringComparison.OrdinalIgnoreCase));
            
            if (ancestorInclusion != null)
            {
                _inclusionSet.Remove(ancestorInclusion);
                var ancestorNode = FindNodeByPath(_treeRoot, ancestorInclusion);
                if (ancestorNode != null)
                {
                    foreach (var leaf in EnumerateLeafPaths(ancestorNode))
                    {
                        var leafNorm = NormalizePath(leaf);
                        if (!leafNorm.StartsWith(rel + "/", StringComparison.OrdinalIgnoreCase) &&
                            !leafNorm.Equals(rel, StringComparison.OrdinalIgnoreCase))
                        {
                            _inclusionSet.Add(leafNorm);
                        }
                    }
                }
            }
        }
    }

    private void ApplyFileState(FileNode? node, SyncNodeState state)
    {
        if (node == null) return;
        var rel = NormalizePath(node.RelativePath);

        if (state == SyncNodeState.Included)
        {
            _inclusionSet.Add(rel);
        }
        else
        {
            var ancestorInclusion = _inclusionSet
                .FirstOrDefault(inc => rel.StartsWith(inc + "/", StringComparison.OrdinalIgnoreCase));
            
            if (ancestorInclusion != null)
            {
                _inclusionSet.Remove(ancestorInclusion);
                var ancestorNode = FindNodeByPath(_treeRoot, ancestorInclusion);
                if (ancestorNode != null)
                {
                    foreach (var leaf in EnumerateLeafPaths(ancestorNode))
                    {
                        var leafNorm = NormalizePath(leaf);
                        if (!leafNorm.Equals(rel, StringComparison.OrdinalIgnoreCase))
                        {
                            _inclusionSet.Add(leafNorm);
                        }
                    }
                }
            }
            _inclusionSet.Remove(rel);
        }
    }

    private IEnumerable<string> EnumerateAllPaths(FileNode? node)
    {
        if (node == null) yield break;

        if (!string.IsNullOrEmpty(node.RelativePath))
            yield return NormalizePath(node.RelativePath);

        var children = node.Children ?? Enumerable.Empty<FileNode>();
        foreach (var child in children)
            foreach (var p in EnumerateAllPaths(child))
                yield return p;
    }

    private FileNode? FindNodeByPath(FileNode? node, string relativePath)
    {
        if (node == null) return null;
        var norm = NormalizePath(relativePath);
        if (NormalizePath(node.RelativePath).Equals(norm, StringComparison.OrdinalIgnoreCase))
            return node;

        var children = node.Children ?? Enumerable.Empty<FileNode>();
        foreach (var child in children)
        {
            var found = FindNodeByPath(child, relativePath);
            if (found != null) return found;
        }
        return null;
    }

    private IEnumerable<string> EnumerateLeafPaths(FileNode? node)
    {
        if (node == null) yield break;

        if (!node.IsDirectory)
        {
            if (!string.IsNullOrEmpty(node.RelativePath))
                yield return NormalizePath(node.RelativePath);
            yield break;
        }

        var children = node.Children ?? Enumerable.Empty<FileNode>();
        foreach (var child in children)
        {
            foreach (var leaf in EnumerateLeafPaths(child))
                yield return leaf;
        }
    }

    private List<(FileNode Node, int Depth)> GetFlattenedTree()
    {
        var result = new List<(FileNode, int)>();
        if (_treeRoot?.Children == null) return result;

        void Flatten(FileNode node, int depth)
        {
            if (node == null) return;
            result.Add((node, depth));

            // Only recurse into children if this directory is expanded
            if (node.IsDirectory && !_expandedDirs.Contains(node.RelativePath))
                return;

            var children = node.Children;
            if (children != null)
            {
                foreach (var child in children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
                {
                    Flatten(child, depth + 1);
                }
            }
        }

        foreach (var child in _treeRoot.Children.OrderByDescending(c => c.IsDirectory).ThenBy(c => c.Name))
        {
            Flatten(child, 0);
        }

        return result;
    }

    private async Task SaveInclusionsAsync()
    {
        try
        {
            ConfigService.StagedConfig.HeadlessSyncPaths = _inclusionSet
                .Select(NormalizePath)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p)
                .ToList();

            await ConfigService.SaveStagedConfigAsync();
            await OnConfigChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save headless sync paths: {ex.Message}", Severity.Error);
        }
    }

    private static string NormalizePath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return string.Empty;
        return path.Replace("\\", "/").TrimStart('/');
    }
}

