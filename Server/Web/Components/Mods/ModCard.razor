@using ModGod.Models
@using ModGod.Web.Models
@using Color = MudBlazor.Color

<MudItem xs="12" md="6" lg="4">
    <MudPaper Class="pa-4 glass-panel" Style="@(CardStyle + (Mod.IsProtected ? "" : " cursor: pointer;"))" 
              @onclick="OnCardClick">
        <div class="d-flex justify-space-between align-start mb-3">
            <div>
                <MudText Typo="Typo.h6" Style="color: var(--text-primary); font-weight: 700; letter-spacing: -0.3px;">@Mod.ModName</MudText>
                <div class="d-inline-flex gap-1 flex-wrap mt-2" @onclick:stopPropagation="true">
                    <MudChip T="string" Size="Size.Small" Style="@StatusChipStyle">
                        @StatusText
                    </MudChip>
                    @if (Mod.IsProtected)
                    {
                        <MudChip T="string" Size="Size.Small" 
                                 Style="background: linear-gradient(135deg, rgba(102, 126, 234, 0.8) 0%, rgba(118, 75, 162, 0.8) 100%); color: #fff; backdrop-filter: blur(4px);">
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="mr-1" /> Built-in
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" 
                                 Style="@(Mod.Optional ? "background: rgba(74, 222, 128, 0.9); color: #000; cursor: pointer;" : "background: rgba(251, 191, 36, 0.9); color: #000; cursor: pointer;")"
                                 OnClick="@(() => OnToggleOptional.InvokeAsync(Mod))">
                            @(Mod.Optional ? "Optional" : "Required")
                        </MudChip>
                    }
                </div>
            </div>
            @if (!Mod.IsProtected)
            {
                <div @onclick:stopPropagation="true">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                        @if (IsPendingRemoval)
                        {
                            <MudMenuItem OnClick="@(() => OnOpenUninstallDialog.InvokeAsync(Mod))">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" /> Edit Removal
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => OnUndoRemoval.InvokeAsync(Mod))" Style="color: var(--accent-green);">
                                <MudIcon Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Class="mr-2" /> Undo Removal
                            </MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem OnClick="@(() => OnEdit.InvokeAsync(Mod))">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" /> Edit
                            </MudMenuItem>
                            @if (!IsPendingInstall && !string.IsNullOrEmpty(Mod.DownloadUrl))
                            {
                                <MudMenuItem OnClick="@(() => OnReinstall.InvokeAsync(Mod))" Style="color: var(--accent-cyan);">
                                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-2" /> Reinstall
                                </MudMenuItem>
                            }
                            <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(Mod))" Style="color: var(--accent-red);">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" /> 
                                @(IsPendingInstall ? "Remove" : "Uninstall")
                            </MudMenuItem>
                        }
                    </MudMenu>
                </div>
            }
        </div>

        <MudText Typo="Typo.body2" Class="mono mb-2" Style="color: var(--text-muted); word-break: break-all; font-size: 0.7rem; opacity: 0.8;">
            @TruncateUrl(Mod.DownloadUrl)
        </MudText>

        <MudDivider Class="my-3" Style="border-color: var(--border-color); opacity: 0.5;" />

        <div class="d-flex gap-4">
            <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" Style="vertical-align: middle; opacity: 0.7;" />
                @FormatTimestamp(Mod.LastUpdated)
            </MudText>

            <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-1" Style="vertical-align: middle; opacity: 0.7;" />
                @Mod.InstallPaths.Count path(s)
            </MudText>
        </div>
        
        @if (!IsPendingInstall)
        {
            var installedFiles = Mod.InstalledFiles ?? new List<string>();

            if (installedFiles.Count == 0 && !Mod.IsProtected)
            {
                <div class="mt-3 pa-2" style="background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px;">
                    <MudText Typo="Typo.caption" Style="color: var(--accent-orange);">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                        No files tracked — click for details
                    </MudText>
                </div>
            }
            else if (MissingFilesCount > 0)
            {
                <div class="mt-3 pa-2" style="background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px;">
                    <MudText Typo="Typo.caption" Style="color: var(--accent-orange);">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                        @MissingFilesCount file(s) missing from disk
                    </MudText>
                </div>
            }
        }

        @if (IsPendingInstall)
        {
            @if (NeedsConfiguration)
            {
                <div class="mt-3 pa-2" style="background: rgba(248, 113, 113, 0.1); border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 8px;">
                    <MudText Typo="Typo.caption" Style="color: var(--accent-red);">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                        Configure install paths
                    </MudText>
                </div>
            }
            else
            {
                @if (OverwriteCount > 0)
                {
                    <div class="mt-3 pa-2" style="background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Style="color: var(--accent-orange);">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                            @OverwriteCount file(s) will be overwritten
                        </MudText>
                    </div>
                }
                
                @if (SkippedCount > 0)
                {
                    <div class="@(OverwriteCount > 0 ? "mt-2" : "mt-3") pa-2" style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Style="color: var(--accent-cyan);">
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                            @SkippedCount file(s) preserved
                        </MudText>
                    </div>
                }
            }
        }
    </MudPaper>
</MudItem>

@code {
    [Parameter, EditorRequired] public ModEntry Mod { get; set; } = null!;
    
    // State parameters
    [Parameter] public bool IsPendingInstall { get; set; }
    [Parameter] public bool IsPendingRemoval { get; set; }
    [Parameter] public bool NeedsConfiguration { get; set; }
    [Parameter] public int OverwriteCount { get; set; }
    [Parameter] public int SkippedCount { get; set; }
    [Parameter] public int MissingFilesCount { get; set; }
    
    // Computed style parameters
    [Parameter] public string CardStyle { get; set; } = "";
    [Parameter] public string StatusChipStyle { get; set; } = "";
    [Parameter] public string StatusText { get; set; } = "";
    
    // Event callbacks
    [Parameter] public EventCallback<ModEntry> OnEdit { get; set; }
    [Parameter] public EventCallback<ModEntry> OnDelete { get; set; }
    [Parameter] public EventCallback<ModEntry> OnToggleOptional { get; set; }
    [Parameter] public EventCallback<ModEntry> OnOpenUninstallDialog { get; set; }
    [Parameter] public EventCallback<ModEntry> OnUndoRemoval { get; set; }
    [Parameter] public EventCallback<ModEntry> OnReinstall { get; set; }
    
    private void OnCardClick()
    {
        if (Mod.IsProtected) return;
        
        if (IsPendingRemoval)
        {
            OnOpenUninstallDialog.InvokeAsync(Mod);
        }
        else
        {
            OnEdit.InvokeAsync(Mod);
        }
    }
    
    private static string TruncateUrl(string url)
    {
        if (url.Length <= 50) return url;
        return url.Substring(0, 25) + "..." + url.Substring(url.Length - 22);
    }
    
    private static string FormatTimestamp(string timestamp)
    {
        if (DateTime.TryParse(timestamp, out var dt))
        {
            return dt.ToString("MMM dd, yyyy");
        }
        return "Never";
    }
}
